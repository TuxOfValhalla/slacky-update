#!/usr/bin/env bash
#
# Slackware build script for LACT (Linux AMD and NVIDIA GPU Control Tool)
# Maintained by TuxOfValhalla <agnar1984@gmail.com>
#

set -e

PRGNAM=lact
VERSION=${VERSION:-0.10.1}
BUILD=${BUILD:-1_slacky}
TAG=${TAG:-_slacky}

if [ -z "$ARCH" ]; then
  case "$(uname -m)" in
    i?86) ARCH=i586 ;;
    arm*) ARCH=arm ;;
    *) ARCH=$(uname -m) ;;
  esac
fi

CWD=$(pwd)
TMP=${TMP:-/tmp/SBo}
PKG=$TMP/package-$PRGNAM
OUTPUT=${OUTPUT:-/tmp}

if [ "$ARCH" = "i586" ]; then
  SLKCFLAGS="-O2 -march=i586 -mtune=i686"
  LIBDIRSUFFIX=""
elif [ "$ARCH" = "i686" ]; then
  SLKCFLAGS="-O2 -march=i686 -mtune=i686"
  LIBDIRSUFFIX=""
elif [ "$ARCH" = "x86_64" ]; then
  SLKCFLAGS="-O2 -fPIC"
  LIBDIRSUFFIX="64"
else
  SLKCFLAGS="-O2"
  LIBDIRSUFFIX=""
fi

set -euo pipefail

rm -rf "$PKG"
mkdir -p "$TMP" "$PKG" "$OUTPUT"
cd "$TMP"
rm -rf "LACT-$VERSION" "$PRGNAM-$VERSION"

TARBALL=""
for candidate in "$CWD/LACT-$VERSION.tar.gz" \
                 "$CWD/$PRGNAM-$VERSION.tar.gz" \
                 "$CWD/v$VERSION.tar.gz" \
                 "$CWD/$VERSION.tar.gz"; do
  if [ -f "$candidate" ]; then
    TARBALL="$candidate"
    break
  fi
done

if [ -z "$TARBALL" ]; then
  DOWNLOAD_URL="https://github.com/ilya-zlobintsev/LACT/archive/refs/tags/v${VERSION}.tar.gz"
  echo "Downloading $DOWNLOAD_URL..."
  curl -sSL -o "$CWD/LACT-$VERSION.tar.gz" "$DOWNLOAD_URL"
  TARBALL="$CWD/LACT-$VERSION.tar.gz"
fi

echo "Extracting $(basename "$TARBALL")..."
tar -xzf "$TARBALL"

cd "LACT-"*

# Set permissions
chown -R root:root .
find -L . \
  \( -perm 777 -o -perm 775 -o -perm 750 -o -perm 711 -o -perm 555 -o -perm 511 \) \
  -exec chmod 755 {} \; -o \
  \( -perm 666 -o -perm 664 -o -perm 600 -o -perm 444 -o -perm 440 -o -perm 400 \) \
  -exec chmod 644 {} \;

# Setup pkgconfig override for libdisplay-info 0.4.0 backwards compatibility in libdisplay-info-sys
mkdir -p "$TMP/pkgconfig"
if [ -f "/usr/lib${LIBDIRSUFFIX}/pkgconfig/libdisplay-info.pc" ]; then
  sed 's/^Version:.*/Version: 0.3.0/' "/usr/lib${LIBDIRSUFFIX}/pkgconfig/libdisplay-info.pc" > "$TMP/pkgconfig/libdisplay-info.pc"
elif [ -f "/usr/lib/pkgconfig/libdisplay-info.pc" ]; then
  sed 's/^Version:.*/Version: 0.3.0/' "/usr/lib/pkgconfig/libdisplay-info.pc" > "$TMP/pkgconfig/libdisplay-info.pc"
fi
export PKG_CONFIG_PATH="$TMP/pkgconfig:${PKG_CONFIG_PATH:-/usr/lib${LIBDIRSUFFIX}/pkgconfig:/usr/share/pkgconfig}"

# Build with Cargo
echo "Compiling LACT with Cargo release profile..."
cargo build --release

# Install Binary
mkdir -p "$PKG/usr/bin"
install -m 755 target/release/lact "$PKG/usr/bin/lact"

# Install Desktop file and Icons
mkdir -p "$PKG/usr/share/applications"
mkdir -p "$PKG/usr/share/pixmaps"
mkdir -p "$PKG/usr/share/icons/hicolor/scalable/apps"
mkdir -p "$PKG/usr/share/icons/hicolor/128x128/apps"
mkdir -p "$PKG/usr/share/icons/hicolor/symbolic/apps"
mkdir -p "$PKG/usr/share/metainfo"
mkdir -p "$PKG/usr/share/polkit-1/actions"

[ -f res/io.github.ilya_zlobintsev.LACT.desktop ] && \
  install -m 644 res/io.github.ilya_zlobintsev.LACT.desktop "$PKG/usr/share/applications/"
[ -f res/io.github.ilya_zlobintsev.LACT.svg ] && \
  install -m 644 res/io.github.ilya_zlobintsev.LACT.svg "$PKG/usr/share/icons/hicolor/scalable/apps/" && \
  install -m 644 res/io.github.ilya_zlobintsev.LACT.svg "$PKG/usr/share/pixmaps/"
[ -f res/io.github.ilya_zlobintsev.LACT.png ] && \
  install -m 644 res/io.github.ilya_zlobintsev.LACT.png "$PKG/usr/share/icons/hicolor/128x128/apps/"
[ -f res/io.github.ilya_zlobintsev.LACT-symbolic.svg ] && \
  install -m 644 res/io.github.ilya_zlobintsev.LACT-symbolic.svg "$PKG/usr/share/icons/hicolor/symbolic/apps/"
[ -f res/io.github.ilya_zlobintsev.LACT.metainfo.xml ] && \
  install -m 644 res/io.github.ilya_zlobintsev.LACT.metainfo.xml "$PKG/usr/share/metainfo/"
[ -f res/io.github.ilya_zlobintsev.LACT.policy ] && \
  install -m 644 res/io.github.ilya_zlobintsev.LACT.policy "$PKG/usr/share/polkit-1/actions/"

# Install SysVinit Service
mkdir -p "$PKG/etc/rc.d"
install -m 755 "$CWD/rc.lact" "$PKG/etc/rc.d/rc.lact.new"

# Documentation
mkdir -p "$PKG/usr/doc/$PRGNAM-$VERSION"
cp -a LICENSE README.md "$PKG/usr/doc/$PRGNAM-$VERSION" || true
cat "$CWD/slack-desc" > "$PKG/usr/doc/$PRGNAM-$VERSION/slack-desc"

# Package Install Script
mkdir -p "$PKG/install"
cat "$CWD/slack-desc" > "$PKG/install/slack-desc"
cat "$CWD/doinst.sh" > "$PKG/install/doinst.sh"

# Create Slackware Package
cd "$PKG"
/sbin/makepkg -l y -c n "$OUTPUT/$PRGNAM-$VERSION-$ARCH-$BUILD.txz"

echo "Package created successfully: $OUTPUT/$PRGNAM-$VERSION-$ARCH-$BUILD.txz"
