#!/usr/bin/env bash
# ==============================================================================
#  Slackware build script for spacenavd (3Dconnexion 6DoF Device Daemon)
#  Maintained by TuxOfValhalla <agnar1984@gmail.com>
# ==============================================================================

set -euo pipefail

PRGNAM=spacenavd
VERSION=${VERSION:-1.3.1}
BUILD=${BUILD:-1_slacky}
TAG=${TAG:-_slacky}

if [ -z "${ARCH:-}" ]; then
  case "$(uname -m)" in
    i?86) ARCH=i586 ;;
    arm*) ARCH=arm ;;
    *) ARCH=$(uname -m) ;;
  esac
fi

CWD=$(pwd)
TMP=${TMP:-/tmp/SBo}
PKG=$TMP/package-$PRGNAM
OUTPUT=${OUTPUT:-/tmp}

if [ "$ARCH" = "x86_64" ]; then
  SLKCFLAGS="-O2 -fPIC"
  LIBDIRSUFFIX="64"
else
  SLKCFLAGS="-O2"
  LIBDIRSUFFIX=""
fi

rm -rf "$PKG"
mkdir -p "$TMP" "$PKG" "$OUTPUT"
cd "$TMP"
rm -rf "$PRGNAM-$VERSION"
tar -xf "$CWD/$PRGNAM-$VERSION.tar.gz"
cd "$PRGNAM-$VERSION"

chown -R root:root .
find -L . \
  \( -perm 777 -o -perm 775 -o -perm 750 -o -perm 711 -o -perm 555 -o -perm 511 \) \
  -exec chmod 755 {} \; -o \
  \( -perm 666 -o -perm 664 -o -perm 600 -o -perm 444 -o -perm 440 -o -perm 400 \) \
  -exec chmod 644 {} \;

echo "Configuring spacenavd..."
CFLAGS="$SLKCFLAGS" \
CXXFLAGS="$SLKCFLAGS" \
./configure \
  --prefix=/usr \
  --enable-x11 \
  --enable-hotplug \
  --enable-opt \
  --disable-debug

echo "Compiling spacenavd..."
make -j"$(nproc)"

echo "Installing to staging directory..."
make install DESTDIR="$PKG"

# Install SysVinit script
mkdir -p "$PKG/etc/rc.d"
install -m 755 "$CWD/rc.spacenavd" "$PKG/etc/rc.d/rc.spacenavd.new"

# Install default config template
mkdir -p "$PKG/etc"
install -m 644 "$CWD/spnavrc" "$PKG/etc/spnavrc.new"

# Install udev rules for all 3Dconnexion & Logitech 3D devices
mkdir -p "$PKG/lib/udev/rules.d"
install -m 644 "$CWD/90-3dconnexion.rules" "$PKG/lib/udev/rules.d/90-3dconnexion.rules"

# Documentation
mkdir -p "$PKG/usr/doc/$PRGNAM-$VERSION"
cp -a AUTHORS COPYING README.md doc/example-spnavrc "$PKG/usr/doc/$PRGNAM-$VERSION/" 2>/dev/null || true
cat "$CWD/slack-desc" > "$PKG/usr/doc/$PRGNAM-$VERSION/slack-desc" 2>/dev/null || true

# Package metadata & doinst.sh
mkdir -p "$PKG/install"
cat "$CWD/slack-desc" > "$PKG/install/slack-desc"

cat << 'EOF_DOINST' > "$PKG/install/doinst.sh"
config() {
  NEW="$1"
  OLD="$(dirname $NEW)/$(basename $NEW .new)"
  if [ ! -r $OLD ]; then
    cp -a $NEW $OLD
  elif [ "$(cat $OLD | md5sum)" = "$(cat $NEW | md5sum)" ]; then
    rm $NEW
  fi
}

config etc/rc.d/rc.spacenavd.new
config etc/spnavrc.new

if [ -x /sbin/udevadm ]; then
  /sbin/udevadm control --reload-rules 2>/dev/null || true
  /sbin/udevadm trigger --subsystem-match=hidraw 2>/dev/null || true
  /sbin/udevadm trigger --subsystem-match=input 2>/dev/null || true
fi
EOF_DOINST

# Build package
cd "$PKG"
/sbin/makepkg -l y -c n "$OUTPUT/$PRGNAM-$VERSION-$ARCH-$BUILD.txz"

echo "Package created: $OUTPUT/$PRGNAM-$VERSION-$ARCH-$BUILD.txz"
