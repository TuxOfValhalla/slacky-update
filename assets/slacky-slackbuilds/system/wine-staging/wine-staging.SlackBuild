#!/usr/bin/env bash
# ==============================================================================
#  Slackware build script for wine-staging
#  Maintained by TuxOfValhalla <agnar1984@gmail.com>
# ==============================================================================

set -euo pipefail

cd "$(dirname "$0")" ; CWD=$(pwd)

PRGNAM=wine-staging

# Dynamically query latest wine-staging tag from upstream if VERSION is not set
if [ -z "${VERSION:-}" ]; then
  ONLINE_TAG=$(curl -sSL "https://gitlab.winehq.org/api/v4/projects/wine%2Fwine-staging/repository/tags" 2>/dev/null | grep -o '"name":"v[0-9.]*"' | head -n1 | cut -d'"' -f4 | sed 's/^v//' || echo "")
  VERSION="${ONLINE_TAG:-11.16}"
fi

WINEVERSION=$VERSION
STAGINGVERSION=$WINEVERSION
ARCHS="x86_64"
MULTI=""
BUILD=${BUILD:-1_slacky}
TAG=${TAG:-_slacky}
PKGTYPE=${PKGTYPE:-txz}

TMP=${TMP:-/tmp/SBo}
PKG=$TMP/package-$PRGNAM
OUTPUT=${OUTPUT:-/tmp}

if [ -z "${ARCH:-}" ]; then
  case "$(uname -m)" in
    i?86) ARCH=i586 ;;
    arm*) ARCH=arm ;;
    *) ARCH=$(uname -m) ;;
  esac
fi

# Download source tarballs if absent
if [ ! -f "$CWD/wine-$WINEVERSION.tar.xz" ]; then
  echo "Fetching wine-$WINEVERSION.tar.xz..."
  curl -sSL -o "$CWD/wine-$WINEVERSION.tar.xz" "https://dl.winehq.org/wine/source/11.x/wine-$WINEVERSION.tar.xz" 2>/dev/null || \
  curl -sSL -o "$CWD/wine-$WINEVERSION.tar.xz" "https://dl.winehq.org/wine/source/10.x/wine-$WINEVERSION.tar.xz" 2>/dev/null || true
fi

if [ ! -f "$CWD/wine-staging-$STAGINGVERSION.tar.gz" ] && [ ! -f "$CWD/v$STAGINGVERSION.tar.gz" ]; then
  echo "Fetching wine-staging v$STAGINGVERSION.tar.gz..."
  curl -sSL -o "$CWD/v$STAGINGVERSION.tar.gz" "https://github.com/wine-staging/wine-staging/archive/refs/tags/v$STAGINGVERSION.tar.gz" 2>/dev/null || true
fi

rm -rf "$PKG"
mkdir -p "$TMP" "$PKG" "$OUTPUT"
cd "$TMP"
rm -rf "wine-$WINEVERSION" "wine-staging-$STAGINGVERSION"

tar -xf "$CWD/wine-$WINEVERSION.tar.xz"
if [ -f "$CWD/wine-staging-$STAGINGVERSION.tar.gz" ]; then
  tar -xf "$CWD/wine-staging-$STAGINGVERSION.tar.gz"
elif [ -f "$CWD/v$STAGINGVERSION.tar.gz" ]; then
  tar -xf "$CWD/v$STAGINGVERSION.tar.gz"
fi

cd "wine-$WINEVERSION"

chown -R root:root .
find -L . \
  \( -perm 777 -o -perm 775 -o -perm 750 -o -perm 711 -o -perm 555 -o -perm 511 \) \
  -exec chmod 755 {} \; -o \
  \( -perm 666 -o -perm 664 -o -perm 600 -o -perm 444 -o -perm 440 -o -perm 400 \) \
  -exec chmod 644 {} \;

# Apply wine-staging patches
STAGINGDIR="$TMP/wine-staging-$STAGINGVERSION"
echo "Applying Wine-Staging patches from $STAGINGDIR..."
python3 "$STAGINGDIR/patches/patchinstall.py" DESTDIR="$TMP/wine-$WINEVERSION" --all

mkdir -p build64
cd build64
CFLAGS="-O2 -fPIC" \
CXXFLAGS="-O2 -fPIC" \
../configure \
  --prefix=/usr \
  --libdir=/usr/lib64 \
  --sysconfdir=/etc \
  --enable-win64 \
  --with-x \
  --with-vulkan \
  --with-wayland \
  --with-gstreamer \
  --without-oss

make -j"$(nproc)"
make install DESTDIR="$PKG"

# Install Desktop Integration
mkdir -p "$PKG/usr/share/applications"
install -m 644 "$CWD/winecfg.desktop" "$PKG/usr/share/applications/winecfg.desktop"
install -m 644 "$CWD/wine-browsedrive.desktop" "$PKG/usr/share/applications/wine-browsedrive.desktop"
install -m 644 "$CWD/wine-uninstaller.desktop" "$PKG/usr/share/applications/wine-uninstaller.desktop"

mkdir -p "$PKG/usr/share/pixmaps"
install -m 644 "$CWD/winecfg.png" "$PKG/usr/share/pixmaps/winecfg.png"
install -m 644 "$CWD/wine.svg" "$PKG/usr/share/pixmaps/wine.svg"

# Documentation
mkdir -p "$PKG/usr/doc/$PRGNAM-$VERSION"
cp -a ../ANNOUNCE* ../AUTHORS ../COPYING* ../LICENSE* ../README* "$PKG/usr/doc/$PRGNAM-$VERSION/" 2>/dev/null || true
cat "$CWD/slack-desc" > "$PKG/usr/doc/$PRGNAM-$VERSION/slack-desc" 2>/dev/null || true

# Package metadata & doinst.sh
mkdir -p "$PKG/install"
cat "$CWD/slack-desc" > "$PKG/install/slack-desc"
cat "$CWD/doinst.sh" > "$PKG/install/doinst.sh"

# Build package
cd "$PKG"
/sbin/makepkg -l y -c n "$OUTPUT/$PRGNAM-$VERSION-$ARCH-$BUILD.$PKGTYPE"

echo "Package created: $OUTPUT/$PRGNAM-$VERSION-$ARCH-$BUILD.$PKGTYPE"
