#!/usr/bin/env bash
# ==============================================================================
#  Slackware build script for storyboarder (Wonder Unit Storyboarder)
#  Maintained by TuxOfValhalla <agnar1984@gmail.com>
# ==============================================================================

set -euo pipefail

PRGNAM=storyboarder
VERSION=${VERSION:-2.1.0}
BUILD=${BUILD:-1_slacky}
TAG=${TAG:-_slacky}
PKGTYPE=${PKGTYPE:-txz}

CWD=$(pwd)

if [ -z "${ARCH:-}" ]; then
  case "$(uname -m)" in
    i?86) ARCH=i586 ;;
    arm*) ARCH=arm ;;
    *) ARCH=$(uname -m) ;;
  esac
fi

if [ "$ARCH" != "x86_64" ]; then
  echo "Storyboarder is only supported on x86_64."
  exit 1
fi

if [ "$ARCH" = "x86_64" ]; then
  LIBDIRSUFFIX="64"
else
  LIBDIRSUFFIX=""
fi

TMP=${TMP:-/tmp/SBo}
PKG=$TMP/package-$PRGNAM
OUTPUT=${OUTPUT:-/tmp}

APPIMAGE_SRC=""
for cand in "$CWD/Storyboarder-${VERSION}-linux-x86_64.AppImage" \
            "$CWD/Storyboarder-"*"-linux-x86_64.AppImage" \
            "$CWD/Storyboarder-"*".AppImage" \
            ~/Downloads/Storyboarder-"${VERSION}"*".AppImage" \
            /tmp/Storyboarder-"${VERSION}"*".AppImage"; do
  if [ -f "$cand" ]; then
    APPIMAGE_SRC="$cand"
    break
  fi
done

if [ -z "$APPIMAGE_SRC" ]; then
  DOWNLOAD_URL="https://github.com/wonderunit/storyboarder/releases/download/v${VERSION}/Storyboarder-${VERSION}-linux-x86_64.AppImage"
  APPIMAGE_SRC="$CWD/Storyboarder-${VERSION}-linux-x86_64.AppImage"
  echo "Fetching Wonder Unit Storyboarder ${VERSION} AppImage..."
  curl -sSLf "$DOWNLOAD_URL" -o "$APPIMAGE_SRC"
fi

rm -rf "$PKG"
mkdir -p "$TMP" "$PKG" "$OUTPUT"
cd "$TMP"
rm -rf squashfs-root

echo "Extracting Storyboarder AppImage..."
chmod +x "$APPIMAGE_SRC"
if command -v 7z >/dev/null 2>&1; then
  7z x -y "$APPIMAGE_SRC" -osquashfs-root >/dev/null 2>&1 || "$APPIMAGE_SRC" --appimage-extract >/dev/null 2>&1
else
  "$APPIMAGE_SRC" --appimage-extract >/dev/null 2>&1
fi

if [ ! -d "squashfs-root" ]; then
  echo "Error: Failed to extract AppImage."
  exit 1
fi

mkdir -p "$PKG/usr/lib${LIBDIRSUFFIX}/storyboarder"
cp -a squashfs-root/* "$PKG/usr/lib${LIBDIRSUFFIX}/storyboarder/"
rm -rf squashfs-root

mkdir -p "$PKG/usr/bin"
cat << EOF_WRAPPER > "$PKG/usr/bin/storyboarder"
#!/bin/sh
export ELECTRON_IS_DEV=0
exec /usr/lib${LIBDIRSUFFIX}/storyboarder/storyboarder --no-sandbox "\$@"
EOF_WRAPPER
chmod 0755 "$PKG/usr/bin/storyboarder"

mkdir -p "$PKG/usr/share/applications"
if [ -f "$CWD/storyboarder.desktop" ]; then
  install -m 0644 "$CWD/storyboarder.desktop" "$PKG/usr/share/applications/"
fi

mkdir -p "$PKG/usr/share/icons/hicolor/512x512/apps"
if [ -f "$PKG/usr/lib${LIBDIRSUFFIX}/storyboarder/storyboarder.png" ]; then
  install -m 0644 "$PKG/usr/lib${LIBDIRSUFFIX}/storyboarder/storyboarder.png" "$PKG/usr/share/icons/hicolor/512x512/apps/storyboarder.png"
elif [ -f "$PKG/usr/lib${LIBDIRSUFFIX}/storyboarder/usr/share/icons/hicolor/512x512/apps/storyboarder.png" ]; then
  install -m 0644 "$PKG/usr/lib${LIBDIRSUFFIX}/storyboarder/usr/share/icons/hicolor/512x512/apps/storyboarder.png" "$PKG/usr/share/icons/hicolor/512x512/apps/storyboarder.png"
fi

mkdir -p "$PKG/install"
cat "$CWD/slack-desc" > "$PKG/install/slack-desc"
if [ -f "$CWD/doinst.sh" ]; then
  cat "$CWD/doinst.sh" > "$PKG/install/doinst.sh"
fi

# Sanitize permissions for Slackware policy compliance and regular user execution
find "$PKG" -type d -exec chmod 0755 {} +
find "$PKG" -type f -exec chmod 0644 {} +
chmod 0755 "$PKG/usr/bin/"* "$PKG/usr/lib${LIBDIRSUFFIX}/storyboarder/storyboarder"
chmod 4755 "$PKG/usr/lib${LIBDIRSUFFIX}/storyboarder/chrome-sandbox" 2>/dev/null || true
find "$PKG/usr/lib${LIBDIRSUFFIX}/storyboarder" -name "*.so*" -exec chmod 0755 {} + 2>/dev/null || true
find "$PKG/usr/lib${LIBDIRSUFFIX}/storyboarder" -name "ffmpeg" -exec chmod 0755 {} + 2>/dev/null || true

cd "$PKG"
/sbin/makepkg -l y -c n "$OUTPUT/$PRGNAM-$VERSION-$ARCH-$BUILD$TAG.$PKGTYPE"
