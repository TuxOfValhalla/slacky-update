#!/usr/bin/env bash
# ==============================================================================
#  Slackware build script for Bambu Studio (Official 3D Slicer)
#  Maintained by TuxOfValhalla <agnar1984@gmail.com>
# ==============================================================================

set -euo pipefail

PRGNAM=bambu-studio
VERSION=${VERSION:-02.08.02.61}
BUILD=${BUILD:-1_slacky}
TAG=${TAG:-_slacky}

if [ -z "${ARCH:-}" ]; then
  case "$(uname -m)" in
    i?86) ARCH=i586 ;;
    arm*) ARCH=arm ;;
    *) ARCH=$(uname -m) ;;
  esac
fi

if [ "$ARCH" != "x86_64" ]; then
  echo "Bambu Studio is only supported on x86_64."
  exit 1
fi

CWD=$(pwd)
TMP=${TMP:-/tmp/SBo}
PKG=$TMP/package-$PRGNAM
OUTPUT=${OUTPUT:-/tmp}

APPIMAGE=""
for cand in "$CWD/BambuStudio"*"-v${VERSION}"*".AppImage" \
            "$CWD/BambuStudio"*"-v0${VERSION}"*".AppImage" \
            "$CWD/Bambu_Studio"*"-v${VERSION}"*".AppImage" \
            "$CWD/Bambu"*".AppImage"; do
  if [ -f "$cand" ]; then
    APPIMAGE="$cand"
    break
  fi
done

if [ -z "$APPIMAGE" ]; then
  echo "Error: Bambu Studio AppImage not found in $CWD."
  echo "Please download the official AppImage from https://github.com/bambulab/BambuStudio/releases"
  exit 1
fi

rm -rf "$PKG"
mkdir -p "$TMP" "$PKG" "$OUTPUT"
cd "$TMP"
rm -rf "squashfs-root"

echo "Extracting Bambu Studio $VERSION AppImage..."
chmod +x "$APPIMAGE"
"$APPIMAGE" --appimage-extract >/dev/null

cd "squashfs-root"

chown -R root:root .
find -L . \
  \( -perm 777 -o -perm 775 -o -perm 750 -o -perm 711 -o -perm 555 -o -perm 511 \) \
  -exec chmod 755 {} \; -o \
  \( -perm 666 -o -perm 664 -o -perm 600 -o -perm 444 -o -perm 440 -o -perm 400 \) \
  -exec chmod 644 {} \;

# Install main payload to /opt/bambu-studio-$VERSION
mkdir -p "$PKG/opt/bambu-studio-$VERSION"
cp -a * "$PKG/opt/bambu-studio-$VERSION/"

# Extract and bundle isolated WebKit2GTK, AVIF, YUV and graphical runtime libraries into /opt/bambu-studio-$VERSION/lib
mkdir -p "$PKG/opt/bambu-studio-$VERSION/lib"
for wpkg in "$CWD"/*.pkg.tar.zst /var/cache/slacky-update/archives/*.pkg.tar.zst; do
  [ -f "$wpkg" ] || continue
  case "$(basename "$wpkg")" in
    webkit2gtk-4.1*|wpebackend-fdo*|libmanette*|libavif*|dav1d*|aom*|libyuv*|glu-*|glew-*|onetbb*|tbb*|nlopt*|rav1e*|svt-av1*|libjxl*|highway*)
      echo "Bundling isolated runtime from $(basename "$wpkg")..."
      wextract="$TMP/dep-extract-$(basename "$wpkg")"
      rm -rf "$wextract"
      mkdir -p "$wextract"
      tar --zstd -xf "$wpkg" -C "$wextract"
      if [ -d "$wextract/usr/lib" ]; then
        cp -a "$wextract"/usr/lib/*.so* "$PKG/opt/bambu-studio-$VERSION/lib/" 2>/dev/null || true
        if [ -d "$wextract/usr/lib/webkit2gtk-4.1" ]; then
          cp -a "$wextract"/usr/lib/webkit2gtk-4.1 "$PKG/opt/bambu-studio-$VERSION/lib/" 2>/dev/null || true
          chmod -R 755 "$PKG/opt/bambu-studio-$VERSION/lib/webkit2gtk-4.1" 2>/dev/null || true
        fi
      fi
      if [ -d "$wextract/usr/lib64" ]; then
        cp -a "$wextract"/usr/lib64/*.so* "$PKG/opt/bambu-studio-$VERSION/lib/" 2>/dev/null || true
      fi
      rm -rf "$wextract"
      ;;
  esac
done

# Create /usr/lib/webkit2gtk-4.1 and /usr/lib64/webkit2gtk-4.1 compatibility symlinks for hardcoded libexec paths
if [ -d "$PKG/opt/bambu-studio-$VERSION/lib/webkit2gtk-4.1" ]; then
  mkdir -p "$PKG/usr/lib" "$PKG/usr/lib64"
  ln -sfn /opt/bambu-studio/lib/webkit2gtk-4.1 "$PKG/usr/lib/webkit2gtk-4.1"
  ln -sfn /opt/bambu-studio/lib/webkit2gtk-4.1 "$PKG/usr/lib64/webkit2gtk-4.1"
fi

# Install runtime wrapper
mkdir -p "$PKG/usr/bin"
install -m 755 "$CWD/bambu-studio-wrapper.sh" "$PKG/usr/bin/bambu-studio"
ln -sf bambu-studio "$PKG/usr/bin/BambuStudio"
ln -sf bambu-studio "$PKG/usr/bin/bambu-studio-$VERSION"

# Install Desktop Entry & Icons
mkdir -p "$PKG/usr/share/applications"
install -m 644 "$CWD/bambu-studio.desktop" "$PKG/usr/share/applications/bambu-studio.desktop"

mkdir -p "$PKG/usr/share/pixmaps" "$PKG/usr/share/icons/hicolor/scalable/apps" "$PKG/usr/share/icons/hicolor/256x256/apps"
if [ -f "BambuStudio.png" ]; then
  install -m 644 BambuStudio.png "$PKG/usr/share/pixmaps/bambu-studio.png"
  install -m 644 BambuStudio.png "$PKG/usr/share/icons/hicolor/256x256/apps/bambu-studio.png"
elif [ -f "bambu-studio.png" ]; then
  install -m 644 bambu-studio.png "$PKG/usr/share/pixmaps/bambu-studio.png"
  install -m 644 bambu-studio.png "$PKG/usr/share/icons/hicolor/256x256/apps/bambu-studio.png"
fi

if [ -f "BambuStudio.svg" ]; then
  install -m 644 BambuStudio.svg "$PKG/usr/share/icons/hicolor/scalable/apps/bambu-studio.svg"
fi

# Install Udev Rules
mkdir -p "$PKG/lib/udev/rules.d"
install -m 644 "$CWD/99-bambulab-devices.rules" "$PKG/lib/udev/rules.d/99-bambulab-devices.rules"

# Documentation
mkdir -p "$PKG/usr/doc/$PRGNAM-$VERSION"
cat "$CWD/slack-desc" > "$PKG/usr/doc/$PRGNAM-$VERSION/slack-desc" 2>/dev/null || true

# Package metadata & doinst.sh
mkdir -p "$PKG/install"
cat "$CWD/slack-desc" > "$PKG/install/slack-desc"

cat << 'EOF_DOINST' > "$PKG/install/doinst.sh"
if [ ! -d opt/bambu-studio ]; then
  rm -f opt/bambu-studio 2>/dev/null || true
  ln -sfn bambu-studio-VERSION opt/bambu-studio 2>/dev/null || true
fi

# WebKit2GTK-4.1 helper process symlinks
if [ -d opt/bambu-studio/lib/webkit2gtk-4.1 ]; then
  if [ ! -e usr/lib/webkit2gtk-4.1 ]; then
    mkdir -p usr/lib 2>/dev/null || true
    ln -sfn /opt/bambu-studio/lib/webkit2gtk-4.1 usr/lib/webkit2gtk-4.1 2>/dev/null || true
  fi
  if [ ! -e usr/lib64/webkit2gtk-4.1 ]; then
    mkdir -p usr/lib64 2>/dev/null || true
    ln -sfn /opt/bambu-studio/lib/webkit2gtk-4.1 usr/lib64/webkit2gtk-4.1 2>/dev/null || true
  fi
fi

if [ -x /sbin/udevadm ]; then
  /sbin/udevadm control --reload-rules 2>/dev/null || true
  /sbin/udevadm trigger 2>/dev/null || true
fi

if [ -x /usr/bin/update-desktop-database ]; then
  /usr/bin/update-desktop-database /usr/share/applications 2>/dev/null || true
fi

if [ -x /usr/bin/gtk-update-icon-cache ]; then
  /usr/bin/gtk-update-icon-cache -f -t /usr/share/icons/hicolor 2>/dev/null || true
fi

if [ -x /usr/bin/update-mime-database ]; then
  /usr/bin/update-mime-database /usr/share/mime 2>/dev/null || true
fi
EOF_DOINST

sed -i "s/VERSION/${VERSION}/g" "$PKG/install/doinst.sh"

cd "$PKG"
/sbin/makepkg -l y -c n "$OUTPUT/$PRGNAM-$VERSION-$ARCH-$BUILD$TAG.txz"
