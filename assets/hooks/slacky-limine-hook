#!/bin/sh
# --- [ SLACKWARE KERNEL POST-INSTALL HOOK FOR LIMINE & DRACUT ] ---
# Installed to /etc/kernel/postinst.d/slacky-limine-hook
#
# SS-4 / 6A-106 (one menu writer): this hook only places an order. It used to run dracut, kernel signing, limine.conf,
# BLAKE2B enroll, sbctl and GRUB itself, outside any lock and in parallel with a running update. Now it marks
# "boot files changed, Limine not resealed yet" (the 6A-8c marker) and exits. Whoever holds the boot chain next serves
# it exactly once: the boot commit of a running slacky-update, or the hourly job (slacky-snapper-limine-sync, which runs
# `slacky-update --sync-boot` = initramfs for the installed kernels + menu + enroll + sign, under the boot lock).
# Nothing in Slackware runs /etc/kernel/postinst.d by itself; the hook only fires when a tool calls run-parts on it.

MARKER_DIR="/var/cache/slacky-update"
mkdir -p "${MARKER_DIR}" 2>/dev/null || true
: > "${MARKER_DIR}/boot-reseal-pending" 2>/dev/null || true
exit 0
