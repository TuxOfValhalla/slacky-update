#!/usr/bin/env bash
# --- [ SLACKWARE BUILD SCRIPT ] ---

set -euo pipefail

PRGNAM="slacky-update"
VERSION="1.0_RC2"
ARCH="noarch"
BUILD="102_slacky"

SRC_DIR="$(cd "$(dirname "$0")/.." && pwd)"
OUTPUT_DIR="${OUTPUT_DIR:-${SRC_DIR}/../slacky-updates_releases}"
# 6A-149 (L lifecycle 4): no fallback to /tmp; a package root installs must never come from a world-writable place
if ! mkdir -p "${OUTPUT_DIR}" 2>/dev/null || [ ! -w "${OUTPUT_DIR}" ]; then
    echo "ERROR: output directory ${OUTPUT_DIR} is not writable; set OUTPUT_DIR to a private directory." >&2
    exit 1
fi
# private, unpredictable build and staging dirs (were fixed /tmp names)
BUILD_DIR="$(mktemp -d "${TMPDIR:-/tmp}/build-${PRGNAM}.XXXXXX")"
PKG_DIR="$(mktemp -d "${TMPDIR:-/tmp}/package-${PRGNAM}.XXXXXX")"
chmod 0755 "${PKG_DIR}"   # the package root entry "./" must stay 0755

PKG_NAME="${PRGNAM}-${VERSION}-${ARCH}-${BUILD}.txz"

# --- [ CLEANUP PREVIOUS BUILDS ] ---
mkdir -p "${OUTPUT_DIR}"

# --- [ STAGING FILES ] ---
mkdir -p "${PKG_DIR}/usr/bin"
mkdir -p "${PKG_DIR}/usr/share/slacky-update/lib"
mkdir -p "${PKG_DIR}/usr/share/slacky-update/locales"
mkdir -p "${PKG_DIR}/usr/share/slacky-update/docs"
mkdir -p "${PKG_DIR}/usr/share/applications"
mkdir -p "${PKG_DIR}/usr/share/icons/hicolor/128x128/apps"
mkdir -p "${PKG_DIR}/etc/xdg/autostart"
mkdir -p "${PKG_DIR}/etc/profile.d"
mkdir -p "${PKG_DIR}/etc/cron.hourly"
mkdir -p "${PKG_DIR}/etc/cron.weekly"
mkdir -p "${PKG_DIR}/etc/kernel/postinst.d"
mkdir -p "${PKG_DIR}/etc/boot/hooks/pre.d"
mkdir -p "${PKG_DIR}/etc/boot/hooks/post.d"
mkdir -p "${PKG_DIR}/etc/sysctl.d"
mkdir -p "${PKG_DIR}/var/cache/slacky-update"
mkdir -p "${PKG_DIR}/install"

chmod 0755 "${PKG_DIR}/var/cache/slacky-update"   # 6A-149: root-only cache from the start (doinst repairs old 1777)

# --- [ FILE INSTALLATION ] ---
install -m 0755 "${SRC_DIR}/bin/slacky-update" "${PKG_DIR}/usr/bin/"
install -m 0755 "${SRC_DIR}/bin/slacky-update-tray" "${PKG_DIR}/usr/bin/"
install -m 0755 "${SRC_DIR}/bin/slacky-prime-run" "${PKG_DIR}/usr/bin/"
if [ -f "${SRC_DIR}/bin/gnomes" ]; then
    install -m 0755 "${SRC_DIR}/bin/gnomes" "${PKG_DIR}/usr/bin/"
fi
# 6A-274: the read-only SpiderSense window; skipped when another package already owns /usr/bin/spidersense
if [ -f "${SRC_DIR}/bin/spidersense" ]; then
    if grep -l '^usr/bin/spidersense$' /var/log/packages/* 2>/dev/null | grep -qv '/slacky-update-[0-9]'; then
        echo "Note: /usr/bin/spidersense belongs to another package; the spidersense command is not installed."
    else
        install -m 0755 "${SRC_DIR}/bin/spidersense" "${PKG_DIR}/usr/bin/"
    fi
fi

install -m 0755 "${SRC_DIR}"/lib/*.sh "${PKG_DIR}/usr/share/slacky-update/lib/"
install -m 0755 "${SRC_DIR}/lib/slacky-update-tray" "${PKG_DIR}/usr/share/slacky-update/lib/" 2>/dev/null || true
install -m 0755 "${SRC_DIR}/lib/gnomes_pacman.py" "${PKG_DIR}/usr/share/slacky-update/lib/"
install -m 0644 "${SRC_DIR}/lib/gnomes_trust.py" "${PKG_DIR}/usr/share/slacky-update/lib/"
install -m 0644 "${SRC_DIR}/lib/slacky_vendor_fetch.py" "${PKG_DIR}/usr/share/slacky-update/lib/"
install -m 0644 "${SRC_DIR}/lib/slacky_mirrors.py" "${PKG_DIR}/usr/share/slacky-update/lib/"
install -m 0644 "${SRC_DIR}/lib/slacky_release_cache.py" "${PKG_DIR}/usr/share/slacky-update/lib/"
install -m 0644 "${SRC_DIR}/lib/slacky_symver.py" "${PKG_DIR}/usr/share/slacky-update/lib/"
install -m 0644 "${SRC_DIR}/lib/slacky_runtime_refresh.py" "${PKG_DIR}/usr/share/slacky-update/lib/"
install -m 0644 "${SRC_DIR}/lib/slacky_net.py" "${PKG_DIR}/usr/share/slacky-update/lib/"
install -m 0644 "${SRC_DIR}/lib/slacky_slackpkg_check.py" "${PKG_DIR}/usr/share/slacky-update/lib/"
install -m 0644 "${SRC_DIR}/lib/slacky_sentinel.py" "${PKG_DIR}/usr/share/slacky-update/lib/"
install -m 0644 "${SRC_DIR}/lib/spidersense_snap.py" "${PKG_DIR}/usr/share/slacky-update/lib/"
install -m 0644 "${SRC_DIR}/lib/spidersense_hw.py" "${PKG_DIR}/usr/share/slacky-update/lib/"
install -m 0644 "${SRC_DIR}/lib/pacman_candy.py" "${PKG_DIR}/usr/share/slacky-update/lib/"
install -m 0755 "${SRC_DIR}/lib/rank_mirrors.py" "${PKG_DIR}/usr/share/slacky-update/lib/"
install -m 0755 "${SRC_DIR}/lib/slacky_config.py" "${PKG_DIR}/usr/share/slacky-update/lib/"
install -m 0755 "${SRC_DIR}/lib/slacky_heal.py" "${PKG_DIR}/usr/share/slacky-update/lib/"
install -m 0644 "${SRC_DIR}/lib/slacky_update_i18n.py" "${PKG_DIR}/usr/share/slacky-update/lib/"
install -m 0755 "${SRC_DIR}/lib/slacky_tui.py" "${PKG_DIR}/usr/share/slacky-update/lib/"
install -m 0755 "${SRC_DIR}/lib/slacky_doctor.py" "${PKG_DIR}/usr/share/slacky-update/lib/"
install -m 0644 "${SRC_DIR}"/locales/*.json "${PKG_DIR}/usr/share/slacky-update/locales/"

# 6A-319 (LTS S9): documents come from an explicit list, so the package is reproducible and never carries the work logs
# (log.md, log_nb.md), the repair notes or other development files. A listed file that is missing stops the build.
SHIPPED_DOCS="
SLACKY_UPDATE_FIELD_GUIDE.md
LIMINE_SECUREBOOT_FIELD_GUIDE.md
UNDERPANTS_GNOMES_FIELD_GUIDE.md
TECHNICAL_COMPANION_GUIDE.md
TROUBLESHOOTING_GUIDE.md
THE_ULTIMATE_SLACKY_UPDATE_SURVIVAL_GUIDE.md
OH_MY_HYPRLAND_GUIDE.md
config_store_spec.md
footprint_spec.md
mirror_key_spec.md
rclocal_spec.md
reboot_rules.md
"
for doc in ${SHIPPED_DOCS}; do
    if [ ! -f "${SRC_DIR}/docs/${doc}" ]; then
        echo "ERROR: listed document docs/${doc} is missing." >&2
        exit 1
    fi
    install -m 0644 "${SRC_DIR}/docs/${doc}" "${PKG_DIR}/usr/share/slacky-update/docs/"
done

install -m 0644 "${SRC_DIR}/desktop/slacky-update.desktop" "${PKG_DIR}/usr/share/applications/"
install -m 0644 "${SRC_DIR}/desktop/slacky-update-tray.desktop" "${PKG_DIR}/usr/share/applications/"
# 6A-319 (LTS S8): files an admin may switch off (tray autostart, cron jobs, profile.d, kernel hook) are shipped as .new in
# mode 0644 (never run by cron or sourced by the shell while they are .new); doinst installs them only when absent, so an
# upgrade never switches a disabled job back on (see config_job in doinst below)
install -m 0644 "${SRC_DIR}/desktop/slacky-update-tray.desktop" "${PKG_DIR}/etc/xdg/autostart/slacky-update-tray.desktop.new"

install -m 0644 "${SRC_DIR}/cron/slacky-snapper-limine-sync" "${PKG_DIR}/etc/cron.hourly/slacky-snapper-limine-sync.new"
install -m 0644 "${SRC_DIR}/cron/slacky-update-check" "${PKG_DIR}/etc/cron.weekly/slacky-update-check.new"
# 6A-28: base hardening, shipped as .new so a file the user changed (protect-links off) survives upgrades
install -m 0644 "${SRC_DIR}/assets/sysctl.d/50-slacky-protect-links.conf" "${PKG_DIR}/etc/sysctl.d/50-slacky-protect-links.conf.new"

if [ -d "${SRC_DIR}/assets/profile.d" ]; then
    for pf in "${SRC_DIR}"/assets/profile.d/*; do
        [ -f "${pf}" ] && install -m 0644 "${pf}" "${PKG_DIR}/etc/profile.d/$(basename "${pf}").new"
    done
fi

if [ -f "${SRC_DIR}/assets/hooks/slacky-limine-hook" ]; then
    install -m 0644 "${SRC_DIR}/assets/hooks/slacky-limine-hook" "${PKG_DIR}/etc/kernel/postinst.d/slacky-limine-hook.new"
fi

if [ -f "${SRC_DIR}/slackbuild/slack-desc" ]; then
    install -m 0644 "${SRC_DIR}/slackbuild/slack-desc" "${PKG_DIR}/install/"
fi

if [ -d "${SRC_DIR}/assets" ]; then
    mkdir -p "${PKG_DIR}/usr/share/slacky-update/assets"
    install -m 0644 "${SRC_DIR}"/assets/*.png "${PKG_DIR}/usr/share/icons/hicolor/128x128/apps/" 2>/dev/null || true
    install -m 0644 "${SRC_DIR}"/assets/*.png "${PKG_DIR}/usr/share/slacky-update/assets/" 2>/dev/null || true
    if [ -d "${SRC_DIR}/assets/slacky-slackbuilds" ]; then
        cp -a "${SRC_DIR}/assets/slacky-slackbuilds" "${PKG_DIR}/usr/share/slacky-update/assets/"
        mkdir -p "${PKG_DIR}/usr/local/lib/slacky-update/assets"
        cp -a "${SRC_DIR}/assets/slacky-slackbuilds" "${PKG_DIR}/usr/local/lib/slacky-update/assets/"
    fi
    if [ -d "${SRC_DIR}/assets/udev" ]; then
        cp -a "${SRC_DIR}/assets/udev" "${PKG_DIR}/usr/share/slacky-update/assets/"
        mkdir -p "${PKG_DIR}/usr/local/lib/slacky-update/assets"
        cp -a "${SRC_DIR}/assets/udev" "${PKG_DIR}/usr/local/lib/slacky-update/assets/"
    fi
    if [ -d "${SRC_DIR}/assets/hooks" ]; then
        cp -a "${SRC_DIR}/assets/hooks" "${PKG_DIR}/usr/share/slacky-update/assets/"
        mkdir -p "${PKG_DIR}/usr/local/lib/slacky-update/assets"
        cp -a "${SRC_DIR}/assets/hooks" "${PKG_DIR}/usr/local/lib/slacky-update/assets/"
    fi
    if [ -d "${SRC_DIR}/assets/polkit" ]; then
        mkdir -p "${PKG_DIR}/usr/share/polkit-1/actions"
        install -m 0644 "${SRC_DIR}"/assets/polkit/*.policy "${PKG_DIR}/usr/share/polkit-1/actions/" 2>/dev/null || true
    fi
fi

if [ -d "${SRC_DIR}/keys" ]; then
    mkdir -p "${PKG_DIR}/usr/share/slacky-update/keys"
    install -m 0644 "${SRC_DIR}"/keys/* "${PKG_DIR}/usr/share/slacky-update/keys/" 2>/dev/null || true
    mkdir -p "${PKG_DIR}/usr/local/lib/slacky-update/keys"
    install -m 0644 "${SRC_DIR}"/keys/* "${PKG_DIR}/usr/local/lib/slacky-update/keys/" 2>/dev/null || true
fi

if [ -d "${SRC_DIR}/certs" ]; then
    mkdir -p "${PKG_DIR}/usr/share/slacky-update/certs"
    install -m 0644 "${SRC_DIR}"/certs/* "${PKG_DIR}/usr/share/slacky-update/certs/" 2>/dev/null || true
    mkdir -p "${PKG_DIR}/usr/local/lib/slacky-update/certs"
    install -m 0644 "${SRC_DIR}"/certs/* "${PKG_DIR}/usr/local/lib/slacky-update/certs/" 2>/dev/null || true
fi

# --- [ POST-INSTALL SCRIPT (doinst.sh) ] ---
cat << 'DOINST_EOF' > "${PKG_DIR}/install/doinst.sh"
#!/bin/sh
# NOLOCK

# 6A-17: the system cache is root-only; user-mode checks write to ~/.cache/slacky-update. Repairs an old 1777 cache once.
install -d -m 0755 -o root -g root /var/cache/slacky-update
if [ -n "$(find /var/cache/slacky-update \( ! -user root -o ! -group root -o -perm -0002 \) -print -quit 2>/dev/null)" ]; then
    chown -R root:root /var/cache/slacky-update 2>/dev/null || true
    chmod -R go-w /var/cache/slacky-update 2>/dev/null || true
fi
if [ -f /var/log/slacky-update.log ]; then
    chown root:root /var/log/slacky-update.log 2>/dev/null || true
    chmod 0644 /var/log/slacky-update.log 2>/dev/null || true
fi

# 6A-28: link protection (on by default; keep the user's file if they changed it)
config() {
  NEW="$1"
  OLD="$(dirname "$NEW")/$(basename "$NEW" .new)"
  if [ ! -r "$OLD" ]; then
    mv "$NEW" "$OLD"
  elif [ "$(md5sum < "$OLD")" = "$(md5sum < "$NEW")" ]; then
    rm "$NEW"
  fi
}
config etc/sysctl.d/50-slacky-protect-links.conf.new

# --- config_job begin ---
# 6A-319 (LTS S8): admin-switchable files (cron jobs, profile.d, tray autostart, kernel hook) come as .new.
#   - absent: installed with its mode (so a fresh install works at once);
#   - same content: the .new is dropped;
#   - an untouched older shipped version (md5 in the list): takes the new content and KEEPS its mode, so a job switched
#     off with chmod -x stays off;
#   - changed by the admin: kept as it is, the .new stays for the admin to compare.
# Packages older than this one shipped these files as plain files; upgradepkg removes such a plain file after the new
# doinst has run, so a small detached helper puts the kept file back for up to two minutes if that happens.
# The md5 list holds every earlier shipped version; add the md5 of the replaced version when a file changes.
config_job() {
  NEW="$1"; MODE="$2"; shift 2
  OLD="${NEW%.new}"
  # 6A-335: earlier builds left executable copies next to the job (run-parts ran them, root jobs ran twice): remove them
  rm -f "$OLD".slacky-keep.* 2>/dev/null || true
  [ -f "$NEW" ] || return 0
  if [ ! -e "$OLD" ]; then
    mv "$NEW" "$OLD"
    chmod "$MODE" "$OLD" 2>/dev/null || true
    return 0
  fi
  SUM="$(md5sum < "$OLD" | cut -d' ' -f1)"
  if [ "$SUM" = "$(md5sum < "$NEW" | cut -d' ' -f1)" ]; then
    rm -f "$NEW"
  else
    for K in "$@"; do
      if [ "$SUM" = "$K" ]; then
        chmod --reference="$OLD" "$NEW" 2>/dev/null || true
        mv -f "$NEW" "$OLD"
        break
      fi
    done
  fi
  # 6A-335: the spare copy lives outside every run-parts / profile.d / autostart directory
  mkdir -p var/cache/slacky-update 2>/dev/null || return 0
  KEEP="$(mktemp "var/cache/slacky-update/keep.$(basename "$OLD").XXXXXX" 2>/dev/null)" || return 0
  cp -p "$OLD" "$KEEP" 2>/dev/null || { rm -f "$KEEP"; return 0; }
  ( trap '' HUP INT
    i=0
    while [ "$i" -lt "${SLACKY_KEEP_POLLS:-60}" ]; do
      if [ ! -e "$OLD" ]; then mv "$KEEP" "$OLD" 2>/dev/null; break; fi
      sleep "${SLACKY_KEEP_SLEEP:-2}"; i=$((i + 1))
    done
    rm -f "$KEEP" ) </dev/null >/dev/null 2>&1 &
  return 0
}
# --- config_job end ---

config_job etc/xdg/autostart/slacky-update-tray.desktop.new 0644 \
    ab8e1cf6eb182b87370732217630486c 623a61a7e93003cd7310175d54781c4a
config_job etc/cron.hourly/slacky-snapper-limine-sync.new 0755 \
    34d573d215bc713a69018ed184d3d061 29f8cc91fffe082cb059ac7e610d8d14
config_job etc/cron.weekly/slacky-update-check.new 0755 \
    eadb8f692c115aae30ac02fdbe9e7fd4 e776637a77b91ea62bd79432333339fa 85e76b708e50e5ba6e7714f9c9bd344e \
    85036216f601f021f7484f0133d7ec68 1ef09cc50bba7a6fa48e7dd1f16a3e18 043812f68129b13a85d463eddf8b3e48
config_job etc/profile.d/slacky-hidpi.sh.new 0755 \
    84c5dd687874f832be3efe54c169a2a8 1454a0e2e227caf5b6129a01241dd8aa
config_job etc/profile.d/slacky-hidpi.csh.new 0755 \
    331f5b8b4ffb323808fefc855bd72fa9
config_job etc/kernel/postinst.d/slacky-limine-hook.new 0755 \
    a6b89910b77cad1dc643c722dc5b0812 82fa6f765d43b8035f7fd0fb9f134eae 7d6080bf6f2f0b33aa31ee72ff3a93bb \
    9f9ea84dc1e0ab7a317e8f50f49eafb7
if [ -x /sbin/sysctl ] && [ -r etc/sysctl.d/50-slacky-protect-links.conf ]; then
    /sbin/sysctl -q -p etc/sysctl.d/50-slacky-protect-links.conf >/dev/null 2>&1 || true
fi

mkdir -p /etc/boot/hooks/pre.d /etc/boot/hooks/post.d 2>/dev/null || true
if [ -d /usr/lib64/limine ] && [ ! -d /usr/lib/limine ] && [ ! -L /usr/lib/limine ]; then
    ln -sf /usr/lib64/limine /usr/lib/limine 2>/dev/null || true
fi
if [ -x /usr/bin/limine-enroll-config ] && [ ! -e /etc/boot/hooks/post.d/90-limine-enroll-config ]; then
    ln -sf /usr/bin/limine-enroll-config /etc/boot/hooks/post.d/90-limine-enroll-config 2>/dev/null || true
fi
if [ -x /usr/bin/limine-reset-enroll ] && [ ! -e /etc/boot/hooks/pre.d/10-limine-reset-enroll ]; then
    ln -sf /usr/bin/limine-reset-enroll /etc/boot/hooks/pre.d/10-limine-reset-enroll 2>/dev/null || true
fi

# 6A-319 (LTS S8, replaces 6A-149 lifecycle 7): the cron jobs, profile.d files, tray autostart and kernel hook are .new files
# handled by config_job above, so an admin who switched one off (chmod -x, or edited) keeps it off across upgrades

if [ -x /usr/bin/update-desktop-database ]; then
    /usr/bin/update-desktop-database -q /usr/share/applications >/dev/null 2>&1 || true
fi

if [ -x /usr/bin/gtk-update-icon-cache ]; then
    /usr/bin/gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor >/dev/null 2>&1 || true
fi

# 6A-39: repair group/other-writable dirs left by older builds (assets/udev was 0777)
for d in usr/share/slacky-update usr/local/lib/slacky-update; do
    [ -d "$d" ] && find "$d" ! -type l -perm /022 -exec chmod go-w {} + 2>/dev/null || true
done

# 6A-117: SpiderSense learns the hardware at every boot (background, never delays the boot; read-only probe, writes only
# its own cache). Marked block in rc.local; refused unchanged when rc.local is invalid or ends with "exit".
install -d -m 0755 -o root -g root var/cache/slacky-update/spidersense
RCL=etc/rc.d/rc.local
if [ -f "$RCL" ] && ! grep -q '^# >>> slacky-update:hwprofile >>>$' "$RCL" && [ -z "$(sh -n "$RCL" 2>&1)" ] \
   && ! grep -v '^[[:space:]]*\(#.*\)\{0,1\}$' "$RCL" | tail -n 1 | grep -q '^[[:space:]]*exit\([[:space:]]\|$\)'; then
    T="$(mktemp "$RCL.slacky.XXXXXX")" && cp -p "$RCL" "$T" && {
        [ -n "$(tail -c 1 "$RCL")" ] && printf '\n'
        printf '\n# >>> slacky-update:hwprofile >>>\n'
        printf 'if [ -f /usr/share/slacky-update/lib/spidersense_hw.py ]; then ( /usr/bin/python3 -I /usr/share/slacky-update/lib/spidersense_hw.py boot >/dev/null 2>&1 & ); fi\n'
        printf '# <<< slacky-update:hwprofile <<<\n'
    } >> "$T" && [ -z "$(sh -n "$T" 2>&1)" ] && cp -p "$RCL" "$RCL.slacky-bak" && mv -f "$T" "$RCL" || rm -f "$T"
fi
[ -f /usr/bin/python3 ] && ( /usr/bin/python3 -I usr/share/slacky-update/lib/spidersense_hw.py boot >/dev/null 2>&1 || true )

exit 0
DOINST_EOF
chmod 755 "${PKG_DIR}/install/doinst.sh"

# 6A-117: the boot block goes only when slacky-update itself is removed (during an upgrade the new files exist)
cat << 'DOUNINST_EOF' > "${PKG_DIR}/install/douninst.sh"
#!/bin/sh
RCL=etc/rc.d/rc.local
if [ ! -f usr/share/slacky-update/lib/spidersense_hw.py ] && [ -f "$RCL" ] && grep -q '^# >>> slacky-update:hwprofile >>>$' "$RCL"; then
    T="$(mktemp "$RCL.slacky.XXXXXX")" && cp -p "$RCL" "$T" \
      && awk '$0=="# >>> slacky-update:hwprofile >>>"{s=1;next} s&&$0=="# <<< slacky-update:hwprofile <<<"{s=0;next} !s' "$RCL" > "$T" \
      && [ -z "$(sh -n "$T" 2>&1)" ] && cp -p "$RCL" "$RCL.slacky-bak" && mv -f "$T" "$RCL" || rm -f "$T"
fi
exit 0
DOUNINST_EOF
chmod 755 "${PKG_DIR}/install/douninst.sh"

# --- [ PACKAGE COMPILATION ] ---
cd "${PKG_DIR}"
# 6A-39: never ship group/other-writable files or directories (source assets/udev was 0777, so the installed
# udev rule dir became world-writable and root copied rules from it). Symlinks keep their 0777 link mode.
find "${PKG_DIR}" ! -type l -perm /022 -exec chmod go-w {} +
MAKEPKG_BIN=$(command -v makepkg 2>/dev/null || echo "/sbin/makepkg")
# Built as a normal user: force root:root in the archive (makepkg calls GNU tar, which honours
# TAR_OPTIONS). Without this, installing the package chowns /, /etc, /usr ... to the build user.
XZ_OPT="-T0" TAR_OPTIONS="--owner=0 --group=0 --numeric-owner" "${MAKEPKG_BIN}" -l y -c n "${OUTPUT_DIR}/${PKG_NAME}"

# Ownership gate: refuse to ship any archive entry that is not 0/0 (root:root).
BAD_OWNERS="$(tar --numeric-owner -tvJf "${OUTPUT_DIR}/${PKG_NAME}" | awk '$2 != "0/0"')"
if [ -n "${BAD_OWNERS}" ]; then
    rm -f "${OUTPUT_DIR}/${PKG_NAME}"
    echo "ERROR: ${PKG_NAME} contains entries not owned by root:root; package removed." >&2
    printf '%s\n' "${BAD_OWNERS}" | head -5 >&2 || true
    exit 1
fi
# 6A-39 mode gate: refuse any non-symlink entry that is group- or other-writable.
BAD_MODES="$(tar -tvJf "${OUTPUT_DIR}/${PKG_NAME}" | awk 'substr($1,1,1) != "l" && (substr($1,6,1) == "w" || substr($1,9,1) == "w")')"
if [ -n "${BAD_MODES}" ]; then
    rm -f "${OUTPUT_DIR}/${PKG_NAME}"
    echo "ERROR: ${PKG_NAME} contains group/other-writable entries; package removed." >&2
    printf '%s\n' "${BAD_MODES}" | head -5 >&2 || true
    exit 1
fi
cp -f "${OUTPUT_DIR}/${PKG_NAME}" "${OUTPUT_DIR}/${PRGNAM}.txz" 2>/dev/null || true

rm -rf "${BUILD_DIR}" "${PKG_DIR}"
echo "==> Package build completed: ${OUTPUT_DIR}/${PKG_NAME}"
echo "==> Install or upgrade with: sudo upgradepkg --reinstall ${OUTPUT_DIR}/${PKG_NAME}"
