#!/usr/bin/env bash
# --- [ SLACKY-UPDATE TRAY LAUNCHER ] ---

set -euo pipefail

# 6A-316 (N0d): a wrapped desktop session must not make host tools load foreign libraries
unset LD_LIBRARY_PATH LD_PRELOAD LD_AUDIT LD_BIND_NOW

SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"
TARGET_BIN=""
for cand in "${SCRIPT_DIR}/../lib/slacky-update-tray" \
            "/usr/share/slacky-update/lib/slacky-update-tray" \
            "/usr/local/share/slacky-update/lib/slacky-update-tray" \
            "/usr/local/lib/slacky-update/slacky-update-tray" \
            "/usr/lib64/slacky-update/slacky-update-tray" \
            "/usr/lib/slacky-update/slacky-update-tray"; do
    if [ -f "${cand}" ]; then
        TARGET_BIN="${cand}"
        break
    fi
done
[ -n "${TARGET_BIN}" ] || TARGET_BIN="${SCRIPT_DIR}/../lib/slacky-update-tray"

if [ "${1:-}" = "--restart" ] || [ "${1:-}" = "-r" ]; then
    pkill -f "python3.*slacky-update-tray" 2>/dev/null || true
    sleep 0.5
elif pgrep -f "python3.*slacky-update-tray" >/dev/null 2>&1; then
    exit 0
fi

if [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] || [ "${XDG_CURRENT_DESKTOP:-}" = "Hyprland" ]; then
    export QT_QPA_PLATFORM="${QT_QPA_PLATFORM:-xcb}"
fi

# 6A-315 (F4): the tray's own one-line complaint (for example "needs PyQt6 or PyQt5") goes to the user's tray.log, never to
# a notification; the log is kept small
TRAY_LOG_DIR="${XDG_CACHE_HOME:-${HOME:-/tmp}/.cache}/slacky-update"
mkdir -p "${TRAY_LOG_DIR}" 2>/dev/null || true
TRAY_LOG="${TRAY_LOG_DIR}/tray.log"
if [ -f "${TRAY_LOG}" ] && [ "$(stat -c %s "${TRAY_LOG}" 2>/dev/null || echo 0)" -gt 65536 ]; then
    : > "${TRAY_LOG}" 2>/dev/null || true
fi
python3 "${TARGET_BIN}" </dev/null >/dev/null 2>>"${TRAY_LOG}" &
disown
