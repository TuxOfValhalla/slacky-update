#!/usr/bin/env bash
# --- [ UNDERPANTS GNOMES: UNIVERSAL PACMAN ENGINE & FACTORY ] ---
# Engineered for Slackware Linux (-current / 15.0+)
# Codename: "Tubthumping" (v0.16.0)
#
# Provides standalone, host-sovereign access to Arch Linux and CachyOS
# software ecosystems transmuted into native Slackware .txz packages.

set -euo pipefail

SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"
if [ -d "${SCRIPT_DIR}/../lib" ] && [ -f "${SCRIPT_DIR}/../lib/common.sh" ]; then
    APP_DIR="${SCRIPT_DIR}/../lib"
elif [ -d "/usr/share/slacky-update/lib" ] && [ -f "/usr/share/slacky-update/lib/common.sh" ]; then
    APP_DIR="/usr/share/slacky-update/lib"
elif [ -d "/usr/local/lib/slacky-update" ] && [ -f "/usr/local/lib/slacky-update/common.sh" ]; then
    APP_DIR="/usr/local/lib/slacky-update"
elif [ -d "/usr/lib64/slacky-update" ] && [ -f "/usr/lib64/slacky-update/common.sh" ]; then
    APP_DIR="/usr/lib64/slacky-update"
else
    APP_DIR="${SCRIPT_DIR}/../lib"
fi

# shellcheck source=/dev/null
[ -f "${APP_DIR}/common.sh" ] && source "${APP_DIR}/common.sh"
# shellcheck source=/dev/null
[ -f "${APP_DIR}/mod_gnomes_engine.sh" ] && source "${APP_DIR}/mod_gnomes_engine.sh"

GNOMES_PY=""
if [ -f "${APP_DIR}/gnomes_pacman.py" ]; then
    GNOMES_PY="${APP_DIR}/gnomes_pacman.py"
elif [ -f "${SCRIPT_DIR}/../lib/gnomes_pacman.py" ]; then
    GNOMES_PY="${SCRIPT_DIR}/../lib/gnomes_pacman.py"
elif [ -f "/usr/share/slacky-update/lib/gnomes_pacman.py" ]; then
    GNOMES_PY="/usr/share/slacky-update/lib/gnomes_pacman.py"
elif [ -f "/usr/local/lib/slacky-update/gnomes_pacman.py" ]; then
    GNOMES_PY="/usr/local/lib/slacky-update/gnomes_pacman.py"
fi

BOLD="\033[1m"
RESET="\033[0m"
GREEN="\033[1;32m"
CYAN="\033[1;36m"
YELLOW="\033[1;33m"
RED="\033[1;31m"
MAGENTA="\033[1;35m"
BLUE="\033[1;34m"

print_banner() {
    cat << "EOF"
  _   _           _                                _          ____                                 
 | | | |_ __   __| | ___ _ __ _ __   __ _ _ __  _| |_ ___   / ___|_ __   ___  _ __ ___   ___  ___ 
 | | | | '_ \ / _` |/ _ \ '__| '_ \ / _` | '_ \|_   _/ __| | |  _| '_ \ / _ \| '_ ` _ \ / _ \/ __|
 | |_| | | | | (_| |  __/ |  | |_) | (_| | | | | | | \__ \ | |_| | | | | (_) | | | | | |  __/\__ \
  \___/|_| |_|\__,_|\___|_|  | .__/ \__,_|_| |_| |_| |___/  \____|_| |_|\___/|_| |_| |_|\___||___/
                             |_|                                                                   
  [ 🩲 Phase 1: Collect Underpants  ➔  Phase 2: ?  ➔  Phase 3: Transmute Genuine Slackware .txz! ]
EOF
    echo -e "${MAGENTA}:: Underpants Gnomes Pacman Engine v0.16.0 ('Tubthumping')${RESET}"
    echo -e "${CYAN}:: Multi-Repo Microarchitecture Engine for Slackware Linux (-current / 15.0+)${RESET}\n"
}

print_help() {
    print_banner
    echo -e "${BOLD}USAGE:${RESET}"
    echo -e "  gnomes <operation> [targets...]\n"
    echo -e "${BOLD}OPERATIONS (Pacman Style & Human Friendly):${RESET}"
    echo -e "  ${GREEN}-Ss, search <term>${RESET}          Search 30,000+ packages across CachyOS & Arch repos"
    echo -e "  ${GREEN}-Si, info <package>${RESET}         Display detailed package metadata & download URLs"
    echo -e "  ${GREEN}-Sd, deps <package>${RESET}         Inspect dependency DAG graph & Host Sovereignty Shield"
    echo -e "  ${GREEN}-S,  install <package>${RESET}      Transmute package & dependencies into genuine Slackware .txz"
    echo -e "  ${GREEN}-Sy, sync${RESET}                   Synchronize multi-repo sync databases from mirrors"
    echo -e "  ${GREEN}-Syu, update${RESET}                Sync databases and inspect updates for transmuted packages"
    echo -e "  ${GREEN}-Sc, clean${RESET}                  Remove uninstalled package tarballs from download cache"
    echo -e "  ${GREEN}-Scc, clean --all${RESET}           Purge entire download cache and reclaim disk space"
    echo -e "  ${GREEN}-Sdd, deduplicate${RESET}           Hardlink duplicate library payloads across packages to save space"
    echo -e "  ${GREEN}-Q,  list${RESET}                   List all installed Underpants Gnomes packages"
    echo -e "  ${GREEN}-R,  remove <package>${RESET}       Remove installed Underpants package via removepkg"
    echo -e "  ${GREEN}runtime [status|profiles|install]${RESET} Manage shared runtime profiles (/opt/underpants/runtime/)"
    echo -e "  ${GREEN}--check-host${RESET}                Audit CPU tier, glibc ABI limits, and host library cache"
    echo -e "  ${GREEN}-h,  --help${RESET}                 Show this bodacious help message\n"
    echo -e "${BOLD}EXAMPLES:${RESET}"
    echo -e "  gnomes search mangohud"
    echo -e "  gnomes info goverlay"
    echo -e "  gnomes deps kicad"
    echo -e "  gnomes install fastfetch"
    echo -e "  gnomes runtime status"
    echo -e "  gnomes runtime install hyprland"
    echo -e "  gnomes deduplicate"
    echo -e "  gnomes clean --all"
    echo -e "  gnomes list\n"
}

cleanup_stale_wrappers() {
    # Core host sovereignty self-healing: ensure python/python3/pip are never hijacked
    for host_bin in python python3 python3-config python2 pip pip3 idle idle3 pydoc pydoc3; do
        if [ -f "/usr/bin/${host_bin}" ] && grep -q "# --- [ Underpants Gnomes Launcher Wrapper for" "/usr/bin/${host_bin}" 2>/dev/null; then
            if [ "$(id -u)" -eq 0 ]; then
                rm -f "/usr/bin/${host_bin}"
            else
                sudo rm -f "/usr/bin/${host_bin}" 2>/dev/null || true
            fi
        fi
    done
    if [ ! -e "/usr/bin/python3" ] && [ -x "/usr/bin/python3.12" ]; then
        if [ "$(id -u)" -eq 0 ]; then
            ln -sf python3.12 /usr/bin/python3
        else
            sudo ln -sf python3.12 /usr/bin/python3 2>/dev/null || true
        fi
    fi
    if [ ! -e "/usr/bin/python" ] && [ -e "/usr/bin/python3" ]; then
        if [ "$(id -u)" -eq 0 ]; then
            ln -sf python3 /usr/bin/python
        else
            sudo ln -sf python3 /usr/bin/python 2>/dev/null || true
        fi
    fi
    if [ ! -e "/usr/bin/python3-config" ] && [ -x "/usr/bin/python3.12-config" ]; then
        if [ "$(id -u)" -eq 0 ]; then
            ln -sf python3.12-config /usr/bin/python3-config
        else
            sudo ln -sf python3.12-config /usr/bin/python3-config 2>/dev/null || true
        fi
    fi

    for f in /usr/bin/*; do
        if [ -f "${f}" ] && grep -q "# --- [ Underpants Gnomes Launcher Wrapper for" "${f}" 2>/dev/null; then
            app_name=$(grep '^APP_NAME=' "${f}" 2>/dev/null | cut -d'"' -f2 || true)
            bname=$(basename "${f}")
            if [ -n "${app_name}" ]; then
                if ! ls /var/log/packages/underpants-"${app_name}"-* >/dev/null 2>&1 && ! ls /var/log/packages/cachyos-gnome-"${app_name}"-* >/dev/null 2>&1; then
                    if [ "$(id -u)" -eq 0 ]; then
                        rm -f "${f}"
                    else
                        sudo rm -f "${f}" 2>/dev/null || true
                    fi
                fi
            fi
        fi
    done

    # Clean up stale Underpants Gnomes init scripts & rc.local hooks if package removed
    for rc in /etc/rc.d/rc.*; do
        if [ -f "${rc}" ] && grep -q "Transmuted for Slackware by Underpants Gnomes" "${rc}" 2>/dev/null; then
            svc_name=$(basename "${rc}" | sed -e 's/^rc\.//')
            pkg_name=$(grep '^# PKG_NAME:' "${rc}" 2>/dev/null | awk '{print $NF}' || true)
            [ -z "${pkg_name}" ] && pkg_name="${svc_name}"

            if [ -n "${svc_name}" ]; then
                # Check if parent package is still installed
                if ! ls /var/log/packages/underpants-"${pkg_name}"-* >/dev/null 2>&1 && ! grep -q "etc/rc\.d/rc\.${svc_name}\$" /var/log/packages/underpants-* 2>/dev/null; then
                    if [ "$(id -u)" -eq 0 ]; then
                        "${rc}" stop 2>/dev/null || true
                        rm -f "${rc}"
                        python3 "${GNOMES_PY}" purge-service "${svc_name}" 2>/dev/null || true
                    else
                        sudo "${rc}" stop 2>/dev/null || true
                        sudo rm -f "${rc}" 2>/dev/null || true
                        sudo python3 "${GNOMES_PY}" purge-service "${svc_name}" 2>/dev/null || true
                    fi
                fi
            fi
        fi
    done
}

if [ $# -eq 0 ]; then
    print_help
    exit 0
fi

OP="$1"
shift || true

case "${OP}" in
    -Ss|search|--search)
        if [ $# -eq 0 ]; then
            echo -e "${RED}Major Bummer! Specify a search query (e.g. 'gnomes -Ss mangohud').${RESET}"
            exit 1
        fi
        python3 "${GNOMES_PY}" search "$@"
        ;;
    -Si|info|--info)
        if [ $# -eq 0 ]; then
            echo -e "${RED}Major Bummer! Specify a package name (e.g. 'gnomes -Si goverlay').${RESET}"
            exit 1
        fi
        python3 "${GNOMES_PY}" info "$@"
        ;;
    -Sd|deps|--deps)
        if [ $# -eq 0 ]; then
            echo -e "${RED}Major Bummer! Specify a package name to inspect dependencies.${RESET}"
            exit 1
        fi
        python3 "${GNOMES_PY}" deps "$@"
        ;;
    -S|install|transmute|--install|--transmute)
        if [ $# -eq 0 ]; then
            echo -e "${RED}Major Bummer! Specify package name(s) to transmute (e.g. 'gnomes -S mangohud goverlay').${RESET}"
            exit 1
        fi
        TARGETS=()
        EXTRA_ARGS=()
        build_only=0
        for arg in "$@"; do
            if [ "${arg}" = "--build-only" ] || [ "${arg}" = "--no-install" ]; then
                build_only=1
                EXTRA_ARGS+=("${arg}")
            elif [[ "${arg}" =~ ^- ]]; then
                EXTRA_ARGS+=("${arg}")
            else
                TARGETS+=("${arg}")
            fi
        done

        if [ ${#TARGETS[@]} -eq 0 ]; then
            echo -e "${RED}Major Bummer! No target packages specified for transmutation.${RESET}"
            exit 1
        fi

        TARGET_STR=$(IFS=', '; echo "${TARGETS[*]}")
        echo -e "${BOLD}${CYAN}:: Transmuting [${TARGET_STR}] in Underpants Gnomes Factory...${RESET}"
        if python3 "${GNOMES_PY}" transmute "${TARGETS[@]}" "${EXTRA_ARGS[@]}"; then
            for TARGET in "${TARGETS[@]}"; do
                TXZ_PATH=$(ls -1t /tmp/underpants-"${TARGET}"-*.txz 2>/dev/null | head -n1 || true)
                if [ -n "${TXZ_PATH}" ] && [ -f "${TXZ_PATH}" ]; then
                    PKG_NAME_BASE=$(basename "${TXZ_PATH}")
                    if [ "${build_only}" -eq 0 ]; then
                        echo -e "\n${BOLD}${CYAN}:: Deploying ${PKG_NAME_BASE} to Slackware host via upgradepkg (requires sudo)...${RESET}"
                        sudo upgradepkg --install-new --reinstall "${TXZ_PATH}"
                        cleanup_stale_wrappers
                        RUN_BINS=()
                        if [ -f "/var/log/packages/${PKG_NAME_BASE%.txz}" ]; then
                            while IFS= read -r line; do
                                if [[ "${line}" =~ ^usr/bin/([^/]+)$ ]]; then
                                    RUN_BINS+=("${BASH_REMATCH[1]}")
                                fi
                            done < "/var/log/packages/${PKG_NAME_BASE%.txz}"
                        fi
                        if [ ${#RUN_BINS[@]} -gt 0 ]; then
                            RUN_STR=$(IFS=', '; echo "${RUN_BINS[*]}")
                            echo -e "\n${BOLD}${GREEN}🎉 Bodacious! ${TARGET} is now installed and ready to run via: ${CYAN}${RUN_STR}${RESET}\n"
                        else
                            echo -e "\n${BOLD}${GREEN}🎉 Bodacious! ${TARGET} is now installed and ready to run directly from /usr/bin/${TARGET}${RESET}\n"
                        fi
                    else
                        echo -e "\n${BOLD}${GREEN}✓ Transmutation complete. Package ready at: ${TXZ_PATH}${RESET}\n"
                    fi
                fi
            done
        fi
        ;;
    -Sy|sync|--sync)
        echo -e "${BOLD}${CYAN}:: Synchronizing Underpants Gnomes Repositories...${RESET}"
        python3 "${GNOMES_PY}" sync "$@"
        ;;
    -Syu|update|--update)
        echo -e "${BOLD}${CYAN}:: Synchronizing Underpants Gnomes Repositories & Checking Updates...${RESET}"
        python3 "${GNOMES_PY}" sync
        echo -e "\n${BOLD}${GREEN}:: Checking installed Underpants Gnomes packages...${RESET}"
        python3 "${GNOMES_PY}" list-updates
        ;;
    -Sc|clean|--clean)
        python3 "${GNOMES_PY}" clean "$@"
        cleanup_stale_wrappers
        ;;
    -Scc|clean-all|--clean-all)
        python3 "${GNOMES_PY}" clean --all "$@"
        cleanup_stale_wrappers
        ;;
    -Q|-Qs|list|--list)
        python3 "${GNOMES_PY}" list-installed "$@"
        ;;
    -R|remove|uninstall|--remove)
        if [ $# -eq 0 ]; then
            echo -e "${RED}Major Bummer! Specify package name(s) to remove (e.g. 'gnomes -R openscad zathura').${RESET}"
            exit 1
        fi
        auto_yes=0
        TARGETS=()
        for arg in "$@"; do
            if [ "${arg}" = "-y" ] || [ "${arg}" = "--yes" ] || [ "${arg}" = "--noconfirm" ]; then
                auto_yes=1
            else
                TARGETS+=("${arg}")
            fi
        done

        if [ ${#TARGETS[@]} -eq 0 ]; then
            echo -e "${RED}Major Bummer! No target packages specified for removal.${RESET}"
            exit 1
        fi

        FOUND_PAIRS=()
        for TARGET in "${TARGETS[@]}"; do
            CLEAN_TARGET=$(echo "${TARGET}" | sed -e 's/^underpants-//')
            FOUND_PKG=$(ls -1 /var/log/packages/underpants-"${CLEAN_TARGET}"-* 2>/dev/null | head -n1 || true)
            if [ -n "${FOUND_PKG}" ]; then
                PKG_ID=$(basename "${FOUND_PKG}")
                FOUND_PAIRS+=("${CLEAN_TARGET}:::${PKG_ID}")
            else
                NATIVE_PKG=$(ls -1 /var/log/packages/"${CLEAN_TARGET}"-* 2>/dev/null | head -n1 || true)
                if [ -n "${NATIVE_PKG}" ]; then
                    NATIVE_ID=$(basename "${NATIVE_PKG}")
                    echo -e "${YELLOW}:: Notice: '${CLEAN_TARGET}' is a genuine native Slackware package (${NATIVE_ID}).${RESET}"
                    echo -e "${YELLOW}:: Underpants Gnomes only removes 'underpants-*' packages to preserve host integrity.${RESET}"
                    echo -e "   To remove native packages, use: ${BOLD}${RED}sudo removepkg ${NATIVE_ID}${RESET}\n"
                else
                    echo -e "${RED}Major Bummer: Package 'underpants-${CLEAN_TARGET}' is not installed in /var/log/packages/.${RESET}"
                fi
            fi
        done

        if [ ${#FOUND_PAIRS[@]} -eq 0 ]; then
            exit 1
        fi

        echo -e "\n${BOLD}${CYAN}:: Package(s) to be removed (${#FOUND_PAIRS[@]}):${RESET}"
        pkg_names=()
        for pair in "${FOUND_PAIRS[@]}"; do
            pkg_names+=("${pair#*:::}")
        done
        echo -e "   \033[1m${pkg_names[*]}\033[0m\n"

        do_remove=0
        if [ "${auto_yes}" -eq 1 ]; then
            do_remove=1
        elif [ -t 0 ]; then
            if [ ${#FOUND_PAIRS[@]} -eq 1 ]; then
                read -r -p ":: Remove this package from your Slackware system? [Y/n] " reply_rm || reply_rm="Y"
            else
                read -r -p ":: Remove all ${#FOUND_PAIRS[@]} packages from your Slackware system? [Y/n] " reply_rm || reply_rm="Y"
            fi
            reply_rm=${reply_rm:-Y}
            if [[ "$reply_rm" =~ ^[YyJjSsOo]$ ]]; then
                do_remove=1
            fi
        else
            do_remove=1
        fi

        if [ "${do_remove}" -eq 1 ]; then
            for pair in "${FOUND_PAIRS[@]}"; do
                c_target="${pair%%:::*}"
                p_id="${pair#*:::}"

                # Pre-removal: Detect and cleanly stop any associated background services
                PKG_SERVICES=()
                if [ -f "/var/log/packages/${p_id}" ]; then
                    while IFS= read -r line; do
                        if [[ "${line}" =~ ^etc/rc\.d/rc\.(.+)$ ]]; then
                            PKG_SERVICES+=("${BASH_REMATCH[1]}")
                        fi
                    done < "/var/log/packages/${p_id}"
                fi
                if [ -f "/etc/rc.d/rc.${c_target}" ]; then
                    PKG_SERVICES+=("${c_target}")
                fi

                for svc in "${PKG_SERVICES[@]}"; do
                    if [ -n "${svc}" ]; then
                        echo -e "${CYAN}:: Stopping and purging background service '${svc}'...${RESET}"
                        if [ -x "/etc/rc.d/rc.${svc}" ]; then
                            if [ "$(id -u)" -eq 0 ]; then
                                "/etc/rc.d/rc.${svc}" stop 2>/dev/null || true
                            else
                                sudo "/etc/rc.d/rc.${svc}" stop 2>/dev/null || true
                            fi
                        fi
                        if [ "$(id -u)" -eq 0 ]; then
                            python3 "${GNOMES_PY}" purge-service "${svc}" 2>/dev/null || true
                        else
                            sudo python3 "${GNOMES_PY}" purge-service "${svc}" 2>/dev/null || true
                        fi
                    fi
                done

                echo -e "\n${BOLD}${CYAN}:: Removing ${p_id} with removepkg...${RESET}"
                if [ "$(id -u)" -eq 0 ]; then
                    removepkg "${p_id}"
                else
                    sudo removepkg "${p_id}"
                fi

                # Cleanup leftover rc scripts if removepkg didn't remove them
                for svc in "${PKG_SERVICES[@]}"; do
                    if [ -f "/etc/rc.d/rc.${svc}" ]; then
                        if [ "$(id -u)" -eq 0 ]; then
                            rm -f "/etc/rc.d/rc.${svc}"
                        else
                            sudo rm -f "/etc/rc.d/rc.${svc}" 2>/dev/null || true
                        fi
                    fi
                done

                # Tidy up empty /opt/underpants/pkgs/${c_target} directory if left behind
                if [ -d "/opt/underpants/pkgs/${c_target}" ]; then
                    if [ "$(id -u)" -eq 0 ]; then
                        rmdir "/opt/underpants/pkgs/${c_target}" 2>/dev/null || rm -rf "/opt/underpants/pkgs/${c_target}" 2>/dev/null || true
                    else
                        sudo rm -rf "/opt/underpants/pkgs/${c_target}" 2>/dev/null || true
                    fi
                fi
            done
            cleanup_stale_wrappers
            echo -e "\n${BOLD}${GREEN}🎉 Excellent! All requested packages have been safely removed from your Slackware system.${RESET}\n"
        else
            echo -e "\n${YELLOW}:: Removal cancelled by user.${RESET}\n"
        fi
        ;;
    --check-host|check-host|audit)
        python3 "${GNOMES_PY}" check-host "$@"
        ;;
    -Sdd|deduplicate|dedup|--deduplicate)
        python3 "${GNOMES_PY}" deduplicate "$@"
        ;;
    runtime|--runtime|-Rnt)
        sub="${1:-status}"
        shift || true
        if [ "${sub}" = "status" ] || [ "${sub}" = "info" ]; then
            python3 "${GNOMES_PY}" runtime status "$@"
        elif [ "${sub}" = "profiles" ] || [ "${sub}" = "list" ] || [ "${sub}" = "list-profiles" ]; then
            python3 "${GNOMES_PY}" runtime profiles "$@"
        elif [ "${sub}" = "install" ] || [ "${sub}" = "setup" ]; then
            prof="${1:-core}"
            shift || true
            echo -e "${BOLD}${CYAN}:: Transmuting Underpants Shared Runtime Pool [${prof}]...${RESET}"
            if python3 "${GNOMES_PY}" runtime install "${prof}" "$@"; then
                TXZ_PATH=$(ls -1t /tmp/underpants-runtime-"${prof}"-*.txz 2>/dev/null | head -n1 || true)
                if [ -z "${TXZ_PATH}" ]; then
                    TXZ_PATH=$(ls -1t /tmp/underpants-runtime-*.txz 2>/dev/null | head -n1 || true)
                fi
                if [ -n "${TXZ_PATH}" ] && [ -f "${TXZ_PATH}" ]; then
                    PKG_NAME_BASE=$(basename "${TXZ_PATH}")
                    auto_yes=0
                    for arg in "$@"; do
                        if [ "${arg}" = "-y" ] || [ "${arg}" = "--yes" ] || [ "${arg}" = "--noconfirm" ]; then
                            auto_yes=1
                            break
                        fi
                    done
                    do_install=0
                    if [ "${auto_yes}" -eq 1 ]; then
                        do_install=1
                    elif [ -t 0 ]; then
                        echo ""
                        read -r -p ":: Deploy ${PKG_NAME_BASE} to /opt/underpants/runtime/ now? [Y/n] " reply_inst || reply_inst="Y"
                        reply_inst=${reply_inst:-Y}
                        if [[ "$reply_inst" =~ ^[YyJjSsOo]$ ]]; then
                            do_install=1
                        fi
                    fi
                    if [ "${do_install}" -eq 1 ]; then
                        echo -e "\n${BOLD}${CYAN}:: Deploying ${PKG_NAME_BASE} to Slackware host via upgradepkg (requires sudo)...${RESET}"
                        sudo upgradepkg --install-new --reinstall "${TXZ_PATH}"
                        echo -e "\n${BOLD}${GREEN}🎉 Bodacious! Underpants Shared Runtime [${prof}] is now active in /opt/underpants/runtime/${RESET}\n"
                    fi
                fi
            fi
        elif [ "${sub}" = "clean" ] || [ "${sub}" = "remove" ]; then
            prof="${1:-}"
            if [ -n "${prof}" ]; then
                FOUND_PKGS=$(ls -1 /var/log/packages/underpants-runtime-"${prof}"-* 2>/dev/null || true)
            else
                FOUND_PKGS=$(ls -1 /var/log/packages/underpants-runtime-* 2>/dev/null || true)
            fi
            if [ -n "${FOUND_PKGS}" ]; then
                for pfile in ${FOUND_PKGS}; do
                    PKG_ID=$(basename "${pfile}")
                    echo -e "\n${BOLD}${CYAN}:: Removing ${PKG_ID} with removepkg...${RESET}"
                    if [ "$(id -u)" -eq 0 ]; then
                        removepkg "${PKG_ID}"
                    else
                        sudo removepkg "${PKG_ID}"
                    fi
                    echo -e "${BOLD}${GREEN}✓ Removed ${PKG_ID}.${RESET}"
                done
                echo -e "\n${BOLD}${GREEN}🎉 Underpants Runtime packages removed.${RESET}\n"
            else
                echo -e "${YELLOW}:: No Underpants Runtime packages are installed.${RESET}"
            fi
        else
            echo -e "${RED}Unknown runtime subcommand: ${sub}. Use 'status', 'profiles', 'install [profile]', or 'clean'.${RESET}"
            exit 1
        fi
        ;;
    -h|--help|help)
        print_help
        ;;
    *)
        echo -e "${RED}Major Bummer: Unknown operation '${OP}'${RESET}\n"
        print_help
        exit 1
        ;;
esac
