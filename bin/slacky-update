#!/usr/bin/env bash
# --- [ SLACKY-UPDATE CLI INTERFACE & MAIN CONTROLLER ] ---

set -euo pipefail

CURRENT_VERSION="0.15.0"
RELEASE_CODENAME="Now This Is Podracing!"

SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"
if [ -d "${SCRIPT_DIR}/../lib" ] && [ -f "${SCRIPT_DIR}/../lib/common.sh" ]; then
    APP_DIR="${SCRIPT_DIR}/../lib"
elif [ -d "/usr/share/slacky-update/lib" ] && [ -f "/usr/share/slacky-update/lib/common.sh" ]; then
    APP_DIR="/usr/share/slacky-update/lib"
elif [ -d "/usr/local/lib/slacky-update" ] && [ -f "/usr/local/lib/slacky-update/common.sh" ]; then
    APP_DIR="/usr/local/lib/slacky-update"
elif [ -d "/usr/lib64/slacky-update" ] && [ -f "/usr/lib64/slacky-update/common.sh" ]; then
    APP_DIR="/usr/lib64/slacky-update"
elif [ -d "/usr/lib/slacky-update" ] && [ -f "/usr/lib/slacky-update/common.sh" ]; then
    APP_DIR="/usr/lib/slacky-update"
else
    APP_DIR="${SCRIPT_DIR}/../lib"
fi

# shellcheck source=/dev/null
source "${APP_DIR}/common.sh"
# shellcheck source=/dev/null
source "${APP_DIR}/mod_nvidia.sh"
# shellcheck source=/dev/null
source "${APP_DIR}/mod_packages.sh"
# shellcheck source=/dev/null
source "${APP_DIR}/mod_sbo.sh"
# shellcheck source=/dev/null
source "${APP_DIR}/mod_kernel.sh"
# shellcheck source=/dev/null
source "${APP_DIR}/mod_armor.sh"
# shellcheck source=/dev/null
[ -f "${APP_DIR}/mod_limine.sh" ] && source "${APP_DIR}/mod_limine.sh"
# shellcheck source=/dev/null
[ -f "${APP_DIR}/mod_secureboot.sh" ] && source "${APP_DIR}/mod_secureboot.sh"
# shellcheck source=/dev/null
source "${APP_DIR}/mod_clean.sh"
# shellcheck source=/dev/null
[ -f "${APP_DIR}/mod_rocm.sh" ] && source "${APP_DIR}/mod_rocm.sh"
# shellcheck source=/dev/null
[ -f "${APP_DIR}/mod_tweaks.sh" ] && source "${APP_DIR}/mod_tweaks.sh"
# shellcheck source=/dev/null
[ -f "${APP_DIR}/mod_gaming.sh" ] && source "${APP_DIR}/mod_gaming.sh"
# shellcheck source=/dev/null
[ -f "${APP_DIR}/mod_gnomes_engine.sh" ] && source "${APP_DIR}/mod_gnomes_engine.sh"
# shellcheck source=/dev/null
[ -f "${APP_DIR}/mod_docs.sh" ] && source "${APP_DIR}/mod_docs.sh"

if [ -f "${SCRIPT_DIR}/../lib/slacky_update_i18n.py" ]; then
    I18N_PY="${SCRIPT_DIR}/../lib/slacky_update_i18n.py"
elif [ -f "/usr/share/slacky-update/lib/slacky_update_i18n.py" ]; then
    I18N_PY="/usr/share/slacky-update/lib/slacky_update_i18n.py"
else
    I18N_PY="${SCRIPT_DIR}/../lib/slacky_update_i18n.py"
fi

if [ -f "${SCRIPT_DIR}/../lib/check_backend.sh" ]; then
    CHECK_BIN="${SCRIPT_DIR}/../lib/check_backend.sh"
elif [ -f "/usr/share/slacky-update/lib/check_backend.sh" ]; then
    CHECK_BIN="/usr/share/slacky-update/lib/check_backend.sh"
else
    CHECK_BIN="${SCRIPT_DIR}/../lib/check_backend.sh"
fi

_() {
    python3 "$I18N_PY" "$@"
}

set_terminal_title "slacky-update v${CURRENT_VERSION}"

INTERACTIVE_SESSION=0

cleanup_on_exit() {
    local exit_code=$?
    if [ "${INTERACTIVE_SESSION}" -eq 1 ] && [ -t 0 ] && [ "${exit_code}" -ne 0 ]; then
        echo ""
        read -r -p "$(_ PRESS_ENTER_EXIT)" || true
    fi
}
trap cleanup_on_exit EXIT

# --- [ STATUS SUMMARY DISPLAY ] ---
display_pending_status() {
    python3 - "${SCRIPT_DIR}/../lib" << 'PYSTATUS'
import json, sys, os, shutil
sys.path.insert(0, "/usr/share/slacky-update/lib")
if len(sys.argv) > 1 and os.path.exists(sys.argv[1]):
    sys.path.insert(0, os.path.abspath(sys.argv[1]))
try:
    from slacky_update_i18n import _
except ImportError:
    def _(k, **kw): return k

candidates = ["/var/cache/slacky-update/status.json", os.path.expanduser("~/.cache/slacky-update/status.json")]
sudo_u = os.environ.get("SUDO_USER")
if sudo_u:
    try:
        candidates.append(os.path.expanduser(f"~{sudo_u}/.cache/slacky-update/status.json"))
    except Exception:
        pass

data = None
best_ts = -1
for c in candidates:
    if os.path.exists(c):
        try:
            with open(c, "r", encoding="utf-8") as f:
                cand_data = json.load(f)
                ts = float(cand_data.get("last_check_ts", os.path.getmtime(c)))
                if ts > best_ts:
                    best_ts = ts
                    data = cand_data
        except Exception:
            pass

if data is None:
    sys.exit(0)

hdr = _("CLI_UPDATES_HEADER")
print(f"\033[1;36m{hdr}\033[0m")

def print_cat(title, items):
    if not items:
        return
    count_str = f" ({len(items)})" if len(items) > 1 else ""
    print(f"\033[1;33m{title}{count_str}:\033[0m")
    term_width = shutil.get_terminal_size((80, 24)).columns
    if len(items) > 10:
        max_item_len = max(len(it) for it in items)
        col_width = max_item_len + 5
        num_cols = max(1, min(3, term_width // col_width))
        if num_cols >= 2:
            num_rows = (len(items) + num_cols - 1) // num_cols
            for r in range(num_rows):
                row_parts = []
                for c in range(num_cols):
                    idx = c * num_rows + r
                    if idx < len(items):
                        item = items[idx]
                        entry = f"  \033[32m•\033[0m {item}"
                        pad = " " * (col_width - (len(item) + 4))
                        row_parts.append(f"{entry}{pad}")
                print("".join(row_parts).rstrip())
            return
    for item in items:
        print(f"  \033[32m•\033[0m {item}")

print_cat(_("CAT_SLACKWARE"), data.get("slackware_updates", []))
print_cat(_("CAT_SLACKPKGPLUS"), data.get("slackpkgplus_updates", []))
print_cat(_("CAT_FLATPAK"), data.get("flatpak_updates", []))
print_cat(_("CAT_SBO"), data.get("sbo_updates", []))
print_cat(_("CAT_KERNEL"), data.get("cachyos_kernel_updates", []))
print_cat(_("CAT_GAMING"), data.get("cachyos_gaming_updates", []))
print_cat(_("CAT_NVIDIA"), data.get("nvidia_driver_updates", []))

if data.get("nvidia_gl_mismatch", False):
    print("\033[1;31m• " + _("NVIDIA_SYNC_FAIL") + "\033[0m")

sb = data.get("secure_boot", {})
if sb.get("state") == "enabled":
    for w in sb.get("warnings", []):
        print(f"\033[1;31m• Secure Boot Warning: {w}\033[0m")

total = len(data.get("slackware_updates", [])) + len(data.get("slackpkgplus_updates", [])) + len(data.get("flatpak_updates", [])) + len(data.get("sbo_updates", [])) + len(data.get("cachyos_kernel_updates", [])) + len(data.get("cachyos_gaming_updates", [])) + len(data.get("nvidia_driver_updates", []))
if total == 0 and not data.get("nvidia_gl_mismatch", False):
    print("\033[1;32m" + _("NO_PENDING_UPDATES") + "\033[0m")
print("")
PYSTATUS
}

# --- [ FULL SYSTEM UPDATE TRANSACTION ] ---
get_full_pkg_snapshot_file() {
    local target_file="$1"
    ls /var/log/packages 2>/dev/null | sort > "${target_file}" || true
}

get_kernel_driver_snapshot() {
    python3 -c "
import os
pkgs = os.listdir('/var/log/packages') if os.path.exists('/var/log/packages') else []
k_pkgs = sorted([p for p in pkgs if p.startswith(('kernel-', 'linux-', 'dkms', 'nvidia'))])
print(';'.join(k_pkgs))
" 2>/dev/null || echo ""
}

prompt_reboot_or_close() {
    local snap_before_file="$1"
    local snap_after_file="$2"
    local force_flag="${3:-0}"

    local needs_reboot=0
    if [ "${force_flag}" -eq 1 ]; then
        needs_reboot=1
    fi

    if [ "${needs_reboot}" -eq 0 ] && [ -f "${snap_before_file}" ] && [ -f "${snap_after_file}" ]; then
        if python3 -c "
import sys, os
b_file = sys.argv[1]
a_file = sys.argv[2]

with open(b_file, 'r', encoding='utf-8', errors='ignore') as f:
    b = set(line.strip() for line in f if line.strip())
with open(a_file, 'r', encoding='utf-8', errors='ignore') as f:
    a = set(line.strip() for line in f if line.strip())

diff = a - b
for p in diff:
    if p.startswith('glibc-zoneinfo'):
        continue
    if p.startswith(('glibc-solibs', 'glibc-2', 'glibc-3')) or any(kw in p for kw in ['plasma-', 'kwin-', 'sddm-', 'wayland-', 'nvidia-', 'kernel-', 'linux-cachyos']):
        sys.exit(1)
sys.exit(0)
" "${snap_before_file}" "${snap_after_file}" 2>/dev/null; then
            needs_reboot=0
        else
            needs_reboot=1
        fi
    fi
    rm -f "${snap_before_file}" "${snap_after_file}" 2>/dev/null || true

    if [ "${NON_INTERACTIVE:-0}" = "1" ] || [ ! -t 0 ]; then
        if [ "${needs_reboot}" -eq 1 ]; then
            echo ""
            echo -e "${YELLOW}${BOLD}🔄 $(_ REBOOT_RECOMMENDED_TITLE)${RESET}"
            echo -e "$(_ REBOOT_RECOMMENDED_DESC)"
            log_info "Non-interactive mode: Reboot deferred. Please reboot when convenient."
        else
            echo ""
            echo -e "${GREEN}${BOLD}$(_ ALL_DONE_CLOSE_PROMPT)${RESET}"
        fi
        exit 0
    fi

    if [ "${needs_reboot}" -eq 1 ]; then
        echo ""
        echo -e "${YELLOW}${BOLD}🔄 $(_ REBOOT_RECOMMENDED_TITLE)${RESET}"
        echo -e "$(_ REBOOT_RECOMMENDED_DESC)"
        echo ""
        read -r -p "$(_ PROMPT_REBOOT_NOW)" reply_reboot || reply_reboot="N"
        reply_reboot=${reply_reboot:-Y}
        if [[ "$reply_reboot" =~ ^[YyJjSsOo]$ ]]; then
            echo ""
            echo -e "${CYAN}${BOLD}$(_ REBOOTING_IN_5S)${RESET}"
            for i in 5 4 3 2 1; do
                echo -n -e "${YELLOW}${BOLD}${i}... ${RESET}"
                sleep 1
            done
            echo ""
            log_info "Initiating system reboot..."
            sudo "${REBOOT_CMD}"
            exit 0
        fi
    else
        echo ""
        echo -e "${GREEN}${BOLD}$(_ ALL_DONE_CLOSE_PROMPT)${RESET}"
        read -r -p "$(_ PRESS_ENTER_TO_CLOSE)" || true
    fi
    exit 0
}

run_full_update() {
    echo -e "\n${CYAN}$(_ VALIDATING_ADMIN)${RESET}"
    validate_privileges

    export DEFER_BOOT_SYNC=1
    export SLACKY_UPDATE_RUNNING=1
    touch /tmp/slacky-update-running.lock 2>/dev/null || true

    local snap_before_file snap_after_file
    snap_before_file=$(mktemp /tmp/slacky-snap-before.XXXXXX)
    snap_after_file=$(mktemp /tmp/slacky-snap-after.XXXXXX)
    get_full_pkg_snapshot_file "${snap_before_file}"

    local k_snap_before k_snap_after
    k_snap_before=$(get_kernel_driver_snapshot)

    local boot_snap_before boot_snap_after
    boot_snap_before=$(ls -1 /boot/vmlinuz* /var/log/packages/*limine* /var/log/packages/*sbctl* /var/log/packages/*grub* /var/log/packages/*elilo* 2>/dev/null || true)
    local kernel_or_driver_changed=0

    local is_headless=0
    if [ "${NON_INTERACTIVE:-0}" = "1" ] || [ ! -t 0 ]; then
        is_headless=1
    fi

    local slack_count plus_count total_slack_pkgs
    slack_count=$(get_status_key_count "slackware_updates")
    plus_count=$(get_status_key_count "slackpkgplus_updates")
    total_slack_pkgs=$(( slack_count + plus_count ))

    if [ "${total_slack_pkgs}" -gt 0 ]; then
        local reply_slack="Y"
        if [ "${is_headless}" -eq 0 ]; then
            read -r -p "$(_ PROMPT_UPGRADE_SLACKWARE)" reply_slack || reply_slack="Y"
            reply_slack=${reply_slack:-Y}
        fi
        if [[ "$reply_slack" =~ ^[YyJjSsOo]$ ]]; then
            echo -e "\n${BLUE}${BOLD}$(_ UPGRADING_SLACKWARE)${RESET}"
            update_slackware_core
        fi
    else
        log_info "$(_ SLACKWARE_CORE_UP_TO_DATE)"
    fi

    local cachy_count
    cachy_count=$(get_status_key_count "cachyos_kernel_updates")
    if [ "${cachy_count}" -gt 0 ]; then
        local reply_cachy="Y"
        if [ "${is_headless}" -eq 0 ]; then
            read -r -p "$(_ PROMPT_INSTALL_CACHY_KERNEL)" reply_cachy || reply_cachy="Y"
            reply_cachy=${reply_cachy:-Y}
        fi
        if [[ "$reply_cachy" =~ ^[YyJjSsOo]$ ]]; then
            echo -e "\n${BLUE}${BOLD}$(_ UPGRADING_CACHYOS_KERNEL)${RESET}"
            update_cachyos_kernels
            kernel_or_driver_changed=1
        fi
    fi

    if command -v flatpak >/dev/null 2>&1; then
        local flatpak_count
        flatpak_count=$(get_status_key_count "flatpak_updates")
        local nvidia_mismatch="false"
        if [ -f "/var/cache/slacky-update/status.json" ]; then
            nvidia_mismatch=$(python3 -c "
import json
try:
    with open('/var/cache/slacky-update/status.json') as f:
        print('true' if json.load(f).get('nvidia_gl_mismatch', False) else 'false')
except Exception:
    print('false')
" 2>/dev/null || echo "false")
        fi

        if [ "${flatpak_count}" -gt 0 ] || [ "${nvidia_mismatch}" = "true" ]; then
            local reply_flatpak="Y"
            if [ "${is_headless}" -eq 0 ]; then
                read -r -p "$(_ PROMPT_UPGRADE_FLATPAK)" reply_flatpak || reply_flatpak="Y"
                reply_flatpak=${reply_flatpak:-Y}
            fi
            if [[ "$reply_flatpak" =~ ^[YyJjSsOo]$ ]]; then
                echo -e "\n${BLUE}${BOLD}$(_ UPGRADING_FLATPAK)${RESET}"
                update_flatpaks
                if [ "${nvidia_mismatch}" = "true" ]; then
                    local act_nv
                    act_nv=$(cat /sys/module/nvidia/version 2>/dev/null || head -n 1 /proc/driver/nvidia/version 2>/dev/null | awk '{print $8}' || true)
                    register_flatpak_gl_sync "${act_nv}"
                fi
            fi
        fi
    fi

    if is_sbotools_installed; then
        local sbo_count
        sbo_count=$(get_status_key_count "sbo_updates")
        if [ "${sbo_count}" -gt 0 ]; then
            local reply_sbo="Y"
            if [ "${is_headless}" -eq 0 ]; then
                read -r -p "$(_ PROMPT_UPGRADE_SBO)" reply_sbo || reply_sbo="Y"
                reply_sbo=${reply_sbo:-Y}
            fi
            if [[ "$reply_sbo" =~ ^[YyJjSsOo]$ ]]; then
                update_sbo_packages
            fi
        fi
    fi

    if command -v sync_all_installed_cachyos_gaming_packages >/dev/null 2>&1; then
        local gaming_count
        gaming_count=$(get_status_key_count "cachyos_gaming_updates")
        if [ "${gaming_count}" -gt 0 ]; then
            local reply_gaming="Y"
            if [ "${is_headless}" -eq 0 ]; then
                read -r -p "$(_ PROMPT_UPGRADE_GAMING)" reply_gaming || reply_gaming="Y"
                reply_gaming=${reply_gaming:-Y}
            fi
            if [[ "$reply_gaming" =~ ^[YyJjSsOo]$ ]]; then
                echo -e "\n${BLUE}${BOLD}$(_ UPGRADING_GAMING)${RESET}"
                sync_all_installed_cachyos_gaming_packages
            fi
        fi
    fi

    if [ -f "${APP_DIR}/gnomes_pacman.py" ]; then
        local gnomes_count
        gnomes_count=$(python3 "${APP_DIR}/gnomes_pacman.py" list-updates --count 2>/dev/null || echo "0")
        if [ "${gnomes_count}" -gt 0 ]; then
            local reply_gnomes="Y"
            if [ "${is_headless}" -eq 0 ]; then
                read -r -p "$(_ PROMPT_UPGRADE_GNOMES)" reply_gnomes || reply_gnomes="Y"
                reply_gnomes=${reply_gnomes:-Y}
            fi
            if [[ "$reply_gnomes" =~ ^[YyJjSsOo]$ ]]; then
                echo -e "\n${BLUE}${BOLD}$(_ UPGRADING_GNOMES)${RESET}"
                python3 "${APP_DIR}/gnomes_pacman.py" list-updates
            fi
        fi
    fi

    if [ "${HAS_NVIDIA}" = "true" ] && [ "$(has_cachyos_kernels_installed 2>/dev/null || echo false)" != "true" ]; then
        local nv_count
        nv_count=$(get_status_key_count "nvidia_driver_updates")
        if [ "${nv_count}" -gt 0 ]; then
            local reply_nv="Y"
            if [ "${is_headless}" -eq 0 ]; then
                read -r -p "$(_ PROMPT_UPGRADE_NVIDIA_DRIVER)" reply_nv || reply_nv="Y"
                reply_nv=${reply_nv:-Y}
            fi
            if [[ "$reply_nv" =~ ^[YyJjSsOo]$ ]]; then
                install_nvidia_run_driver "production"
                kernel_or_driver_changed=1
            fi
        fi
    fi

    k_snap_after=$(get_kernel_driver_snapshot)
    get_full_pkg_snapshot_file "${snap_after_file}"

    boot_snap_after=$(ls -1 /boot/vmlinuz* /var/log/packages/*limine* /var/log/packages/*sbctl* /var/log/packages/*grub* /var/log/packages/*elilo* 2>/dev/null || true)
    if [ "${boot_snap_before}" != "${boot_snap_after}" ]; then
        kernel_or_driver_changed=1
    fi
    if [ "${k_snap_before}" != "${k_snap_after}" ]; then
        kernel_or_driver_changed=1
    fi

    if [ "${kernel_or_driver_changed}" -eq 1 ]; then
        local active_kver
        active_kver=$(uname -r)

        echo ""
        log_info "⚡ Post-Upgrade Hardening & Bootloader Matrix:"

        # [1/5] NVIDIA Driver & DKMS Modules
        local nv_status="Up to date"
        if [ "${HAS_NVIDIA}" = "true" ] && [ "$(has_cachyos_kernels_installed 2>/dev/null || echo false)" = "true" ]; then
            if command -v ensure_cachyos_nvidia_duties >/dev/null 2>&1; then
                ensure_cachyos_nvidia_duties >/dev/null 2>&1 || true
                local cachy_nv_ver="615.71.09"
                if ls /var/log/packages/cachyos-nvidia-utils-* 1>/dev/null 2>&1; then
                    cachy_nv_ver=$(basename "$(ls /var/log/packages/cachyos-nvidia-utils-* 2>/dev/null | head -n 1)" | sed -E 's/cachyos-nvidia-utils-([0-9]+\.[0-9]+(\.[0-9]+)?).*/\1/' || echo "615.71.09")
                fi
                nv_status="Up to date (v${cachy_nv_ver})"
            fi
        elif [ "${HAS_NVIDIA}" = "true" ]; then
            build_nvidia_modules "${active_kver}" >/dev/null 2>&1 || true
            nv_status="Synchronized for ${active_kver}"
        else
            nv_status="Up to date (Non-NVIDIA)"
        fi
        echo -e "  \033[1;36m[1/5]\033[0m \033[1mNVIDIA Driver & DKMS Modules\033[0m : ${GREEN}${nv_status}${RESET}"

        # Clean obsolete kernels silently
        if command -v purge_old_slackware_kernels >/dev/null 2>&1; then
            purge_old_slackware_kernels --no-sync >/dev/null 2>&1 || true
        fi
        if command -v purge_old_cachyos_kernels >/dev/null 2>&1; then
            purge_old_cachyos_kernels --no-sync >/dev/null 2>&1 || true
        fi

        # [2/5] Secure Boot MOK Signing
        local mok_status="Verified signed with active MOK"
        if command -v enforce_secure_boot_armor >/dev/null 2>&1; then
            local mok_out
            mok_out=$(enforce_secure_boot_armor --pipeline 2>/dev/null || true)
            if [ -n "${mok_out}" ]; then
                mok_status="${mok_out}"
            fi
        fi
        echo -e "  \033[1;36m[2/5]\033[0m \033[1mSecure Boot MOK Signing\033[0m      : ${GREEN}${mok_status}${RESET}"

        # [3/5] Dracut Initramfs Generation
        if command -v generate_kernel_initramfs >/dev/null 2>&1; then
            generate_kernel_initramfs "TARGETED_PIPELINE"
        fi

        # [4/5] Secure Boot Kernel & Bootloader Pre-Signing (sbctl)
        local sb_status="Skipped (sbctl not active)"
        if command -v sign_kernel_binaries_sbctl >/dev/null 2>&1; then
            sign_kernel_binaries_sbctl >/dev/null 2>&1 || true
            sb_status="Signed kernel binaries & verified Secure Boot state"
        fi
        echo -e "  \033[1;36m[4/5]\033[0m \033[1mSecure Boot Kernel Signing\033[0m    : ${GREEN}${sb_status}${RESET}"

        # [5/5] Limine Config, BLAKE2B Hash Matrix & Bootloader Reseal
        local lim_installed=false
        if command -v is_limine_installed >/dev/null 2>&1 && [ "$(is_limine_installed)" = "true" ]; then
            lim_installed=true
            if command -v generate_limine_configuration >/dev/null 2>&1; then
                generate_limine_configuration >/dev/null 2>&1 || true
            fi
            if command -v enroll_and_sign_limine >/dev/null 2>&1; then
                enroll_and_sign_limine >/dev/null 2>&1 || true
            fi
            echo -e "  \033[1;36m[5/5]\033[0m \033[1mLimine Matrix & Boot Sync\033[0m     : ${GREEN}BLAKE2B enrolled & EFI signed${RESET}"
        else
            echo -e "  \033[1;36m[5/5]\033[0m \033[1mLimine Matrix & Boot Sync\033[0m     : ${YELLOW}Skipped (Limine not active)${RESET}"
        fi
        if command -v sync_grub_configuration >/dev/null 2>&1; then
            sync_grub_configuration >/dev/null 2>&1 || true
        fi
    else
        log_info "No kernel or driver changes detected. Skipping initramfs generation and signing."
    fi

    rm -f /tmp/slacky-update-running.lock 2>/dev/null || true
    unset DEFER_BOOT_SYNC || true
    unset SLACKY_UPDATE_RUNNING || true

    echo -e "\n${CYAN}$(_ REFRESHING_CACHE)${RESET}"
    "${CHECK_BIN}" 2>/dev/null || true

    python3 -c "
import os, json, time
kofi_file = os.path.expanduser('~/.config/slacky-update/kofi.json')
try:
    os.makedirs(os.path.dirname(kofi_file), exist_ok=True)
    d = {}
    if os.path.exists(kofi_file):
        with open(kofi_file, 'r', encoding='utf-8') as f:
            d = json.load(f)
    d['last_update_ts'] = time.time()
    with open(kofi_file, 'w', encoding='utf-8') as f:
        json.dump(d, f)
except Exception:
    pass
" 2>/dev/null || true

    run_post_update_smoke_test

    if [ "${is_headless}" -eq 0 ] && [ -f "${APP_DIR}/gnomes_pacman.py" ]; then
        local gnomes_cache_sz gnomes_cache_human
        gnomes_cache_sz=$(python3 -c "
import os
cache_dir = os.path.expanduser('~/.cache/slacky-update/gnomes/pkg')
total = 0
if os.path.isdir(cache_dir):
    for root, _, files in os.walk(cache_dir):
        for f in files:
            try:
                total += os.path.getsize(os.path.join(root, f))
            except Exception:
                pass
print(total)
" 2>/dev/null || echo "0")
        if [ "${gnomes_cache_sz}" -gt 10485760 ]; then # > 10 MB
            gnomes_cache_human=$(python3 -c "
b = int('${gnomes_cache_sz}')
if b >= 1024*1024*1024:
    print(f'{b/(1024*1024*1024):.1f} GB')
else:
    print(f'{b/(1024*1024):.1f} MB')
" 2>/dev/null || echo "0 MB")
            echo ""
            local reply_clean="n"
            read -r -p "🩲 $(_ PROMPT_CLEAR_GNOMES_CACHE "${gnomes_cache_human}") " reply_clean || reply_clean="n"
            if [[ "$reply_clean" =~ ^[YyJjSsOo]$ ]]; then
                python3 "${APP_DIR}/gnomes_pacman.py" clean-cache --all
            fi
        fi
    fi

    echo -e "\n${GREEN}${BOLD}$(_ UPGRADE_COMPLETE_SYSTEM)${RESET}"

    prompt_reboot_or_close "${snap_before_file}" "${snap_after_file}" "${kernel_or_driver_changed}"
}

# --- [ CACHYOS KERNEL MANAGEMENT ROUTINE ] ---
manage_cachyos_kernel_interactive() {
    local tier
    tier=$(detect_cpu_tier)
    if [ "${tier}" = "znver4" ]; then
        log_info "CPU Architecture Tier: x86_64_v4 (znver4 - AMD Zen 4/5 Optimized)"
    elif [ "${tier}" = "v4" ]; then
        log_info "CPU Architecture Tier: x86_64_v4 (Intel/Generic AVX-512 Optimized)"
    elif [ "${tier}" = "v3" ]; then
        log_info "CPU Architecture Tier: x86_64_v3 (AVX2/FMA Optimized)"
    else
        log_info "CPU Architecture Tier: x86_64 (Generic Baseline)"
    fi

    local active_kver
    active_kver=$(uname -r)

    local installed_flavors
    installed_flavors=$(get_installed_cachyos_flavors)

    while true; do
        echo ""
        echo -e "${CYAN}============================================================${RESET}"
        echo -e "${YELLOW}${BOLD}$(_ MENU_KERNEL)${RESET}"
        echo -e "${CYAN}============================================================${RESET}"
        
        if [ -n "${installed_flavors}" ]; then
            echo -e "${BOLD}Installed CachyOS Kernel Flavors:${RESET}"
            for flv in ${installed_flavors}; do
                local cur_ver
                cur_ver=$(get_installed_cachyos_flavor_version "${flv}")
                echo -e "  • \033[1;32m${flv}\033[0m: v${cur_ver}"
            done
        else
            echo -e "${YELLOW}$(_ KERNEL_NOT_INSTALLED)${RESET}"
        fi

        echo ""
        echo -e "${BOLD}Actions:${RESET}"
        echo -e "  1. $(_ CACHY_MENU_UPGRADE_INSTALLED | sed -E 's/^[0-9]+\.\s*//')"
        echo -e "  2. $(_ CACHY_MENU_PICKER | sed -E 's/^[0-9]+\.\s*//')"
        echo -e "  3. $(_ CACHY_MENU_MANAGE_KERNELS | sed -E 's/^[0-9]+\.\s*//')"
        echo -e "  4. $(_ CACHY_MENU_REBUILD_ACTIVE active="${active_kver}" | sed -E 's/^[0-9]+\.\s*//')"
        echo -e "  5. $(_ MOK_OPTION_RETURN | sed -E 's/^[0-9]+\.\s*//')"
        echo ""
        echo -n "$(_ SELECT_OPERATION_RANGE range="1-5") "
        read -r kchoice || kchoice="5"

        case "${kchoice}" in
            1)
                echo ""
                if [ -z "${installed_flavors}" ]; then
                    log_warn "No CachyOS kernels currently installed. Use CachyOS Kernel Picker to install your first flavor!"
                    cachyos_kernel_picker_interactive
                    installed_flavors=$(get_installed_cachyos_flavors)
                else
                    update_cachyos_kernels
                fi
                echo ""
                read -r -p "$(_ PRESS_ENTER_CONTINUE)" || true
                ;;
            2)
                echo ""
                cachyos_kernel_picker_interactive
                installed_flavors=$(get_installed_cachyos_flavors)
                ;;
            3)
                echo ""
                manage_system_kernels_interactive
                installed_flavors=$(get_installed_cachyos_flavors)
                ;;
            4)
                echo ""
                validate_privileges
                generate_kernel_initramfs "${active_kver}"
                build_nvidia_modules "${active_kver}"
                enforce_secure_boot_armor
                sync_bootloader_configuration "${active_kver}"
                echo ""
                read -r -p "$(_ PRESS_ENTER_CONTINUE)" || true
                ;;
            5)
                return 0
                ;;
            *)
                echo -e "\n${YELLOW}$(_ INVALID_SELECTION)${RESET}"
                sleep 1
                ;;
        esac
    done
}

# --- [ NVIDIA DRIVER MANAGEMENT ROUTINE ] ---
manage_nvidia_interactive() {
    local gpu_gen
    gpu_gen=$(detect_nvidia_gpu)
    log_info "Detected GPU Architecture: ${gpu_gen}"

    local has_cachy
    has_cachy=$(has_cachyos_kernels_installed 2>/dev/null || echo "false")

    if [ "${has_cachy}" = "true" ]; then
        # CachyOS-managed system: show CachyOS NVIDIA Master Station
        while true; do
            echo ""
            echo -e "${CYAN}============================================================${RESET}"
            echo -e "${YELLOW}${BOLD}$(_ MENU_NVIDIA_CACHY_TITLE)${RESET}"
            echo -e "${CYAN}============================================================${RESET}"
            echo -e "  \033[1;33m1.\033[0m $(_ NVIDIA_CACHYOS_MASTER_SYNC)"
            echo -e "  \033[1;33m2.\033[0m $(_ NVIDIA_OPTION_REBUILD)"
            echo -e "  \033[1;33m3.\033[0m $(_ NVIDIA_OPTION_RETURN)"
            echo ""
            echo -n "$(_ SELECT_OPERATION_RANGE range="1-3") "
            local n_choice
            read -r n_choice || n_choice="3"

            case "${n_choice}" in
                1)
                    validate_privileges
                    INTERACTIVE_NVIDIA=1 ensure_cachyos_nvidia_duties
                    echo ""
                    read -r -p "$(_ PRESS_ENTER_CONTINUE)" || true
                    ;;
                2)
                    validate_privileges
                    build_nvidia_modules "ALL"
                    generate_kernel_initramfs "ALL"
                    enforce_secure_boot_armor
                    sync_bootloader_configuration "$(uname -r)"
                    register_flatpak_gl_sync
                    echo ""
                    read -r -p "$(_ PRESS_ENTER_CONTINUE)" || true
                    ;;
                3)
                    return 0
                    ;;
                *)
                    log_warn "Invalid selection."
                    ;;
            esac
        done
    else
        # Pure Slackware system without CachyOS: show standalone .run branch selection
        while true; do
            echo ""
            echo -e "${BOLD}$(_ NVIDIA_BRANCH_SELECT)${RESET}"
            echo -e "  \033[1;33m1.\033[0m $(_ NVIDIA_BRANCH_LEGACY)"
            echo -e "  \033[1;33m2.\033[0m $(_ NVIDIA_BRANCH_PRODUCTION)"
            echo -e "  \033[1;33m3.\033[0m $(_ NVIDIA_BRANCH_FEATURE)"
            echo -e "  \033[1;33m4.\033[0m $(_ NVIDIA_OPTION_REBUILD)"
            echo -e "  \033[1;33m5.\033[0m $(_ NVIDIA_OPTION_RETURN)"
            echo ""
            echo -n "$(_ SELECT_OPERATION_RANGE range="1-5") "
            local n_choice
            read -r n_choice || n_choice="5"

            case "${n_choice}" in
                1)
                    validate_privileges
                    install_nvidia_run_driver "legacy"
                    echo ""
                    read -r -p "$(_ PRESS_ENTER_CONTINUE)" || true
                    ;;
                2)
                    validate_privileges
                    install_nvidia_run_driver "production"
                    echo ""
                    read -r -p "$(_ PRESS_ENTER_CONTINUE)" || true
                    ;;
                3)
                    validate_privileges
                    install_nvidia_run_driver "feature"
                    echo ""
                    read -r -p "$(_ PRESS_ENTER_CONTINUE)" || true
                    ;;
                4)
                    validate_privileges
                    build_nvidia_modules "ALL"
                    generate_kernel_initramfs "ALL"
                    enforce_secure_boot_armor
                    sync_bootloader_configuration "$(uname -r)"
                    register_flatpak_gl_sync
                    echo ""
                    read -r -p "$(_ PRESS_ENTER_CONTINUE)" || true
                    ;;
                5)
                    return 0
                    ;;
                *)
                    log_warn "Invalid selection."
                    ;;
            esac
        done
    fi
}

# --- [ UNDERPANTS GNOMES LAUNCHER ] ---
launch_gnomes_station_interactive() {
    interactive_cachyos_gaming_menu
}

# --- [ INTERACTIVE TERMINAL MENU ] ---
interactive_menu() {
    INTERACTIVE_SESSION=1
    probe_gpu_hardware
    while true; do
        set_terminal_title "slacky-update v${CURRENT_VERSION}"
        local has_cachy
        has_cachy=$(has_cachyos_kernels_installed 2>/dev/null || echo "false")

        echo ""
        echo -e "${BLUE}${BOLD}Slacky-Update (v${CURRENT_VERSION} '${RELEASE_CODENAME}') [Pre-Release / Early Access]${RESET}"
        echo -e "${YELLOW}⚡ Slackware Core Update & High-Performance Modernization Engine${RESET}"
        check_slacky_update_self_update "${CURRENT_VERSION}"
        echo ""
        display_pending_status
        echo -e "${BOLD}$(_ CLI_ACTIONS_HEADER)${RESET}"

        if [ "${HAS_NVIDIA}" = "true" ]; then
            echo -e "  $(_ MENU_FULL_UPDATE)"
            echo -e "  $(_ MENU_KERNEL)"
            if [ "${has_cachy}" = "true" ]; then
                echo -e "  $(_ MENU_NVIDIA_CACHY)"
            else
                echo -e "  $(_ MENU_NVIDIA)"
            fi
            echo -e "  4. $(_ MENU_GAMING | sed -E 's/^[0-9]+\.\s*//')"
            echo -e "  5. $(_ MENU_CLEAN | sed -E 's/^[0-9]+\.\s*//')"
            echo -e "  6. \033[1;36m$(_ MENU_LIMINE | sed -E 's/^[0-9]+\.\s*//')\033[0m"
            echo -e "  7. $(_ MENU_ARMOR | sed -E 's/^[0-9]+\.\s*//')"
            echo -e "  8. \033[1;32m$(_ MENU_FIELD_GUIDE | sed -E 's/^[0-9]+\.\s*//')\033[0m"
            echo -e "  9. $(_ MENU_EXIT | sed -E 's/^[0-9]+\.\s*//')"
            echo ""
            echo -n "$(_ SELECT_OPERATION_RANGE range="1-9")"
            local choice
            read -r choice || choice="9"

            case "${choice}" in
                1)
                    echo ""
                    run_full_update
                    ;;
                2)
                    echo ""
                    ensure_dkms_installed_interactive
                    manage_cachyos_kernel_interactive
                    echo ""
                    read -r -p "$(_ PRESS_ENTER_CONTINUE)" || true
                    ;;
                3)
                    echo ""
                    ensure_dkms_installed_interactive
                    manage_nvidia_interactive
                    echo ""
                    read -r -p "$(_ PRESS_ENTER_CONTINUE)" || true
                    ;;
                4)
                    echo ""
                    launch_gnomes_station_interactive
                    ;;
                5)
                    echo ""
                    clean_system_cache_and_orphans
                    echo ""
                    read -r -p "$(_ PRESS_ENTER_CONTINUE)" || true
                    ;;
                6)
                    echo ""
                    if command -v manage_limine_interactive >/dev/null 2>&1; then
                        manage_limine_interactive
                    fi
                    ;;
                7)
                    echo ""
                    manage_secureboot_interactive
                    echo ""
                    read -r -p "$(_ PRESS_ENTER_CONTINUE)" || true
                    ;;
                8)
                    echo ""
                    if command -v manage_field_guide_interactive >/dev/null 2>&1; then
                        manage_field_guide_interactive
                    fi
                    ;;
                9)
                    echo -e "\n${GREEN}$(_ SESSION_TERMINATED)${RESET}"
                    exit 0
                    ;;
                *)
                    echo -e "\n${YELLOW}$(_ INVALID_SELECTION)${RESET}"
                    sleep 1
                    ;;
            esac
        elif [ "${HAS_AMD}" = "true" ]; then
            echo -e "  $(_ MENU_FULL_UPDATE)"
            echo -e "  $(_ MENU_KERNEL)"
            echo -e "  3. $(_ MENU_AMD_ROCM | sed -E 's/^[0-9]+\.\s*//')"
            echo -e "  4. $(_ MENU_GAMING | sed -E 's/^[0-9]+\.\s*//')"
            echo -e "  5. $(_ MENU_CLEAN | sed -E 's/^[0-9]+\.\s*//')"
            echo -e "  6. \033[1;36m$(_ MENU_LIMINE | sed -E 's/^[0-9]+\.\s*//')\033[0m"
            echo -e "  7. $(_ MENU_ARMOR | sed -E 's/^[0-9]+\.\s*//')"
            echo -e "  8. \033[1;32m$(_ MENU_FIELD_GUIDE | sed -E 's/^[0-9]+\.\s*//')\033[0m"
            echo -e "  9. $(_ MENU_EXIT | sed -E 's/^[0-9]+\.\s*//')"
            echo ""
            echo -n "$(_ SELECT_OPERATION_RANGE range="1-9")"
            local choice
            read -r choice || choice="9"

            case "${choice}" in
                1)
                    echo ""
                    run_full_update
                    ;;
                2)
                    echo ""
                    manage_cachyos_kernel_interactive
                    echo ""
                    read -r -p "$(_ PRESS_ENTER_CONTINUE)" || true
                    ;;
                3)
                    echo ""
                    if command -v manage_rocm_interactive >/dev/null 2>&1; then
                        manage_rocm_interactive
                    else
                        log_warn "ROCm module not loaded."
                    fi
                    echo ""
                    read -r -p "$(_ PRESS_ENTER_CONTINUE)" || true
                    ;;
                4)
                    echo ""
                    launch_gnomes_station_interactive
                    ;;
                5)
                    echo ""
                    clean_system_cache_and_orphans
                    echo ""
                    read -r -p "$(_ PRESS_ENTER_CONTINUE)" || true
                    ;;
                6)
                    echo ""
                    if command -v manage_limine_interactive >/dev/null 2>&1; then
                        manage_limine_interactive
                    fi
                    ;;
                7)
                    echo ""
                    manage_secureboot_interactive
                    echo ""
                    read -r -p "$(_ PRESS_ENTER_CONTINUE)" || true
                    ;;
                8)
                    echo ""
                    if command -v manage_field_guide_interactive >/dev/null 2>&1; then
                        manage_field_guide_interactive
                    fi
                    ;;
                9)
                    echo -e "\n${GREEN}$(_ SESSION_TERMINATED)${RESET}"
                    exit 0
                    ;;
                *)
                    echo -e "\n${YELLOW}$(_ INVALID_SELECTION)${RESET}"
                    sleep 1
                    ;;
            esac
        else
            # Pure Intel / Headless Menu (No dedicated GPU menu)
            echo -e "  1. $(_ MENU_FULL_UPDATE | sed -E 's/^[0-9]+\.\s*//')"
            echo -e "  2. $(_ MENU_KERNEL | sed -E 's/^[0-9]+\.\s*//')"
            echo -e "  3. $(_ MENU_GAMING | sed -E 's/^[0-9]+\.\s*//')"
            echo -e "  4. $(_ MENU_CLEAN | sed -E 's/^[0-9]+\.\s*//')"
            echo -e "  5. \033[1;36m$(_ MENU_LIMINE | sed -E 's/^[0-9]+\.\s*//')\033[0m"
            echo -e "  6. $(_ MENU_ARMOR | sed -E 's/^[0-9]+\.\s*//')"
            echo -e "  7. \033[1;32m$(_ MENU_FIELD_GUIDE | sed -E 's/^[0-9]+\.\s*//')\033[0m"
            echo -e "  8. $(_ MENU_EXIT | sed -E 's/^[0-9]+\.\s*//')"
            echo ""
            echo -n "$(_ SELECT_OPERATION_RANGE range="1-8")"
            local choice
            read -r choice || choice="8"

            case "${choice}" in
                1)
                    echo ""
                    run_full_update
                    ;;
                2)
                    echo ""
                    manage_cachyos_kernel_interactive
                    echo ""
                    read -r -p "$(_ PRESS_ENTER_CONTINUE)" || true
                    ;;
                3)
                    echo ""
                    launch_gnomes_station_interactive
                    ;;
                4)
                    echo ""
                    clean_system_cache_and_orphans
                    echo ""
                    read -r -p "$(_ PRESS_ENTER_CONTINUE)" || true
                    ;;
                5)
                    echo ""
                    if command -v manage_limine_interactive >/dev/null 2>&1; then
                        manage_limine_interactive
                    fi
                    ;;
                6)
                    echo ""
                    manage_secureboot_interactive
                    echo ""
                    read -r -p "$(_ PRESS_ENTER_CONTINUE)" || true
                    ;;
                7)
                    echo ""
                    if command -v manage_field_guide_interactive >/dev/null 2>&1; then
                        manage_field_guide_interactive
                    fi
                    ;;
                8)
                    echo -e "\n${GREEN}$(_ SESSION_TERMINATED)${RESET}"
                    exit 0
                    ;;
                *)
                    echo -e "\n${YELLOW}$(_ INVALID_SELECTION)${RESET}"
                    sleep 1
                    ;;
            esac
        fi
    done
}

# --- [ ENTRY POINT ] ---
if [ "${1:-}" = "--non-interactive" ] || [ "${1:-}" = "-y" ]; then
    export NON_INTERACTIVE=1
    run_full_update
elif [ "${1:-}" = "--check" ]; then
    "${CHECK_BIN}"
    display_pending_status
elif [ "${1:-}" = "--limine" ] || [ "${1:-}" = "-l" ]; then
    INTERACTIVE_SESSION=1
    manage_limine_interactive
elif [ "${1:-}" = "--cmdline" ] || [ "${1:-}" = "-c" ]; then
    INTERACTIVE_SESSION=1
    manage_kernel_cmdline_interactive
elif [ "${1:-}" = "--secure-boot" ] || [ "${1:-}" = "--sb" ]; then
    INTERACTIVE_SESSION=1
    manage_secureboot_interactive
elif [ "${1:-}" = "--gnomes-pacman" ] || [ "${1:-}" = "gnomes" ] || [ "${1:-}" = "-P" ]; then
    shift
    if [ -x "${SCRIPT_DIR}/gnomes" ]; then
        exec "${SCRIPT_DIR}/gnomes" "$@"
    elif [ -x "/usr/bin/gnomes" ]; then
        exec /usr/bin/gnomes "$@"
    elif [ -x "/usr/local/bin/gnomes" ]; then
        exec /usr/local/bin/gnomes "$@"
    else
        python3 "${APP_DIR}/gnomes_pacman.py" "$@"
    fi
elif [ "${1:-}" = "--gaming" ] || [ "${1:-}" = "-g" ] || [ "${1:-}" = "--gnomes" ] || [ "${1:-}" = "--gnomes-tui" ]; then
    INTERACTIVE_SESSION=1
    interactive_cachyos_gaming_menu
elif [ "${1:-}" = "--gnomes-data" ] || [ "${1:-}" = "--gaming-json" ]; then
    if command -v export_gaming_catalog_json >/dev/null 2>&1; then
        export_gaming_catalog_json
        exit 0
    elif [ -f "${APP_DIR}/mod_gaming.sh" ]; then
        source "${APP_DIR}/mod_gaming.sh"
        export_gaming_catalog_json
        exit 0
    fi
elif [ "${1:-}" = "--gnomes-deploy" ] || [ "${1:-}" = "--gaming-deploy" ]; then
    shift
    validate_privileges
    if [ $# -eq 1 ]; then
        transmute_and_deploy_gaming_pkg "$1"
    else
        deploy_gaming_packages_batch "$@"
    fi
    exit $?
elif [ "${1:-}" = "--gnomes-uninstall" ] || [ "${1:-}" = "--gaming-uninstall" ]; then
    shift
    validate_privileges
    uninstall_cachyos_gaming_pkg "$1"
    exit $?
elif [ "${1:-}" = "--heal-multilib" ] || [ "${1:-}" = "-m" ]; then
    validate_privileges
    heal_multilib_subsystem
    run_post_update_smoke_test
elif [ "${1:-}" = "--slackbuilds" ] || [ "${1:-}" = "-s" ]; then
    INTERACTIVE_SESSION=1
    manage_slackbuilds_interactive
elif [ "${1:-}" = "--tweaks" ] || [ "${1:-}" = "-t" ]; then
    INTERACTIVE_SESSION=1
    manage_tweaks_interactive
elif [ "${1:-}" = "--guide" ] || [ "${1:-}" = "--field-guide" ] || [ "${1:-}" = "--manual" ] || [ "${1:-}" = "--docs" ] || [ "${1:-}" = "-d" ]; then
    INTERACTIVE_SESSION=1
    if command -v manage_field_guide_interactive >/dev/null 2>&1; then
        manage_field_guide_interactive
    elif [ -f "${APP_DIR}/mod_docs.sh" ]; then
        source "${APP_DIR}/mod_docs.sh"
        manage_field_guide_interactive
    fi
elif [ "${1:-}" = "--sync-boot" ] || [ "${1:-}" = "--boot" ] || [ "${1:-}" = "-b" ] || [ "${1:-}" = "--limine-config" ]; then
    validate_privileges
    if command -v generate_kernel_initramfs >/dev/null 2>&1; then
        log_info "Synchronizing initramfs images for all installed kernels..."
        generate_kernel_initramfs "ALL"
    fi
    if command -v sync_bootloader_configuration >/dev/null 2>&1; then
        sync_bootloader_configuration "$(uname -r)"
    fi
elif [ "${1:-}" = "--sync-snapper" ] || [ "${1:-}" = "--snapper-sync" ]; then
    validate_privileges
    if command -v generate_limine_configuration >/dev/null 2>&1; then
        generate_limine_configuration
    fi
    if command -v enroll_and_sign_limine >/dev/null 2>&1; then
        enroll_and_sign_limine
    fi
elif [ "${1:-}" = "--sync-nvidia" ] || [ "${1:-}" = "--nvidia" ]; then
    validate_privileges
    INTERACTIVE_NVIDIA=1
    ensure_cachyos_nvidia_duties
elif [ "${1:-}" = "--hash-check" ] || [ "${1:-}" = "--check-hashes" ] || [ "${1:-}" = "-H" ]; then
    validate_privileges
    if command -v check_kernel_boot_hashes >/dev/null 2>&1; then
        check_kernel_boot_hashes
        exit $?
    elif [ -f "${APP_DIR}/mod_limine.sh" ]; then
        source "${APP_DIR}/mod_limine.sh"
        check_kernel_boot_hashes
        exit $?
    else
        echo -e "${RED}✗ Error:${RESET} Limine hash verification module not found."
        exit 1
    fi
elif [ "${1:-}" = "--clean" ] || [ "${1:-}" = "--purge-kernels" ]; then
    validate_privileges
    clean_system_cache_and_orphans
elif [ "${1:-}" = "--restore-limine" ]; then
    validate_privileges
    restore_limine_self_heal
elif [ "${1:-}" = "--list-langs" ]; then
    python3 "${I18N_PY}" --list-langs
    exit 0
elif [ "${1:-}" = "--lang" ]; then
    if [ -z "${2:-}" ]; then
        echo -e "${RED}Error:${RESET} Missing language code. Usage: slacky-update --lang <code|nb|en>"
        echo "Run 'slacky-update --list-langs' to see all available language codes."
        exit 1
    fi
    python3 "${I18N_PY}" --set-lang "$2"
    exit 0
elif [[ "${1:-}" =~ ^--lang=(.+)$ ]]; then
    target_code="${BASH_REMATCH[1]}"
    python3 "${I18N_PY}" --set-lang "${target_code}"
    exit 0
elif [ "${1:-}" = "--version" ] || [ "${1:-}" = "-v" ]; then
    echo "slacky-update v${CURRENT_VERSION} '${RELEASE_CODENAME}' (Slackware Linux)"
    exit 0
elif [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
    echo -e "${BLUE}${BOLD}Slacky-Update v${CURRENT_VERSION} '${RELEASE_CODENAME}'${RESET}"
    echo -e "${YELLOW}Notice: Pre-Release software. All system changes and kernel/bootloader modifications are at your own risk.${RESET}"
    echo "Usage: slacky-update [OPTIONS]"
    echo ""
    echo "Options:"
    echo "  -y, --non-interactive   Run full unattended system upgrade (Slackware, Flatpaks, Kernels, Drivers, SBo)"
    echo "      --check             Run non-modifying read-only status check"
    echo "  -H, --hash-check        Dynamically verify on-disk kernel & initramfs BLAKE2B hashes against Limine"
    echo "  -l, --limine            Open Limine Bootloader & Secure Boot Matrix"
    echo "  -c, --cmdline           Configure Kernel Boot Parameters (CMDLINE & Gaming Hub)"
    echo "  -b, --sync-boot         Synchronize initramfs, Limine/GRUB bootloader, BLAKE2B hashes & Secure Boot"
    echo "      --sync-snapper      Synchronize Btrfs Snapper snapshots into Limine menu and reseal"
    echo "      --sync-nvidia       Synchronize NVIDIA driver suite and compile/match kernel modules"
    echo "      --clean             Clean package caches, remove obsolete kernels and orphaned packages"
    echo "      --restore-limine    Restore Limine bootloader from known good self-heal backup"
    echo "      --sb, --secure-boot Open UEFI Secure Boot & MOK Armor Command Center"
    echo "  -g, --gaming            Open CachyOS Underpants Gnomes Gaming Suite menu"
    echo "  -m, --heal-multilib     Audit and repair AlienBOB 32-bit Multilib subsystem"
    echo "  -s, --slackbuilds       Open SlackBuilds and sbotools management hub"
    echo "  -t, --tweaks            Open system performance and gaming tweaks menu"
    echo "  -d, --guide, --manual   Open Master Field Guide and multi-format export suite (PDF/QR/Email)"
    echo "      --lang <code|nb|en> Set system language preference"
    echo "      --list-langs        List all available languages"
    echo "  -v, --version           Display version and release codename"
    echo "  -h, --help              Display this help menu"
    echo ""
    exit 0
else
    interactive_menu
fi
