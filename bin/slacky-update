#!/usr/bin/env bash
# --- [ SLACKY-UPDATE CLI INTERFACE & MAIN CONTROLLER ] ---

set -euo pipefail
# 6A-51: python3 -c / python3 - run as root must never import modules from the current directory
export PYTHONSAFEPATH=1

CURRENT_VERSION="1.0_RC2"
RELEASE_CODENAME="Dark Star"

# --- [ DYNAMIC HiDPI & MULTI-MONITOR DISPLAY SCALING ] ---
# Transparently routes Qt, Wayland, and GTK interfaces across Hyprland, KDE Plasma, XFCE, and GNOME
if [ "${XDG_SESSION_TYPE:-}" = "wayland" ] || [ -n "${WAYLAND_DISPLAY:-}" ] || [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
    [ -z "${QT_QPA_PLATFORM:-}" ] && export QT_QPA_PLATFORM="wayland;xcb"
    [ -z "${GDK_BACKEND:-}" ] && export GDK_BACKEND="wayland,x11,*"
    unset QT_AUTO_SCREEN_SCALE_FACTOR QT_ENABLE_HIGHDPI_SCALING 2>/dev/null || true
else
    [ -z "${QT_AUTO_SCREEN_SCALE_FACTOR:-}" ] && export QT_AUTO_SCREEN_SCALE_FACTOR=1
    [ -z "${QT_ENABLE_HIGHDPI_SCALING:-}" ] && export QT_ENABLE_HIGHDPI_SCALING=1
    [ -z "${QT_SCALE_FACTOR_ROUNDING_POLICY:-}" ] && export QT_SCALE_FACTOR_ROUNDING_POLICY=PassThrough
fi

SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"
if [ -d "${SCRIPT_DIR}/../lib" ] && [ -f "${SCRIPT_DIR}/../lib/common.sh" ]; then
    APP_DIR="${SCRIPT_DIR}/../lib"
elif [ -d "/usr/share/slacky-update/lib" ] && [ -f "/usr/share/slacky-update/lib/common.sh" ]; then
    APP_DIR="/usr/share/slacky-update/lib"
elif [ -d "/usr/local/lib/slacky-update" ] && [ -f "/usr/local/lib/slacky-update/common.sh" ]; then
    APP_DIR="/usr/local/lib/slacky-update"
elif [ -d "/usr/lib64/slacky-update" ] && [ -f "/usr/lib64/slacky-update/common.sh" ]; then
    APP_DIR="/usr/lib64/slacky-update"
elif [ -d "/usr/lib/slacky-update" ] && [ -f "/usr/lib/slacky-update/common.sh" ]; then
    APP_DIR="/usr/lib/slacky-update"
else
    APP_DIR="${SCRIPT_DIR}/../lib"
fi

# shellcheck source=/dev/null
source "${APP_DIR}/common.sh"
# shellcheck source=/dev/null
source "${APP_DIR}/mod_nvidia.sh"
# shellcheck source=/dev/null
source "${APP_DIR}/mod_packages.sh"
# shellcheck source=/dev/null
source "${APP_DIR}/mod_sbo.sh"
# shellcheck source=/dev/null
source "${APP_DIR}/mod_kernel.sh"
# shellcheck source=/dev/null
source "${APP_DIR}/mod_armor.sh"
# shellcheck source=/dev/null
[ -f "${APP_DIR}/mod_limine.sh" ] && source "${APP_DIR}/mod_limine.sh"
# shellcheck source=/dev/null
[ -f "${APP_DIR}/mod_secureboot.sh" ] && source "${APP_DIR}/mod_secureboot.sh"
# shellcheck source=/dev/null
source "${APP_DIR}/mod_clean.sh"
# shellcheck source=/dev/null
[ -f "${APP_DIR}/mod_rocm.sh" ] && source "${APP_DIR}/mod_rocm.sh"
# shellcheck source=/dev/null
[ -f "${APP_DIR}/mod_tweaks.sh" ] && source "${APP_DIR}/mod_tweaks.sh"
# shellcheck source=/dev/null
[ -f "${APP_DIR}/mod_gaming.sh" ] && source "${APP_DIR}/mod_gaming.sh"
# shellcheck source=/dev/null
[ -f "${APP_DIR}/mod_gnomes_engine.sh" ] && source "${APP_DIR}/mod_gnomes_engine.sh"
# shellcheck source=/dev/null
[ -f "${APP_DIR}/mod_docs.sh" ] && source "${APP_DIR}/mod_docs.sh"

if [ -f "${SCRIPT_DIR}/../lib/slacky_update_i18n.py" ]; then
    I18N_PY="${SCRIPT_DIR}/../lib/slacky_update_i18n.py"
elif [ -f "/usr/share/slacky-update/lib/slacky_update_i18n.py" ]; then
    I18N_PY="/usr/share/slacky-update/lib/slacky_update_i18n.py"
else
    I18N_PY="${SCRIPT_DIR}/../lib/slacky_update_i18n.py"
fi

# Initialize hardware detection globally (for both interactive and headless/batch modes)
probe_gpu_hardware

if [ -f "${SCRIPT_DIR}/../lib/check_backend.sh" ]; then
    CHECK_BIN="${SCRIPT_DIR}/../lib/check_backend.sh"
elif [ -f "/usr/share/slacky-update/lib/check_backend.sh" ]; then
    CHECK_BIN="/usr/share/slacky-update/lib/check_backend.sh"
else
    CHECK_BIN="${SCRIPT_DIR}/../lib/check_backend.sh"
fi

_() {
    python3 "$I18N_PY" "$@"
}

set_terminal_title "slacky-update v${CURRENT_VERSION}"

INTERACTIVE_SESSION=0

cleanup_on_exit() {
    local exit_code=$?
    if [ -f "/tmp/slacky-update-running.lock" ]; then
        local lpid
        lpid=$(cat "/tmp/slacky-update-running.lock" 2>/dev/null || echo "")
        if [ "${lpid}" = "$$" ]; then
            rm -f "/tmp/slacky-update-running.lock" 2>/dev/null || true
        fi
    fi
    if [ -t 1 ]; then
        printf "\033]0;\007\033]2;\007\033]30;\007" 2>/dev/null || true
    fi
    if [ "${INTERACTIVE_SESSION}" -eq 1 ] && [ -t 0 ] && [ "${exit_code}" -ne 0 ]; then
        echo ""
        read -r -p "$(_ PRESS_ENTER_EXIT)" || true
    fi
}
trap cleanup_on_exit EXIT

# --- [ STATUS SUMMARY DISPLAY ] ---
display_pending_status() {
    python3 - "${SCRIPT_DIR}/../lib" << 'PYSTATUS'
import json, sys, os, shutil
sys.path.insert(0, "/usr/share/slacky-update/lib")
if len(sys.argv) > 1 and os.path.exists(sys.argv[1]):
    sys.path.insert(0, os.path.abspath(sys.argv[1]))
try:
    from slacky_update_i18n import _
except ImportError:
    def _(k, **kw): return k

candidates = ["/var/cache/slacky-update/status.json", os.path.expanduser("~/.cache/slacky-update/status.json")]
sudo_u = os.environ.get("SUDO_USER")
if sudo_u:
    try:
        candidates.append(os.path.expanduser(f"~{sudo_u}/.cache/slacky-update/status.json"))
    except Exception:
        pass

data = None
best_ts = -1
for c in candidates:
    if os.path.exists(c):
        try:
            with open(c, "r", encoding="utf-8") as f:
                cand_data = json.load(f)
                ts = float(cand_data.get("last_check_ts", os.path.getmtime(c)))
                if ts > best_ts:
                    best_ts = ts
                    data = cand_data
        except Exception:
            pass

if data is None:
    sys.exit(0)

hdr = _("CLI_UPDATES_HEADER")
print(f"\033[1;36m{hdr}\033[0m")

def print_cat(title, items):
    if not items:
        return
    count_str = f" ({len(items)})" if len(items) > 1 else ""
    print(f"\033[1;33m{title}{count_str}:\033[0m")
    term_width = shutil.get_terminal_size((80, 24)).columns
    if len(items) > 10:
        max_item_len = max(len(it) for it in items)
        col_width = max_item_len + 5
        num_cols = max(1, min(3, term_width // col_width))
        if num_cols >= 2:
            num_rows = (len(items) + num_cols - 1) // num_cols
            for r in range(num_rows):
                row_parts = []
                for c in range(num_cols):
                    idx = c * num_rows + r
                    if idx < len(items):
                        item = items[idx]
                        entry = f"  \033[32m•\033[0m {item}"
                        pad = " " * (col_width - (len(item) + 4))
                        row_parts.append(f"{entry}{pad}")
                print("".join(row_parts).rstrip())
            return
    for item in items:
        print(f"  \033[32m•\033[0m {item}")

print_cat(_("CAT_SLACKWARE"), data.get("slackware_updates", []))
print_cat(_("CAT_SLACKPKGPLUS"), data.get("slackpkgplus_updates", []))
print_cat(_("CAT_SLACKWARE_NEW"), data.get("slackware_new_packages", []))
print_cat(_("CAT_FLATPAK"), data.get("flatpak_updates", []))
print_cat(_("CAT_SBO"), data.get("sbo_updates", []))
print_cat(_("CAT_KERNEL"), data.get("cachyos_kernel_updates", []))
print_cat(_("CAT_GAMING"), data.get("cachyos_gaming_updates", []))
print_cat(_("CAT_GNOMES"), data.get("gnomes_updates", []))
print_cat(_("CAT_NVIDIA"), data.get("nvidia_driver_updates", []))

if data.get("nvidia_gl_mismatch", False):
    print("\033[1;31m• " + _("NVIDIA_SYNC_FAIL") + "\033[0m")

sb = data.get("secure_boot", {})
if sb.get("state") == "enabled":
    for w in sb.get("warnings", []):
        print(f"\033[1;31m• Secure Boot Warning: {w}\033[0m")

# 6A-298 (N0/N1): "up to date" is only said when everything was really checked. A part that could not be checked is
# named in one sentence; with no network at all there is one plain offline sentence instead.
import time as _time
_PART_NAMES = {"slackware": "Slackware", "slackpkgplus": "extra Slackware repositories", "flatpak": "Flatpak",
               "sbo": "SlackBuilds", "cachyos_kernel": "CachyOS kernels", "cachyos_gaming": "gaming apps",
               "gnomes": "Underpants apps", "nvidia": "NVIDIA driver"}
_failed = [x for x in (data.get("check_failed") or []) if isinstance(x, str)]
_offline = bool(data.get("check_offline", False))
def _msg(key, default):
    try:
        v = _(key)
    except Exception:
        return default
    return default if (not v or v == key) else v
_last_ok = 0
try:
    _last_ok = int(data.get("last_ok_check_ts", 0) or 0)
except Exception:
    _last_ok = 0
if _offline:
    _txt = _msg("CHECK_OFFLINE", "No internet connection, so nothing was checked; the list shows the last known state")
    if _last_ok > 0:
        _txt += " (" + _time.strftime("%Y-%m-%d %H:%M", _time.localtime(_last_ok)) + ")"
    print("\033[1;33m" + _txt + ".\033[0m")
elif _failed:
    _names = ", ".join(_PART_NAMES.get(x, x) for x in _failed)
    print("\033[1;33m" + _msg("CHECK_COULD_NOT", "Could not check") + ": " + _names + ".\033[0m")

total = len(data.get("slackware_updates", [])) + len(data.get("slackpkgplus_updates", [])) + len(data.get("slackware_new_packages", [])) + len(data.get("flatpak_updates", [])) + len(data.get("sbo_updates", [])) + len(data.get("cachyos_kernel_updates", [])) + len(data.get("cachyos_gaming_updates", [])) + len(data.get("gnomes_updates", [])) + len(data.get("nvidia_driver_updates", []))
if total == 0 and not data.get("nvidia_gl_mismatch", False) and not _failed and not _offline:
    print("\033[1;32m" + _("NO_PENDING_UPDATES") + "\033[0m")
print("")
PYSTATUS
}

# --- [ FULL SYSTEM UPDATE TRANSACTION ] ---
get_full_pkg_snapshot_file() {
    local target_file="$1"
    ls /var/log/packages 2>/dev/null | sort > "${target_file}" || true
    # 6A-267: the kernel module directories travel in the same file (MOD: lines); the reboot decision needs them
    ls /lib/modules 2>/dev/null | sort | sed 's/^/MOD:/' >> "${target_file}" || true
}

# 6A-267: why a restart is wanted. Prints one concrete sentence per reason, nothing when nothing in use changed.
# Rules: docs/reboot_rules.md. $1/$2 = snapshot files before/after; SLACKY_RUNNING_RELEASE overrides uname -r (tests).
slacky_reboot_reasons() {
    SLACKY_RUNNING_RELEASE="${SLACKY_RUNNING_RELEASE:-$(uname -r)}" python3 - "$1" "$2" << 'PYREBOOT' 2>/dev/null || true
import sys, os, re

def load(path):
    pk, md = set(), set()
    with open(path, 'r', encoding='utf-8', errors='ignore') as f:
        for line in f:
            line = line.strip()
            if not line:
                continue
            (md if line.startswith('MOD:') else pk).add(line[4:] if line.startswith('MOD:') else line)
    return pk, md

def parse_release(rel):
    # 7.2.10-1-cachyos-bore -> ((7,2,10), rc, 1, 'cachyos-bore'); 6.18.52 -> flavor None
    parts = rel.split('-')
    try:
        ver = tuple(int(n) for n in parts[0].split('.'))
    except ValueError:
        return None
    rest = parts[1:]
    rc = None
    for t in rest:
        m = re.fullmatch(r'rc(\d+)', t)
        if m:
            rc = int(m.group(1))
    rel_at = next((i for i, t in enumerate(rest) if t.isdigit()), None)
    if rel_at is None:
        return (ver, rc, 0, None)
    flavor = '-'.join(rest[rel_at + 1:]) or None
    return (ver, rc, int(rest[rel_at]), flavor)

def order_key(r):
    return (r[0], 10**9 if r[1] is None else r[1], r[2])

def pkg_version(entry):
    f = entry.rsplit('-', 3)
    return f[-3] if len(f) == 4 else None

def is_running_kernel_pkg(entry, running):
    low = entry.lower()
    if not low.startswith('kernel-') or low.startswith(('kernel-headers', 'kernel-source', 'kernel-firmware', 'kernel-docs')):
        return False
    v = pkg_version(entry)
    return v is not None and running in (v, v + '-smp')

try:
    b_pk, b_md = load(sys.argv[1])
    a_pk, a_md = load(sys.argv[2])
    running = os.environ.get('SLACKY_RUNNING_RELEASE', '')
    reasons = []
    def add(r):
        if r not in reasons:
            reasons.append(r)

    for p in sorted(a_pk - b_pk):
        if p.startswith('glibc-zoneinfo'):
            continue
        if p.startswith(('glibc-solibs', 'glibc-2', 'glibc-3')):
            add(f"Core C library updated ({p})")
        elif 'mesa-' in p or p.startswith('mesa'):
            add(f"Mesa graphics / Vulkan driver updated ({p})")
        elif 'nvidia' in p:
            add(f"NVIDIA graphics driver suite updated ({p})")
        elif any(kw in p for kw in ['plasma-', 'kwin-', 'sddm-', 'wayland-']):
            add(f"Display server / Desktop environment updated ({p})")
        elif running and is_running_kernel_pkg(p, running):
            add(f"The running kernel package was replaced ({p})")

    if running:
        for p in sorted(b_pk - a_pk):
            if is_running_kernel_pkg(p, running):
                add(f"The running kernel package was replaced or removed ({p})")
        cur = parse_release(running)
        if cur and cur[3]:
            newer = []
            for m in a_md - b_md:
                k = parse_release(m)
                if k and k[3] == cur[3] and order_key(k) > order_key(cur):
                    newer.append((order_key(k), m))
            if newer:
                add(f"The running kernel ({cur[3]}) was updated to {max(newer)[1]}")
        if running in b_md and running not in a_md:
            add(f"The modules of the running kernel ({running}) were removed")
    for r in reasons:
        print(r)
except Exception:
    pass
PYREBOOT
}

get_kernel_driver_snapshot() {
    python3 -c "
import os
pkgs = os.listdir('/var/log/packages') if os.path.exists('/var/log/packages') else []
# 6A-61: kernel-headers / kernel-source are userspace/build files; they need no initramfs, signing or restart
k_pkgs = sorted([p for p in pkgs if p.startswith(('kernel-', 'linux-', 'nvidia')) and not p.startswith(('kernel-headers', 'kernel-source'))])
print(';'.join(k_pkgs))
" 2>/dev/null || echo ""
}

prompt_reboot_or_close() {
    local snap_before_file="$1"
    local snap_after_file="$2"
    local force_flag="${3:-0}"   # unused since 6A-267 (kept so the callers stay as they are)

    # SpiderSense phase 1 (spec 9): after a refused/failed boot chain there is no restart offer and the exit code is 30
    if [ "${SLACKY_BOOT_CHAIN_FAILED:-0}" = "1" ]; then
        rm -f "${snap_before_file}" "${snap_after_file}" 2>/dev/null || true
        echo ""
        echo -e "${RED}${BOLD}The startup menu could not be updated safely, so do not restart yet. Run: sudo slacky-update --sync-boot${RESET}"
        exit 30
    fi

    # 6A-267: ${force_flag} (boot chain ran) is accepted but no longer forces the advice; only a change of what runs now does
    local needs_reboot=0
    # 6A-281: after a run where a step did not finish: no success line and exit code 20
    local final_rc=0
    [ "${SLACKY_RUN_PARTIAL:-0}" = "1" ] && final_rc=20

    local reboot_reasons=()
    if [ -f "${snap_before_file}" ] && [ -f "${snap_after_file}" ]; then
        local reasons_raw
        reasons_raw=$(slacky_reboot_reasons "${snap_before_file}" "${snap_after_file}")
        if [ -n "${reasons_raw}" ]; then
            needs_reboot=1
            mapfile -t reboot_reasons <<< "${reasons_raw}"
        fi
    fi
    rm -f "${snap_before_file}" "${snap_after_file}" 2>/dev/null || true

    if [ "${NON_INTERACTIVE:-0}" = "1" ] || [ ! -t 0 ]; then
        if [ "${needs_reboot}" -eq 1 ]; then
            echo ""
            echo -e "${YELLOW}${BOLD}$(_ REBOOT_RECOMMENDED_TITLE)${RESET}"
            if [ ${#reboot_reasons[@]} -gt 0 ]; then
                echo -e "\033[1;36mDetected system components triggering this recommendation:\033[0m"
                for r in "${reboot_reasons[@]}"; do
                    [ -n "${r}" ] && echo -e "  • ${r}"
                done
            else
                echo -e "$(_ REBOOT_RECOMMENDED_DESC)"
            fi
            log_info "Non-interactive mode: Reboot deferred. Please reboot when convenient."
            # 6A-307: the final line is the last line of a successful run
            if [ "${final_rc}" -eq 0 ]; then
                echo -e "${GREEN}${BOLD}All updates are completed${RESET}"
            fi
        elif [ "${final_rc}" -eq 0 ]; then
            echo ""
            echo -e "${GREEN}${BOLD}All updates are completed${RESET}"
        fi
        exit "${final_rc}"
    fi

    if [ "${needs_reboot}" -eq 1 ]; then
        echo ""
        echo -e "${YELLOW}${BOLD}$(_ REBOOT_RECOMMENDED_TITLE)${RESET}"
        if [ ${#reboot_reasons[@]} -gt 0 ]; then
            echo -e "\033[1;36mDetected system components triggering this recommendation:\033[0m"
            for r in "${reboot_reasons[@]}"; do
                [ -n "${r}" ] && echo -e "  • ${r}"
            done
        else
            echo -e "$(_ REBOOT_RECOMMENDED_DESC)"
        fi
        echo ""
        read_update_prompt "$(_ PROMPT_REBOOT_NOW)" "N" reply_reboot
        if [[ "$reply_reboot" =~ ^([YyJjSsOo]|[Yy][Ee][Ss]|[Jj][Aa])$ ]]; then
            echo ""
            [ "${final_rc}" -eq 0 ] && echo -e "${GREEN}${BOLD}All updates are completed${RESET}"
            echo -e "${CYAN}${BOLD}$(_ REBOOTING_IN_5S)${RESET}"
            for i in 5 4 3 2 1; do
                echo -n -e "${YELLOW}${BOLD}${i}... ${RESET}"
                sleep 1
            done
            echo ""
            log_info "Initiating system reboot..."
            sudo "${REBOOT_CMD}"
            exit "${final_rc}"
        fi
        [ "${final_rc}" -eq 0 ] && echo -e "${GREEN}${BOLD}All updates are completed${RESET}"
    else
        if [ "${final_rc}" -eq 0 ]; then
            echo ""
            echo -e "${GREEN}${BOLD}All updates are completed${RESET}"
        fi
        read -r -p "$(_ PRESS_ENTER_TO_CLOSE)" || true
    fi
    exit "${final_rc}"
}

run_full_update() {
    echo -e "\n${CYAN}$(_ VALIDATING_ADMIN)${RESET}"
    validate_privileges
    # 6A-89: the sudo ticket stays valid for the whole run
    start_sudo_keepalive

    run_preflight_check 0

    # 6A-47: run lock in /run/lock (flock, released on exit) instead of a PID file in /tmp
    acquire_run_lock || return 1
    # 6A-93: report a previous run that was cut off (this run then finishes its work)
    ss_tx_check_interrupted || ss_mark_if_limine   # 6A-147: the marker means "reseal Limine"; nothing to do elsewhere
    # 6A-95: our snapshots never live past 48 hours (before this run makes new ones)
    ss_prune_our_snapshots
    # 6A-117: what hardware is in this machine now, and what changed since boot / the last run
    ss_hw_check

    export DEFER_BOOT_SYNC=1
    export SLACKY_UPDATE_RUNNING=1
    # 6A-102: the boot lock is taken when the boot-chain step starts (below), not here. Nothing writes the live boot
    # files before that step any more (6A-97/98/99/101), the hourly job waits for the run lock, and holding the boot
    # lock for the whole run made limine-snapper-sync time out and write the menu without it.

    local slack_done=0
    local cachy_done=0
    local flatpak_done=0
    local sbo_done=0
    local gaming_done=0
    local gnomes_done=0
    local nvidia_done=0

    local snap_before_file snap_after_file
    snap_before_file=$(mktemp /tmp/slacky-snap-before.XXXXXX)
    snap_after_file=$(mktemp /tmp/slacky-snap-after.XXXXXX)
    get_full_pkg_snapshot_file "${snap_before_file}"

    local k_snap_before k_snap_after
    k_snap_before=$(get_kernel_driver_snapshot)

    local boot_snap_before boot_snap_after
    boot_snap_before=$(ls -1 /boot/vmlinuz* /boot/initrd* /boot/limine*.efi /boot/EFI/*/*.efi 2>/dev/null || true)
    local kernel_or_driver_changed=0
    export SLACKY_LIMINE_SEALED=0

    local is_headless=0
    if [ "${NON_INTERACTIVE:-0}" = "1" ] || [ ! -t 0 ]; then
        is_headless=1
    fi

    local slack_count plus_count new_count total_slack_pkgs
    slack_count=$(get_status_key_count "slackware_updates")
    plus_count=$(get_status_key_count "slackpkgplus_updates")
    new_count=$(get_status_key_count "slackware_new_packages")
    total_slack_pkgs=$(( slack_count + plus_count + new_count ))

    local cachy_count
    cachy_count=$(get_status_key_count "cachyos_kernel_updates")

    local flatpak_count=0
    local nvidia_mismatch="false"
    if command -v flatpak >/dev/null 2>&1; then
        flatpak_count=$(get_status_key_count "flatpak_updates")
        # status-cache split: the newest status.json of the user cache and /var wins (get_status_key_count does that)
        if [ "$(get_status_key_count "nvidia_gl_mismatch")" != "0" ]; then
            nvidia_mismatch="true"
        fi
    fi

    local sbo_count=0
    if is_sbotools_installed; then
        sbo_count=$(get_status_key_count "sbo_updates")
    fi

    local gaming_count=0
    if command -v sync_all_installed_cachyos_gaming_packages >/dev/null 2>&1; then
        gaming_count=$(get_status_key_count "cachyos_gaming_updates")
    fi

    local gnomes_count=0
    if [ -f "${APP_DIR}/gnomes_pacman.py" ]; then
        gnomes_count=$(python3 "${APP_DIR}/gnomes_pacman.py" list-updates --count 2>/dev/null || echo "0")
    fi

    local nv_count=0
    if [ "${HAS_NVIDIA}" = "true" ] && [ "$(has_cachyos_kernels_installed 2>/dev/null || echo false)" != "true" ]; then
        nv_count=$(get_status_key_count "nvidia_driver_updates")
    fi

    local active_suites=0
    [ "${total_slack_pkgs}" -gt 0 ] && active_suites=$(( active_suites + 1 ))
    [ "${cachy_count}" -gt 0 ] && active_suites=$(( active_suites + 1 ))
    { [ "${flatpak_count}" -gt 0 ] || [ "${nvidia_mismatch}" = "true" ]; } && active_suites=$(( active_suites + 1 ))
    [ "${sbo_count}" -gt 0 ] && active_suites=$(( active_suites + 1 ))
    [ "${gaming_count}" -gt 0 ] && active_suites=$(( active_suites + 1 ))
    [ "${gnomes_count}" -gt 0 ] && active_suites=$(( active_suites + 1 ))
    [ "${nv_count}" -gt 0 ] && active_suites=$(( active_suites + 1 ))

    # 9C: a package of the Slackware update set that has a folder replaced by a link is held BEFORE anything changes
    # (detect only: one sentence with the exact command; nothing is repaired, renamed or asked)
    if [ "${total_slack_pkgs}" -gt 0 ]; then
        local heal_helper hold_rc=0
        if heal_helper=$(slacky_find_helper slacky_heal.py); then
            python3 -I "${heal_helper}" hold --from-status || hold_rc=$?
            if [ "${hold_rc}" -eq 30 ]; then
                exit 30
            fi
        fi
    fi

    local auto_approve_all=0
    if [ "${is_headless}" -eq 0 ] && [ "${active_suites}" -gt 1 ]; then
        echo ""
        echo -e "${CYAN}${BOLD}Full System Update plan (${active_suites} suites with pending updates):${RESET}"
        [ "${total_slack_pkgs}" -gt 0 ] && echo -e "  • Slackware Core & Multilib : ${total_slack_pkgs} package(s)"
        [ "${cachy_count}" -gt 0 ] && echo -e "  • CachyOS Kernels           : ${cachy_count} flavor update(s)"
        { [ "${flatpak_count}" -gt 0 ] || [ "${nvidia_mismatch}" = "true" ]; } && echo -e "  • Flatpak Runtimes & Apps   : ${flatpak_count} update(s)"
        [ "${sbo_count}" -gt 0 ] && echo -e "  • SlackBuilds (sbotools)    : ${sbo_count} package(s)"
        [ "${gaming_count}" -gt 0 ] && echo -e "  • CachyOS Gaming Suite      : ${gaming_count} package(s)"
        [ "${gnomes_count}" -gt 0 ] && echo -e "  • Underpants Gnomes Apps    : ${gnomes_count} package(s)"
        [ "${nv_count}" -gt 0 ] && echo -e "  • NVIDIA Driver Suite       : ${nv_count} update(s)"
        echo ""
        local reply_batch="Y"
        read_update_prompt "Apply all pending updates in a single automated pass? [Y/n/c(ustom)]: " "Y" reply_batch
        if [[ "${reply_batch}" =~ ^[YyJjSsOo]$ ]]; then
            auto_approve_all=1
            echo -e "${GREEN}Automated batch upgrade engaged.${RESET}\n"
        else
            echo -e "${CYAN}:: Interactive step-by-step confirmation engaged.${RESET}\n"
        fi
    fi

    begin_atomic_transaction "Full System Upgrade"
    # 6A-102: Ctrl-C / TERM become a stop request that never leaves the boot chain half done
    ss_arm_abort_handler

    # SpiderSense phase 1 (spec 4.4): pre-update snapshot after consent, before the first change. If it fails, kernel,
    # graphics driver and boot chain wait (they are what a snapshot protects most); the Slackware base still updates.
    local ss_hold_boot=0
    local ss_failed=""   # 6A-146 (verifier MAJOR-2): suites that did not finish stay pending and are named at the end
    if [ "${active_suites}" -gt 0 ]; then
        local snap_rc=0
        create_pre_update_snapshot || snap_rc=$?
        if [ "${snap_rc}" -eq 1 ]; then
            ss_hold_boot=1
            # 6A-300 (M7): the Slackware kernel packages wait as well (update_slackware_core reads this)
            export SLACKY_HOLD_STOCK_KERNEL=1
            log_warn "A safety snapshot could not be created, so kernel (including the Slackware kernel) and graphics driver updates wait until next time; everything else updates now."
        fi
    fi
    # 6A-88: a separate /boot that is not mounted read-write -> kernel, driver and boot menu wait (they would land in the
    # wrong place); everything else updates
    local ss_boot_unready=0
    if ! ss_boot_ready; then
        ss_boot_unready=1
        export SLACKY_BOOT_UNREADY=1
        ss_hold_boot=1
        log_warn "The boot partition (/boot) is not mounted for writing, so kernel and graphics driver updates and the boot menu wait; everything else updates now."
    fi
    # 6A-202: signing keys first (a staged, re-verified keyring is installed before any package is checked or installed)
    if command -v slacky_keys_first >/dev/null 2>&1; then
        slacky_keys_first || true
    fi
    # 6A-93: journal (a cut-off run is reported next time)
    ss_tx_mark started-packages

    if [ "${total_slack_pkgs}" -gt 0 ] && ss_continue; then
        local reply_slack="Y"
        if [ "${is_headless}" -eq 0 ] && [ "${auto_approve_all}" -eq 0 ]; then
            read_update_prompt "$(_ PROMPT_UPGRADE_SLACKWARE)" "Y" reply_slack
        fi
        if [[ "$reply_slack" =~ ^[YyJjSsOo]$ ]]; then
            echo -e "\n${BLUE}${BOLD}$(_ UPGRADING_SLACKWARE)${RESET}"
            local sc_ret=0
            update_slackware_core || sc_ret=$?
            # 6A-146 (LTS B2): a Slackware kernel changed -> the boot chain must run; mark it now so a run that is cut
            # off later is still repaired by the hourly check
            if [ "$(get_kernel_driver_snapshot)" != "${k_snap_before}" ]; then
                kernel_or_driver_changed=1
                ss_mark_if_limine
            fi
            if [ "${sc_ret}" -eq 0 ]; then
                slack_done=1
            elif [ "${sc_ret}" -eq 2 ]; then
                slack_done=2
                ss_failed+=" slackware"      # 6A-281: waiting (mirror, space, /boot); not finished, so no success line
            else
                # 6A-281: return codes 1 and 3 (slackpkg missing, errors during the upgrade) are failures too
                ss_failed+=" slackware"
            fi
        fi
    else
        log_info "$(_ SLACKWARE_CORE_UP_TO_DATE)"
    fi

    if [ "${cachy_count}" -gt 0 ] && [ "${ss_hold_boot}" -eq 0 ] && ss_continue; then
        local reply_cachy="Y"
        if [ "${is_headless}" -eq 0 ] && [ "${auto_approve_all}" -eq 0 ]; then
            read_update_prompt "$(_ PROMPT_INSTALL_CACHY_KERNEL)" "Y" reply_cachy
        fi
        if [[ "$reply_cachy" =~ ^[YyJjSsOo]$ ]]; then
            echo -e "\n${BLUE}${BOLD}$(_ UPGRADING_CACHYOS_KERNEL)${RESET}"
            # 6A-146: a failed suite never ends the run before the boot chain
            update_cachyos_kernels || { log_warn "The CachyOS kernel update did not finish; the boot menu is still checked below."; ss_failed+=" cachyos"; }
            kernel_or_driver_changed=1
            [[ "${ss_failed}" == *" cachyos"* ]] || cachy_done=1
        fi
    fi

    if command -v flatpak >/dev/null 2>&1 && ss_continue; then
        if [ "${flatpak_count}" -gt 0 ] || [ "${nvidia_mismatch}" = "true" ]; then
            local reply_flatpak="Y"
            if [ "${is_headless}" -eq 0 ] && [ "${auto_approve_all}" -eq 0 ]; then
                read_update_prompt "$(_ PROMPT_UPGRADE_FLATPAK)" "Y" reply_flatpak
            fi
            if [[ "$reply_flatpak" =~ ^[YyJjSsOo]$ ]]; then
                echo -e "\n${BLUE}${BOLD}$(_ UPGRADING_FLATPAK)${RESET}"
                update_flatpaks || { log_warn "The Flatpak update did not finish; the other updates continue."; ss_failed+=" flatpak"; }
                if [ "${nvidia_mismatch}" = "true" ]; then
                    local act_nv
                    act_nv=$(cat /sys/module/nvidia/version 2>/dev/null || head -n 1 /proc/driver/nvidia/version 2>/dev/null | awk '{print $8}' || true)
                    register_flatpak_gl_sync "${act_nv}"
                fi
                [[ "${ss_failed}" == *" flatpak"* ]] || flatpak_done=1
            fi
        fi
    fi

    if is_sbotools_installed && ss_continue; then
        if [ "${sbo_count}" -gt 0 ]; then
            local reply_sbo="Y"
            if [ "${is_headless}" -eq 0 ] && [ "${auto_approve_all}" -eq 0 ]; then
                read_update_prompt "$(_ PROMPT_UPGRADE_SBO)" "Y" reply_sbo
            fi
            if [[ "$reply_sbo" =~ ^[YyJjSsOo]$ ]]; then
                update_sbo_packages || { log_warn "The SlackBuilds update did not finish; the other updates continue."; ss_failed+=" sbo"; }
                [[ "${ss_failed}" == *" sbo"* ]] || sbo_done=1
            fi
        fi
    fi

    if command -v sync_all_installed_cachyos_gaming_packages >/dev/null 2>&1 && ss_continue; then
        if [ "${gaming_count}" -gt 0 ]; then
            local reply_gaming="Y"
            if [ "${is_headless}" -eq 0 ] && [ "${auto_approve_all}" -eq 0 ]; then
                read_update_prompt "$(_ PROMPT_UPGRADE_GAMING)" "Y" reply_gaming
            fi
            if [[ "$reply_gaming" =~ ^[YyJjSsOo]$ ]]; then
                echo -e "\n${BLUE}${BOLD}$(_ UPGRADING_GAMING)${RESET}"
                sync_all_installed_cachyos_gaming_packages || { log_warn "Some curated app updates did not finish; the apps you had are kept."; ss_failed+=" gaming"; }
                [[ "${ss_failed}" == *" gaming"* ]] || gaming_done=1
            fi
        fi
    fi

    if [ -f "${APP_DIR}/gnomes_pacman.py" ] && ss_continue; then
        if [ "${gnomes_count}" -gt 0 ]; then
            local reply_gnomes="Y"
            if [ "${is_headless}" -eq 0 ] && [ "${auto_approve_all}" -eq 0 ]; then
                read_update_prompt "$(_ PROMPT_UPGRADE_GNOMES)" "Y" reply_gnomes
            fi
            if [[ "$reply_gnomes" =~ ^[YyJjSsOo]$ ]]; then
                echo -e "\n${BLUE}${BOLD}$(_ UPGRADING_GNOMES)${RESET}"
                local gnomes_json
                gnomes_json=$(python3 "${APP_DIR}/gnomes_pacman.py" list-updates --json 2>/dev/null || echo "[]")
                local g_targets=()
                while IFS= read -r gt; do
                    [ -n "${gt}" ] && g_targets+=("${gt}")
                done < <(python3 -c "import sys, json; [print(x['name']) for x in json.loads(sys.argv[1]) if 'name' in x]" "${gnomes_json}" 2>/dev/null || true)
                if [ ${#g_targets[@]} -gt 0 ]; then
                    if [ -x "${SCRIPT_DIR}/gnomes" ]; then
                        "${SCRIPT_DIR}/gnomes" -S --yes "${g_targets[@]}" || { log_warn "Some Gnomes app updates did not finish; the apps you had are kept."; ss_failed+=" gnomes"; }
                    elif command -v gnomes >/dev/null 2>&1; then
                        gnomes -S --yes "${g_targets[@]}" || { log_warn "Some Gnomes app updates did not finish; the apps you had are kept."; ss_failed+=" gnomes"; }
                    else
                        # 6A-50: private output dir, only packages this run built
                        local g_out
                        g_out=$(mktemp -d /tmp/gnomes-out-XXXXXX)
                        python3 "${APP_DIR}/gnomes_pacman.py" transmute "${g_targets[@]}" --yes --output-dir "${g_out}" \
                            || { log_warn "Some Gnomes app updates did not finish; the apps you had are kept."; ss_failed+=" gnomes"; }
                        for gt in "${g_targets[@]}"; do
                            local txz_cand=""
                            for f in "${g_out}"/underpants-"${gt}"-*.txz; do
                                [ -f "${f}" ] || continue
                                b="${f##*/}"; b="${b%.txz}"
                                [ "${b%-*-*-*}" = "underpants-${gt}" ] && txz_cand="${f}"
                            done
                            [ -n "${txz_cand}" ] && [ -f "${txz_cand}" ] && upgradepkg --install-new --reinstall "${txz_cand}" || true
                            for old_cg in /var/log/packages/cachyos-gnome-"${gt}"-*; do
                                # 6A-41: exact base name only
                                [ -f "${old_cg}" ] && [ "$(basename "${old_cg%-*-*-*}")" = "cachyos-gnome-${gt}" ] \
                                    && { removepkg "$(basename "${old_cg}")" >/dev/null 2>&1 || true; }
                            done
                        done
                        rm -rf "${g_out}"
                    fi
                    [[ "${ss_failed}" == *" gnomes"* ]] || gnomes_done=1
                fi
            fi
        fi
    fi

    if [ "${HAS_NVIDIA}" = "true" ] && [ "$(has_cachyos_kernels_installed 2>/dev/null || echo false)" != "true" ]; then
        # 6A-131: pre-Turing, nouveau or opted-out cards are left as they are (one plain line from the gate)
        if [ "${nv_count}" -gt 0 ] && [ "${ss_hold_boot}" -eq 0 ] && ss_continue && nvidia_generation_supported; then
            local reply_nv="Y"
            if [ "${is_headless}" -eq 0 ] && [ "${auto_approve_all}" -eq 0 ]; then
                read_update_prompt "$(_ PROMPT_UPGRADE_NVIDIA_DRIVER)" "Y" reply_nv
            fi
            if [[ "$reply_nv" =~ ^[YyJjSsOo]$ ]]; then
                install_nvidia_run_driver "production" || { log_warn "The NVIDIA driver update did not finish; the boot menu is still checked below."; ss_failed+=" nvidia"; }
                kernel_or_driver_changed=1
                [[ "${ss_failed}" == *" nvidia"* ]] || nvidia_done=1
            fi
        fi
    fi

    k_snap_after=$(get_kernel_driver_snapshot)
    get_full_pkg_snapshot_file "${snap_after_file}"

    boot_snap_after=$(ls -1 /boot/vmlinuz* /boot/initrd* /boot/limine*.efi /boot/EFI/*/*.efi 2>/dev/null || true)
    if [ "${boot_snap_before}" != "${boot_snap_after}" ]; then
        kernel_or_driver_changed=1
    fi
    if [ "${k_snap_before}" != "${k_snap_after}" ]; then
        kernel_or_driver_changed=1
    fi

    # 6A-97/6A-99/6A-100: boot orders recorded during the run (images, a new Limine or sbctl, a curated DKMS module)
    if [ "${#SS_INITRD_ORDERS[@]}" -gt 0 ] || [ "${SS_MENU_ORDER:-0}" = "1" ]; then
        kernel_or_driver_changed=1
    fi
    local ss_dkms_pending=0
    if [ -f /var/cache/slacky-update/dkms-build-pending ]; then
        ss_dkms_pending=1
        kernel_or_driver_changed=1
    fi

    local ss_chain_skipped=0
    if [ "${kernel_or_driver_changed}" -eq 1 ] && [ "${ss_boot_unready}" -eq 1 ]; then
        # 6A-88: never write kernels, initramfs or the menu behind an unmounted /boot; the next run or the hourly check does it
        ss_mark_if_limine
        log_warn "The boot menu was not updated because /boot is not mounted. Do not restart until /boot is mounted and you have run: sudo slacky-update --sync-boot"
        kernel_or_driver_changed=0
        ss_chain_skipped=1
        export SLACKY_BOOT_CHAIN_FAILED=1
    fi

    # 6A-102: G0. The boot-chain step takes the boot lock now; a stop request waits until the step is done
    local ss_chain_locked=0
    if [ "${kernel_or_driver_changed}" -eq 1 ]; then
        SS_BOOT_COMMIT=1
        if acquire_boot_lock; then
            ss_chain_locked=1
        else
            ss_mark_if_limine
            SLACKY_BOOT_CHAIN_FAILED=1
        fi
    fi

    if [ "${ss_chain_locked}" -eq 1 ]; then
        ss_tx_mark started-boot-chain
        local active_kver
        active_kver=$(uname -r)
        # 6A-98: this commit builds the menu from the kernels that stay; the old ones are removed after it (F1)
        export SS_KEEP_SET_MENU=1

        echo ""
        log_info "Post-Upgrade Hardening & Bootloader Matrix:"

        # 6A-100: a curated DKMS module that was only registered during the run is built once here, before the images
        if [ "${ss_dkms_pending}" -eq 1 ] && command -v build_dkms_modules_for_all_kernels >/dev/null 2>&1; then
            build_dkms_modules_for_all_kernels >/dev/null 2>&1 || true
            sudo rm -f /var/cache/slacky-update/dkms-build-pending 2>/dev/null || true
        fi

        # [1/5] NVIDIA Driver & DKMS Modules
        # 6A-44: every status line reports the real result (was always green, with a hard-coded fallback version)
        local nv_status="Up to date" nv_color="${GREEN}"
        if [ "${HAS_NVIDIA}" = "true" ] && ! nvidia_generation_supported >/dev/null 2>&1; then
            # 6A-131: not managed by slacky-update (older than Turing, nouveau, or switched off by the user)
            nv_status="Left as it is (not managed by slacky-update)"; nv_color="${YELLOW}"
        elif [ "${HAS_NVIDIA}" = "true" ] && [ "$(has_cachyos_kernels_installed 2>/dev/null || echo false)" = "true" ]; then
            if command -v ensure_cachyos_nvidia_duties >/dev/null 2>&1; then
                local cachy_nv_ver=""
                if ls /var/log/packages/cachyos-nvidia-utils-* 1>/dev/null 2>&1; then
                    cachy_nv_ver=$(basename "$(ls /var/log/packages/cachyos-nvidia-utils-* 2>/dev/null | head -n 1)" | sed -E 's/cachyos-nvidia-utils-([0-9]+\.[0-9]+(\.[0-9]+)?).*/\1/' || true)
                fi
                if ensure_cachyos_nvidia_duties >/dev/null 2>&1; then
                    nv_status="Up to date${cachy_nv_ver:+ (v${cachy_nv_ver})}"
                else
                    nv_status="Could not confirm the graphics driver for every kernel (see the log)"; nv_color="${YELLOW}"
                fi
            fi
        elif [ "${HAS_NVIDIA}" = "true" ]; then
            # 6A-133 (M6): every kept kernel, not only the running one
            if build_nvidia_modules "ALL" >/dev/null 2>&1; then
                nv_status="Synchronized for every kernel"
            else
                nv_status="FAILED for at least one kernel - the screen may stay black on it (see the log)"; nv_color="${RED}"
            fi
        else
            nv_status="Up to date (Non-NVIDIA)"
        fi
        echo -e "  \033[1;36m[1/5]\033[0m \033[1mNVIDIA Driver & DKMS Modules\033[0m : ${nv_color}${nv_status}${RESET}"

        # 6A-98: obsolete kernels are no longer removed here (before the new menu); see F1 below

        # [2/5] Secure Boot MOK Signing
        local mok_status="Skipped"
        if command -v enforce_secure_boot_armor >/dev/null 2>&1; then
            local mok_out
            mok_out=$(enforce_secure_boot_armor --pipeline 2>/dev/null || true)
            if [ -n "${mok_out}" ]; then
                mok_status="${mok_out}"
            fi
        fi
        local mok_color="${GREEN}"
        case "${mok_status}" in "Could not sign"*) mok_color="${YELLOW}" ;; esac
        echo -e "  \033[1;36m[2/5]\033[0m \033[1mSecure Boot MOK Signing\033[0m      : ${mok_color}${mok_status}${RESET}"

        # [3/5] Dracut Initramfs Generation (prints its own status line; 6A-44: a failure is shown in red there)
        if command -v generate_kernel_initramfs >/dev/null 2>&1; then
            generate_kernel_initramfs "TARGETED_PIPELINE" || true
        fi
        # 6A-97: the orders recorded during the run are now built (once per kernel)
        SS_INITRD_ORDERS=()

        # [4/5] Secure Boot Kernel & Bootloader Pre-Signing (sbctl)
        local sb_status="Skipped (sbctl not active)" sb_color="${GREEN}"
        if command -v sign_kernel_binaries_sbctl >/dev/null 2>&1 && command -v is_sbctl_keys_configured >/dev/null 2>&1 \
            && is_sbctl_keys_configured; then
            if sign_kernel_binaries_sbctl >/dev/null 2>&1; then
                sb_status="Signed kernel binaries & verified Secure Boot state"
            else
                sb_status="Some kernels could not be signed (see the log)"; sb_color="${RED}"
            fi
        fi
        echo -e "  \033[1;36m[4/5]\033[0m \033[1mSecure Boot Kernel Signing\033[0m    : ${sb_color}${sb_status}${RESET}"
        # 6A-245: remember what the images were built from (after signing, so the signed kernel is the recorded one)
        command -v record_initramfs_inputs_all >/dev/null 2>&1 && record_initramfs_inputs_all || true

        # [5/5] Limine Config, BLAKE2B Hash Matrix & Bootloader Reseal
        local lim_installed=false
        if command -v is_limine_installed >/dev/null 2>&1 && [ "$(is_limine_installed)" = "true" ]; then
            lim_installed=true
            # 6A-8b: report the real result (was green "BLAKE2B enrolled & EFI signed" regardless)
            local seal_ok=1
            # 6A-8e: always regenerate + enroll here. An earlier seal in this run (SLACKY_LIMINE_SEALED) is stale once
            # [3/5] rewrote initramfs images and [4/5] re-signed the kernels; skipping left entries with wrong hashes.
            if command -v generate_limine_configuration >/dev/null 2>&1; then
                generate_limine_configuration >/dev/null 2>&1 || seal_ok=0
            fi
            if [ "${seal_ok}" -eq 1 ] && command -v enroll_and_sign_limine >/dev/null 2>&1; then
                enroll_and_sign_limine >/dev/null 2>&1 || seal_ok=0
            fi
            if [ "${seal_ok}" -eq 1 ] && command -v verify_limine_seal >/dev/null 2>&1; then
                verify_limine_seal || seal_ok=0
            fi
            if [ "${seal_ok}" -eq 1 ]; then
                echo -e "  \033[1;36m[5/5]\033[0m \033[1mLimine Matrix & Boot Sync\033[0m     : ${GREEN}BLAKE2B enrolled & EFI signed${RESET}"
            else
                echo -e "  \033[1;36m[5/5]\033[0m \033[1mLimine Matrix & Boot Sync\033[0m     : ${RED}FAILED - do not reboot; run: sudo slacky-update --sync-boot${RESET}"
                # SpiderSense phase 1 (spec 9): no restart offer, exit code 30
                SLACKY_BOOT_CHAIN_FAILED=1
            fi
        else
            echo -e "  \033[1;36m[5/5]\033[0m \033[1mLimine Matrix & Boot Sync\033[0m     : ${YELLOW}Skipped (Limine not active)${RESET}"
            command -v limine_unmanaged_notice >/dev/null 2>&1 && limine_unmanaged_notice || true   # 6A-122
            # 6A-133: LILO/ELILO are left alone; after a kernel change the user is told what to run
            [ "${kernel_or_driver_changed}" -eq 1 ] && command -v print_boot_loader_reminder >/dev/null 2>&1 && print_boot_loader_reminder || true
        fi
        # 6A-98 F1: remove obsolete kernels only now. With Limine only after the new menu was enrolled and verified
        # (a failed seal keeps them, the live menu may still list them); without Limine before the GRUB scan as before.
        # 6A-122 (verifier MAJOR-3): a Limine menu that slacky-update does not manage is never rewritten, so its kernels
        # are never removed underneath it
        local ss_unmanaged_menu=0
        if [ "${lim_installed}" != "true" ] && { [ -f /etc/default/limine ] || sudo test -f /boot/limine.conf 2>/dev/null; }; then
            ss_unmanaged_menu=1
        fi
        if [ "${ss_unmanaged_menu}" -eq 0 ] && { [ "${lim_installed}" != "true" ] || [ "${SLACKY_BOOT_CHAIN_FAILED:-0}" != "1" ]; }; then
            if command -v purge_old_slackware_kernels >/dev/null 2>&1; then
                purge_old_slackware_kernels --no-sync >/dev/null 2>&1 || true
            fi
            if command -v purge_old_cachyos_kernels >/dev/null 2>&1; then
                purge_old_cachyos_kernels --no-sync >/dev/null 2>&1 || true
            fi
        fi
        unset SS_KEEP_SET_MENU || true
        if command -v sync_grub_configuration >/dev/null 2>&1; then
            sync_grub_configuration >/dev/null 2>&1 || true
        fi
        # 6A-102: F2, the boot lock is released before the post snapshot (snapper's Limine plugin needs it)
        release_boot_lock
    elif [ "${kernel_or_driver_changed}" -eq 0 ] && [ "${ss_chain_skipped}" -eq 0 ]; then
        log_info "No kernel or driver changes detected. Skipping initramfs generation and signing."
    elif [ "${ss_chain_skipped}" -eq 0 ]; then
        # 6A-102: the lock wait timed out; prompt_reboot_or_close prints the "do not restart" line and exits 30
        log_warn "Another program was still changing the startup files, so this update could not finish them."
    fi
    SS_BOOT_COMMIT=0

    # 6A-93: everything above finished (a failed boot chain is reported separately and keeps its own marker)
    ss_tx_mark done
    ss_disarm_abort_handler
    end_atomic_transaction
    stop_sudo_keepalive
    unset DEFER_BOOT_SYNC || true
    unset SLACKY_UPDATE_RUNNING || true

    ss_wait_background_check   # 6A-150: the run's own background check first, then what this run updated
    reconcile_post_update_status "${slack_done}" "${cachy_done}" "${flatpak_done}" "${sbo_done}" "${gaming_done}" "${gnomes_done}" "${nvidia_done}"

    # SpiderSense phase 1: post snapshot paired with the pre snapshot ("undo this update")
    create_post_update_snapshot

    # 6A-102: a stop request ends the run here (the boot chain, if needed, has been completed above)
    if [ "${SS_ABORT:-0}" -gt 0 ]; then
        if [ "${SLACKY_BOOT_CHAIN_FAILED:-0}" = "1" ]; then
            prompt_reboot_or_close "${snap_before_file}" "${snap_after_file}" "${kernel_or_driver_changed}"
        fi
        rm -f "${snap_before_file}" "${snap_after_file}" 2>/dev/null || true
        if [ "${kernel_or_driver_changed}" -eq 1 ]; then
            echo -e "\n${YELLOW}The update was stopped early. The startup files are complete; run slacky-update again to install the rest.${RESET}"
        else
            echo -e "\n${YELLOW}The update was stopped early. The startup files were not changed; run slacky-update again to install the rest.${RESET}"
        fi
        exit 130
    fi

    python3 -c "
import os, json, time
kofi_file = os.path.expanduser('~/.config/slacky-update/kofi.json')
try:
    os.makedirs(os.path.dirname(kofi_file), exist_ok=True)
    d = {}
    if os.path.exists(kofi_file):
        with open(kofi_file, 'r', encoding='utf-8') as f:
            d = json.load(f)
    d['last_update_ts'] = time.time()
    with open(kofi_file, 'w', encoding='utf-8') as f:
        json.dump(d, f)
except Exception:
    pass
" 2>/dev/null || true

    if [ "${slack_done}" -eq 2 ]; then
        run_post_update_smoke_test "SKIPPED_MIRROR_ERROR"
    else
        run_post_update_smoke_test
    fi

    if [ "${is_headless}" -eq 0 ] && [ -f "${APP_DIR}/gnomes_pacman.py" ]; then
        local gnomes_cache_sz gnomes_cache_human
        gnomes_cache_sz=$(python3 -c "
import os
cache_dir = os.path.expanduser('~/.cache/slacky-update/gnomes/pkg')
total = 0
if os.path.isdir(cache_dir):
    for root, _, files in os.walk(cache_dir):
        for f in files:
            try:
                total += os.path.getsize(os.path.join(root, f))
            except Exception:
                pass
print(total)
" 2>/dev/null || echo "0")
        if [ "${gnomes_cache_sz}" -gt 10485760 ]; then # > 10 MB
            gnomes_cache_human=$(python3 -c "
b = int('${gnomes_cache_sz}')
if b >= 1024*1024*1024:
    print(f'{b/(1024*1024*1024):.1f} GB')
else:
    print(f'{b/(1024*1024):.1f} MB')
" 2>/dev/null || echo "0 MB")
            echo ""
            local reply_clean="n"
            # 6A-60: pass the size as the {0} argument the message expects (was printed raw)
            local clean_prompt
            clean_prompt="$(_ PROMPT_CLEAR_GNOMES_CACHE)"
            clean_prompt="${clean_prompt//\{0\}/${gnomes_cache_human}}"
            read_update_prompt "${clean_prompt} " "n" reply_clean
            if [[ "$reply_clean" =~ ^[YyJjSsOo]$ ]]; then
                python3 "${APP_DIR}/gnomes_pacman.py" clean-cache --all
            fi
        fi
    fi

    # 9C: after the update one sentence when installed packages are damaged (silent when clean; detect only)
    if [ "${slack_done}" -ne 0 ]; then
        local heal_helper_post
        if heal_helper_post=$(slacky_find_helper slacky_heal.py); then
            python3 -I "${heal_helper_post}" post || true
        fi
    fi

    if [ -n "${ss_failed}" ]; then
        # 6A-146: honest end; the unfinished parts stay listed and are offered again next time
        log_warn "Not everything was updated (${ss_failed# }); those updates stay listed and are tried again next time."
        SLACKY_RUN_PARTIAL=1     # 6A-281: no success line, exit code 20
    else
        : # 6A-307: success is reported by the final line "All updates are completed" printed last (prompt_reboot_or_close)
    fi

    prompt_reboot_or_close "${snap_before_file}" "${snap_after_file}" "${kernel_or_driver_changed}"
}

# --- [ CACHYOS KERNEL MANAGEMENT ROUTINE ] ---
manage_cachyos_kernel_interactive() {
    local tier
    tier=$(detect_cpu_tier)
    if [ "${tier}" = "znver4" ]; then
        log_info "CPU Architecture Tier: x86_64_v4 (znver4 - AMD Zen 4/5 Optimized)"
    elif [ "${tier}" = "v4" ]; then
        log_info "CPU Architecture Tier: x86_64_v4 (Intel/Generic AVX-512 Optimized)"
    elif [ "${tier}" = "v3" ]; then
        log_info "CPU Architecture Tier: x86_64_v3 (AVX2/FMA Optimized)"
    else
        log_info "CPU Architecture Tier: x86_64 (Generic Baseline)"
    fi

    local active_kver
    active_kver=$(uname -r)

    local installed_flavors
    installed_flavors=$(get_installed_cachyos_flavors)

    local tui_py="${SCRIPT_DIR}/../lib/slacky_tui.py"
    [ ! -f "${tui_py}" ] && [ -f "/usr/share/slacky-update/lib/slacky_tui.py" ] && tui_py="/usr/share/slacky-update/lib/slacky_tui.py"

    while true; do
        local kchoice=""
        if [ -f "${tui_py}" ] && command -v python3 >/dev/null 2>&1 && [ -t 0 ]; then
            kchoice=$(python3 "${tui_py}" --mode kernel-main)
        else
            echo ""
            echo -e "${CYAN}============================================================${RESET}"
            echo -e "${YELLOW}${BOLD}$(_ MENU_KERNEL)${RESET}"
            echo -e "${CYAN}============================================================${RESET}"
            
            if [ -n "${installed_flavors}" ]; then
                echo -e "${BOLD}Installed CachyOS Kernel Flavors:${RESET}"
                for flv in ${installed_flavors}; do
                    local cur_ver
                    cur_ver=$(get_installed_cachyos_flavor_version "${flv}")
                    echo -e "  • \033[1;32m${flv}\033[0m: v${cur_ver}"
                done
            else
                echo -e "${YELLOW}$(_ KERNEL_NOT_INSTALLED)${RESET}"
            fi

            echo ""
            echo -e "${BOLD}Actions:${RESET}"
            echo -e "  1. $(_ CACHY_MENU_UPGRADE_INSTALLED | sed -E 's/^[0-9]+\.\s*//')"
            echo -e "  2. $(_ CACHY_MENU_PICKER | sed -E 's/^[0-9]+\.\s*//')"
            echo -e "  3. $(_ CACHY_MENU_MANAGE_KERNELS | sed -E 's/^[0-9]+\.\s*//')"
            echo -e "  4. $(_ CACHY_MENU_REBUILD_ACTIVE active="${active_kver}" | sed -E 's/^[0-9]+\.\s*//')"
            echo -e "  5. $(_ MOK_OPTION_RETURN | sed -E 's/^[0-9]+\.\s*//')"
            echo ""
            echo -n "$(_ SELECT_OPERATION_RANGE range="1-5") "
            read -r kchoice || kchoice="5"
        fi

        case "${kchoice}" in
            1)
                echo ""
                if [ -z "${installed_flavors}" ]; then
                    log_warn "No CachyOS kernels currently installed. Use CachyOS Kernel Picker to install your first flavor!"
                    cachyos_kernel_picker_interactive
                    installed_flavors=$(get_installed_cachyos_flavors)
                else
                    update_cachyos_kernels
                fi
                echo ""
                read -r -p "$(_ PRESS_ENTER_CONTINUE)" || true
                ;;
            2)
                echo ""
                cachyos_kernel_picker_interactive
                installed_flavors=$(get_installed_cachyos_flavors)
                ;;
            3)
                echo ""
                manage_system_kernels_interactive
                installed_flavors=$(get_installed_cachyos_flavors)
                ;;
            4)
                echo ""
                validate_privileges
                generate_kernel_initramfs "${active_kver}"
                build_nvidia_modules "${active_kver}"
                enforce_secure_boot_armor
                sync_bootloader_configuration "${active_kver}"
                echo ""
                read -r -p "$(_ PRESS_ENTER_CONTINUE)" || true
                ;;
            5)
                return 0
                ;;
            *)
                echo -e "\n${YELLOW}$(_ INVALID_SELECTION)${RESET}"
                sleep 1
                ;;
        esac
    done
}

# --- [ NVIDIA DRIVER MANAGEMENT ROUTINE ] ---
manage_nvidia_interactive() {
    local gpu_gen
    gpu_gen=$(detect_nvidia_gpu)
    log_info "Detected GPU Architecture: ${gpu_gen}"

    local tui_py="${SCRIPT_DIR}/../lib/slacky_tui.py"
    [ ! -f "${tui_py}" ] && [ -f "/usr/share/slacky-update/lib/slacky_tui.py" ] && tui_py="/usr/share/slacky-update/lib/slacky_tui.py"

    while true; do
        local n_choice=""
        if [ -f "${tui_py}" ] && command -v python3 >/dev/null 2>&1 && [ -t 0 ]; then
            n_choice=$(python3 "${tui_py}" --mode nvidia-main || true)
        else
            echo ""
            echo -e "${BLUE}${BOLD}============================================================${RESET}"
            echo -e "${BLUE}${BOLD}$(_ MENU_NVIDIA_CACHY_TITLE)${RESET}"
            echo -e "${BLUE}${BOLD}============================================================${RESET}"
            echo -e "  \033[1;33m1.\033[0m $(_ NVIDIA_CACHYOS_MASTER_SYNC)"
            echo -e "  \033[1;33m2.\033[0m $(_ NVIDIA_OPTION_REBUILD)"
            echo -e "  \033[1;33m3.\033[0m $(_ NVIDIA_OPTION_LEGACY_RUN)"
            echo -e "  \033[1;33m4.\033[0m $(_ NVIDIA_OPTION_RETURN)"
            echo ""
            echo -n "$(_ SELECT_OPERATION_RANGE range="1-4") "
            read -r n_choice || n_choice="4"
        fi

        case "${n_choice}" in
            1)
                validate_privileges
                INTERACTIVE_NVIDIA=1 ensure_cachyos_nvidia_duties || true   # 6A-132: honest non-zero result, already reported
                echo ""
                read -r -p "$(_ PRESS_ENTER_CONTINUE)" || true
                ;;
            2)
                validate_privileges
                build_nvidia_modules "ALL"
                generate_kernel_initramfs "ALL"
                enforce_secure_boot_armor
                sync_bootloader_configuration "$(uname -r)"
                register_flatpak_gl_sync
                echo ""
                read -r -p "$(_ PRESS_ENTER_CONTINUE)" || true
                ;;
            3)
                manage_legacy_nvidia_run_interactive
                ;;
            4|[Qq])
                return 0
                ;;
            *)
                log_warn "Invalid selection."
                ;;
        esac
    done
}

# --- [ UNDERPANTS GNOMES LAUNCHER ] ---
launch_gnomes_station_interactive() {
    interactive_cachyos_gaming_menu
}

# --- [ INTERACTIVE TERMINAL MENU ] ---
interactive_menu() {
    INTERACTIVE_SESSION=1
    probe_gpu_hardware
    while true; do
        set_terminal_title "slacky-update v${CURRENT_VERSION}"
        local has_cachy
        has_cachy=$(has_cachyos_kernels_installed 2>/dev/null || echo "false")

        local tui_py="${APP_DIR:-}/slacky_tui.py"
        [ ! -f "${tui_py}" ] && [ -f "/usr/share/slacky-update/lib/slacky_tui.py" ] && tui_py="/usr/share/slacky-update/lib/slacky_tui.py"

        local choice=""
        local use_tui=false
        if [ -f "${tui_py}" ] && command -v python3 >/dev/null 2>&1 && [ -t 0 ]; then
            use_tui=true
            local gpu_mode="intel"
            if [ "${HAS_NVIDIA:-false}" = "true" ]; then
                gpu_mode="nvidia"
            elif [ "${HAS_AMD:-false}" = "true" ]; then
                gpu_mode="amd"
            fi
            choice=$(python3 "${tui_py}" --mode main --gpu "${gpu_mode}")
        fi

        if [ "${HAS_NVIDIA}" = "true" ]; then
            if [ "${use_tui}" = "false" ]; then
                echo ""
                echo -e "${BLUE}${BOLD}Slacky-Update (v${CURRENT_VERSION} '${RELEASE_CODENAME}')${RESET}"
                echo -e "${BLUE}Slackware Core Update & High-Performance Modernization Engine${RESET}"
                check_slacky_update_self_update "${CURRENT_VERSION}"
                echo ""
                run_preflight_check 0
                display_pending_status
                echo -e "${BOLD}$(_ CLI_ACTIONS_HEADER)${RESET}"

                echo -e "  $(_ MENU_FULL_UPDATE)"
                echo -e "  $(_ MENU_KERNEL)"
                if [ "${has_cachy}" = "true" ]; then
                    echo -e "  $(_ MENU_NVIDIA_CACHY)"
                else
                    echo -e "  $(_ MENU_NVIDIA)"
                fi
                echo -e "  4. $(_ MENU_GAMING | sed -E 's/^[0-9]+\.\s*//')"
                echo -e "  5. $(_ MENU_CLEAN | sed -E 's/^[0-9]+\.\s*//')"
                echo -e "  6. \033[1;36m$(_ MENU_LIMINE | sed -E 's/^[0-9]+\.\s*//')\033[0m"
                echo -e "  7. $(_ MENU_ARMOR | sed -E 's/^[0-9]+\.\s*//')"
                echo -e "  8. \033[1;32m$(_ MENU_FIELD_GUIDE | sed -E 's/^[0-9]+\.\s*//')\033[0m"
                echo -e "  9. $(_ MENU_EXIT | sed -E 's/^[0-9]+\.\s*//')"
                echo ""
                echo -n "$(_ SELECT_OPERATION_RANGE range="1-9")"
                read -r choice || choice="9"
            fi

            case "${choice}" in
                1)
                    echo ""
                    run_full_update
                    ;;
                2)
                    echo ""
                    manage_cachyos_kernel_interactive
                    ;;
                3)
                    echo ""
                    manage_nvidia_interactive
                    ;;
                4)
                    echo ""
                    launch_gnomes_station_interactive
                    ;;
                5)
                    echo ""
                    manage_system_clean_interactive
                    ;;
                6)
                    echo ""
                    if command -v manage_limine_interactive >/dev/null 2>&1; then
                        manage_limine_interactive
                    fi
                    ;;
                7)
                    echo ""
                    manage_secureboot_interactive
                    ;;
                8)
                    echo ""
                    if command -v manage_field_guide_interactive >/dev/null 2>&1; then
                        manage_field_guide_interactive
                    fi
                    ;;
                9)
                    echo -e "\n${GREEN}$(_ SESSION_TERMINATED)${RESET}"
                    exit 0
                    ;;
                *)
                    echo -e "\n${YELLOW}$(_ INVALID_SELECTION)${RESET}"
                    sleep 1
                    ;;
            esac
        elif [ "${HAS_AMD}" = "true" ]; then
            if [ "${use_tui}" = "false" ]; then
                echo -e "  $(_ MENU_FULL_UPDATE)"
                echo -e "  $(_ MENU_KERNEL)"
                echo -e "  3. $(_ MENU_AMD_ROCM | sed -E 's/^[0-9]+\.\s*//')"
                echo -e "  4. $(_ MENU_GAMING | sed -E 's/^[0-9]+\.\s*//')"
                echo -e "  5. $(_ MENU_CLEAN | sed -E 's/^[0-9]+\.\s*//')"
                echo -e "  6. \033[1;36m$(_ MENU_LIMINE | sed -E 's/^[0-9]+\.\s*//')\033[0m"
                echo -e "  7. $(_ MENU_ARMOR | sed -E 's/^[0-9]+\.\s*//')"
                echo -e "  8. \033[1;32m$(_ MENU_FIELD_GUIDE | sed -E 's/^[0-9]+\.\s*//')\033[0m"
                echo -e "  9. $(_ MENU_EXIT | sed -E 's/^[0-9]+\.\s*//')"
                echo ""
                echo -n "$(_ SELECT_OPERATION_RANGE range="1-9")"
                read -r choice || choice="9"
            fi

            case "${choice}" in
                1)
                    echo ""
                    run_full_update
                    ;;
                2)
                    echo ""
                    manage_cachyos_kernel_interactive
                    ;;
                3)
                    echo ""
                    if command -v manage_rocm_interactive >/dev/null 2>&1; then
                        manage_rocm_interactive
                    else
                        log_warn "ROCm module not loaded."
                    fi
                    echo ""
                    read -r -p "$(_ PRESS_ENTER_CONTINUE)" || true
                    ;;
                4)
                    echo ""
                    launch_gnomes_station_interactive
                    ;;
                5)
                    echo ""
                    manage_system_clean_interactive
                    ;;
                6)
                    echo ""
                    if command -v manage_limine_interactive >/dev/null 2>&1; then
                        manage_limine_interactive
                    fi
                    ;;
                7)
                    echo ""
                    manage_secureboot_interactive
                    ;;
                8)
                    echo ""
                    if command -v manage_field_guide_interactive >/dev/null 2>&1; then
                        manage_field_guide_interactive
                    fi
                    ;;
                9)
                    echo -e "\n${GREEN}$(_ SESSION_TERMINATED)${RESET}"
                    exit 0
                    ;;
                *)
                    echo -e "\n${YELLOW}$(_ INVALID_SELECTION)${RESET}"
                    sleep 1
                    ;;
            esac
        else
            # Pure Intel / Headless Menu (No dedicated GPU menu)
            if [ "${use_tui}" = "false" ]; then
                echo -e "  1. $(_ MENU_FULL_UPDATE | sed -E 's/^[0-9]+\.\s*//')"
                echo -e "  2. $(_ MENU_KERNEL | sed -E 's/^[0-9]+\.\s*//')"
                echo -e "  3. $(_ MENU_GAMING | sed -E 's/^[0-9]+\.\s*//')"
                echo -e "  4. $(_ MENU_CLEAN | sed -E 's/^[0-9]+\.\s*//')"
                echo -e "  5. \033[1;36m$(_ MENU_LIMINE | sed -E 's/^[0-9]+\.\s*//')\033[0m"
                echo -e "  6. $(_ MENU_ARMOR | sed -E 's/^[0-9]+\.\s*//')"
                echo -e "  7. \033[1;32m$(_ MENU_FIELD_GUIDE | sed -E 's/^[0-9]+\.\s*//')\033[0m"
                echo -e "  8. $(_ MENU_EXIT | sed -E 's/^[0-9]+\.\s*//')"
                echo ""
                echo -n "$(_ SELECT_OPERATION_RANGE range="1-8")"
                read -r choice || choice="8"
            fi

            case "${choice}" in
                1)
                    echo ""
                    run_full_update
                    ;;
                2)
                    echo ""
                    manage_cachyos_kernel_interactive
                    ;;
                3)
                    echo ""
                    launch_gnomes_station_interactive
                    ;;
                4)
                    echo ""
                    manage_system_clean_interactive
                    ;;
                5)
                    echo ""
                    if command -v manage_limine_interactive >/dev/null 2>&1; then
                        manage_limine_interactive
                    fi
                    ;;
                6)
                    echo ""
                    manage_secureboot_interactive
                    ;;
                7)
                    echo ""
                    if command -v manage_field_guide_interactive >/dev/null 2>&1; then
                        manage_field_guide_interactive
                    fi
                    ;;
                8)
                    echo -e "\n${GREEN}$(_ SESSION_TERMINATED)${RESET}"
                    exit 0
                    ;;
                *)
                    echo -e "\n${YELLOW}$(_ INVALID_SELECTION)${RESET}"
                    sleep 1
                    ;;
            esac
        fi
    done
}

# --- [ ENTRY POINT ] ---
if [ "${1:-}" = "--non-interactive" ] || [ "${1:-}" = "-y" ]; then
    export NON_INTERACTIVE=1
    run_full_update
elif [ "${1:-}" = "--check" ]; then
    run_preflight_check 1
    display_pending_status
    # 6A-202: a family at risk is named in one sentence, at most once per 7 days (silent otherwise)
    if command -v slacky_sentinel_alerts >/dev/null 2>&1; then
        slacky_sentinel_alerts || true
    fi
elif [ "${1:-}" = "--rank-mirrors" ] || [ "${1:-}" = "--mirrors" ] || [ "${1:-}" = "-M" ]; then
    INTERACTIVE_SESSION=1
    rank_slackware_mirrors_interactive
    exit 0
elif [ "${1:-}" = "--limine" ] || [ "${1:-}" = "-l" ]; then
    INTERACTIVE_SESSION=1
    manage_limine_interactive
elif [ "${1:-}" = "--cmdline" ] || [ "${1:-}" = "-c" ]; then
    INTERACTIVE_SESSION=1
    manage_kernel_cmdline_interactive
elif [ "${1:-}" = "--secure-boot" ] || [ "${1:-}" = "--sb" ]; then
    INTERACTIVE_SESSION=1
    manage_secureboot_interactive
elif [ "${1:-}" = "--gnomes-pacman" ] || [ "${1:-}" = "gnomes" ] || [ "${1:-}" = "-P" ]; then
    shift
    if [ -x "${SCRIPT_DIR}/gnomes" ]; then
        exec "${SCRIPT_DIR}/gnomes" "$@"
    elif [ -x "/usr/bin/gnomes" ]; then
        exec /usr/bin/gnomes "$@"
    elif [ -x "/usr/local/bin/gnomes" ]; then
        exec /usr/local/bin/gnomes "$@"
    else
        python3 "${APP_DIR}/gnomes_pacman.py" "$@"
    fi
elif [ "${1:-}" = "--hyprland" ] || [ "${1:-}" = "--hyprland-noctalia" ]; then
    validate_privileges
    ensure_cache_dir
    probe_gpu_hardware
    transmute_and_deploy_gaming_pkg "hyprland-noctalia"
    exit 0
elif [ "${1:-}" = "--hyprland-core" ] || [ "${1:-}" = "--hyprland-minimal" ]; then
    validate_privileges
    ensure_cache_dir
    probe_gpu_hardware
    transmute_and_deploy_gaming_pkg "hyprland-core"
    exit 0
elif [ "${1:-}" = "--hyprmod" ]; then
    validate_privileges
    ensure_cache_dir
    probe_gpu_hardware
    transmute_and_deploy_gaming_pkg "hyprmod"
    exit 0
elif [ "${1:-}" = "--mactahoe-icons" ] || [ "${1:-}" = "--tahoe-icons" ]; then
    validate_privileges
    ensure_cache_dir
    transmute_and_deploy_gaming_pkg "mactahoe-icons"
    exit 0
elif [ "${1:-}" = "--mactahoe-cursors" ] || [ "${1:-}" = "--tahoe-cursors" ]; then
    validate_privileges
    ensure_cache_dir
    transmute_and_deploy_gaming_pkg "mactahoe-cursors"
    exit 0
elif [ "${1:-}" = "--whitesur-icons" ]; then
    validate_privileges
    ensure_cache_dir
    transmute_and_deploy_gaming_pkg "whitesur-icons"
    exit 0
elif [ "${1:-}" = "--whitesur-cursors" ]; then
    validate_privileges
    ensure_cache_dir
    transmute_and_deploy_gaming_pkg "whitesur-cursors"
    exit 0
elif [ "${1:-}" = "--gaming" ] || [ "${1:-}" = "-g" ] || [ "${1:-}" = "--gnomes" ] || [ "${1:-}" = "--gnomes-tui" ]; then
    INTERACTIVE_SESSION=1
    interactive_cachyos_gaming_menu
elif [ "${1:-}" = "--gnomes-data" ] || [ "${1:-}" = "--gaming-json" ]; then
    if command -v export_gaming_catalog_json >/dev/null 2>&1; then
        export_gaming_catalog_json
        exit 0
    elif [ -f "${APP_DIR}/mod_gaming.sh" ]; then
        source "${APP_DIR}/mod_gaming.sh"
        export_gaming_catalog_json
        exit 0
    fi
elif [ "${1:-}" = "--gnomes-deploy" ] || [ "${1:-}" = "--gaming-deploy" ]; then
    shift
    validate_privileges
    acquire_run_lock || exit 1   # 6A-149: never beside a running update or another deploy
    if [ $# -eq 1 ]; then
        transmute_and_deploy_gaming_pkg "$1"
    else
        deploy_gaming_packages_batch "$@"
    fi
    exit $?
elif [ "${1:-}" = "--gnomes-uninstall" ] || [ "${1:-}" = "--gaming-uninstall" ]; then
    shift
    validate_privileges
    acquire_run_lock || exit 1   # 6A-149
    uninstall_cachyos_gaming_pkg "$1"
    exit $?
elif [ "${1:-}" = "--heal-multilib" ] || [ "${1:-}" = "-m" ]; then
    validate_privileges
    heal_multilib_subsystem
    run_post_update_smoke_test
elif [ "${1:-}" = "--heal-check" ]; then
    # 9B: read only; silent when nothing is damaged; exit 51 with damage; never repairs, never asks for sudo
    if heal_helper=$(slacky_find_helper slacky_heal.py); then
        python3 -I "${heal_helper}" check
        exit $?
    fi
    exit 0
elif [ "${1:-}" = "--heal-host" ] || [ "${1:-}" = "--heal-sovereignty" ]; then
    validate_privileges
    heal_host_sovereignty_subsystem
    run_post_update_smoke_test
elif [ "${1:-}" = "--slackbuilds" ] || [ "${1:-}" = "-s" ]; then
    INTERACTIVE_SESSION=1
    manage_slackbuilds_interactive
elif [ "${1:-}" = "--protect-links" ]; then
    case "${2:-status}" in
        on)  validate_privileges; deploy_protect_links ;;
        off) validate_privileges; revert_protect_links ;;
        status)
            if is_protect_links_active; then echo "Link protection: on"; else echo "Link protection: off"; fi ;;
        *) echo "Usage: slacky-update --protect-links on|off|status"; exit 2 ;;
    esac
    exit 0
elif [ "${1:-}" = "--tweaks" ] || [ "${1:-}" = "-t" ]; then
    INTERACTIVE_SESSION=1
    manage_tweaks_interactive
elif [ "${1:-}" = "--guide" ] || [ "${1:-}" = "--field-guide" ] || [ "${1:-}" = "--manual" ] || [ "${1:-}" = "--docs" ] || [ "${1:-}" = "-d" ]; then
    INTERACTIVE_SESSION=1
    if command -v manage_field_guide_interactive >/dev/null 2>&1; then
        manage_field_guide_interactive
    elif [ -f "${APP_DIR}/mod_docs.sh" ]; then
        source "${APP_DIR}/mod_docs.sh"
        manage_field_guide_interactive
    fi
elif [ "${1:-}" = "--sync-boot" ] || [ "${1:-}" = "--boot" ] || [ "${1:-}" = "-b" ] || [ "${1:-}" = "--limine-config" ]; then
    validate_privileges
    if command -v generate_kernel_initramfs >/dev/null 2>&1; then
        log_info "Synchronizing initramfs images for all installed kernels..."
        generate_kernel_initramfs "ALL"
    fi
    if command -v sync_bootloader_configuration >/dev/null 2>&1; then
        sync_bootloader_configuration "$(uname -r)"
    fi
elif [ "${1:-}" = "--sync-snapper" ] || [ "${1:-}" = "--snapper-sync" ]; then
    validate_privileges
    if command -v generate_limine_configuration >/dev/null 2>&1; then
        generate_limine_configuration
    fi
    if command -v enroll_and_sign_limine >/dev/null 2>&1; then
        enroll_and_sign_limine
    fi
elif [ "${1:-}" = "--sync-nvidia" ] || [ "${1:-}" = "--nvidia" ]; then
    validate_privileges
    INTERACTIVE_NVIDIA=1
    ensure_cachyos_nvidia_duties
elif [ "${1:-}" = "--hash-check" ] || [ "${1:-}" = "--check-hashes" ] || [ "${1:-}" = "-H" ]; then
    validate_privileges
    if command -v check_kernel_boot_hashes >/dev/null 2>&1; then
        check_kernel_boot_hashes
        exit $?
    elif [ -f "${APP_DIR}/mod_limine.sh" ]; then
        source "${APP_DIR}/mod_limine.sh"
        check_kernel_boot_hashes
        exit $?
    else
        echo -e "${RED}Error:${RESET} Limine hash verification module not found."
        exit 1
    fi
elif [ "${1:-}" = "--clean" ] || [ "${1:-}" = "--purge-kernels" ]; then
    validate_privileges
    begin_atomic_transaction "system cleanup" || exit 1   # 6A-149: never prune beside a running update
    clean_system_full_sweep
    end_atomic_transaction
elif [ "${1:-}" = "--restore-limine" ]; then
    validate_privileges
    restore_limine_self_heal
elif [ "${1:-}" = "--hardware" ]; then
    # 6A-117: what SpiderSense knows about this machine (read-only)
    PYTHONSAFEPATH=1 python3 -I "${APP_DIR}/spidersense_hw.py" show
    exit $?
elif [ "${1:-}" = "--doctor" ] || [ "${1:-}" = "--health" ] || [ "${1:-}" = "--diag" ]; then
    shift
    validate_privileges
    if [ -f "${SCRIPT_DIR}/../lib/slacky_doctor.py" ]; then
        sudo python3 "${SCRIPT_DIR}/../lib/slacky_doctor.py" "$@"
    elif [ -f "${APP_DIR}/slacky_doctor.py" ]; then
        sudo python3 "${APP_DIR}/slacky_doctor.py" "$@"
    else
        sudo python3 "/usr/share/slacky-update/lib/slacky_doctor.py" "$@"
    fi
    exit $?
elif [ "${1:-}" = "--list-langs" ]; then
    python3 "${I18N_PY}" --list-langs
    exit 0
elif [ "${1:-}" = "--lang" ]; then
    if [ -z "${2:-}" ]; then
        echo -e "${RED}Error:${RESET} Missing language code. Usage: slacky-update --lang <code|nb|en>"
        echo "Run 'slacky-update --list-langs' to see all available language codes."
        exit 1
    fi
    python3 "${I18N_PY}" --set-lang "$2"
    exit 0
elif [[ "${1:-}" =~ ^--lang=(.+)$ ]]; then
    target_code="${BASH_REMATCH[1]}"
    python3 "${I18N_PY}" --set-lang "${target_code}"
    exit 0
elif [ "${1:-}" = "--version" ] || [ "${1:-}" = "-v" ]; then
    echo "slacky-update v${CURRENT_VERSION} '${RELEASE_CODENAME}' (Slackware Linux)"
    exit 0
elif [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
    echo -e "${BLUE}${BOLD}Slacky-Update v${CURRENT_VERSION} '${RELEASE_CODENAME}'${RESET}"
    echo -e "${YELLOW}Notice: This program changes system files, kernels and the boot menu. Make sure you have a backup.${RESET}"
    echo "Usage: slacky-update [OPTIONS]"
    echo ""
    echo "Options:"
    echo "  -y, --non-interactive   Run full unattended system upgrade (Slackware, Flatpaks, Kernels, Drivers, SBo)"
    echo "      --check             Run non-modifying read-only status check"
    echo "      --doctor, --health  Run instant system health audit & hardware diagnostics (non-destructive)"
    echo "      --hardware          Show what SpiderSense knows about this machine (graphics, processor, boot setup)"
    echo "      (also: the separate 'spidersense' command shows status, package check, hardware, snapshots and the flight recorder)"
    echo "  -H, --hash-check        Dynamically verify on-disk kernel & initramfs BLAKE2B hashes against Limine"
    echo "  -l, --limine            Open Limine Bootloader & Secure Boot Matrix"
    echo "  -c, --cmdline           Configure Kernel Boot Parameters (CMDLINE & Gaming Hub)"
    echo "  -b, --sync-boot         Synchronize initramfs, Limine/GRUB bootloader, BLAKE2B hashes & Secure Boot"
    echo "      --sync-snapper      Synchronize Btrfs Snapper snapshots into Limine menu and reseal"
    echo "      --sync-nvidia       Synchronize NVIDIA driver suite and compile/match kernel modules"
    echo "      --clean             Clean package caches, remove obsolete kernels and orphaned packages"
    echo "      --restore-limine    Restore Limine bootloader from known good self-heal backup"
    echo "      --sb, --secure-boot Open UEFI Secure Boot & MOK Armor Command Center"
    echo "  -g, --gaming            Open CachyOS Underpants Gnomes Gaming Suite menu"
    echo "      --hyprland          Install curated Hyprland Desktop Suite (Noctalia Shell)"
    echo "      --hyprland-core     Install Hyprland Minimal Core Compositor"
    echo "  -m, --heal-multilib     Audit and repair AlienBOB 32-bit Multilib subsystem"
    echo "      --heal-check        Look for damaged installed packages (read only; prints the slackpkg command to restore them)"
    echo "      --heal-host         Audit /usr/bin/ and restore Host Sovereignty for native packages"
    echo "  -s, --slackbuilds       Open SlackBuilds and sbotools management hub"
    echo "  -t, --tweaks            Open system performance and gaming tweaks menu"
    echo "  -d, --guide, --manual   Open Master Field Guide & Diagnostics menu (Doctor/PDF/QR/Email)"
    echo "      --lang <code|nb|en> Set system language preference"
    echo "      --list-langs        List all available languages"
    echo "  -v, --version           Display version and release codename"
    echo "  -h, --help              Display this help menu"
    echo ""
    echo "Exit codes: 0 done, 1 error, 20 finished but some updates are still waiting (they are tried again next time),"
    echo "            30 startup menu not updated safely (do not restart), 31 no consent, 32 another update is running, 130 stopped by you"
    exit 0
else
    interactive_menu
fi
