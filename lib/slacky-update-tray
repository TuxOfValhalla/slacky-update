KOFI_SETTINGS_FILE = os.path.expanduser("~/.config/slacky-update/kofi.json")

def record_kofi_update_event():
    try:
        os.makedirs(os.path.dirname(KOFI_SETTINGS_FILE), exist_ok=True)
        d = {}
        if os.path.exists(KOFI_SETTINGS_FILE):
            try:
                with open(KOFI_SETTINGS_FILE, "r", encoding="utf-8") as f:
                    d = json.load(f)
            except Exception:
                pass
        d["last_update_ts"] = time.time()
        with open(KOFI_SETTINGS_FILE, "w", encoding="utf-8") as f:
            json.dump(d, f)
    except Exception:
        pass

def should_display_kofi():
    try:
        os.makedirs(os.path.dirname(KOFI_SETTINGS_FILE), exist_ok=True)
        base_ts = None
        if os.path.exists(KOFI_SETTINGS_FILE):
            try:
                with open(KOFI_SETTINGS_FILE, "r", encoding="utf-8") as f:
                    d = json.load(f)
                    if "last_update_ts" in d and float(d.get("last_update_ts", 0)) > 0:
                        base_ts = float(d["last_update_ts"])
                    elif "first_install_ts" in d and float(d.get("first_install_ts", 0)) > 0:
                        base_ts = float(d["first_install_ts"])
            except Exception:
                pass
        if not base_ts:
            base_ts = time.time()
            with open(KOFI_SETTINGS_FILE, "w", encoding="utf-8") as f:
                json.dump({"first_install_ts": base_ts, "last_update_ts": base_ts}, f)
        elapsed = max(0, time.time() - base_ts)
        cycle_position = elapsed % (30 * 86400) # seconds into 30-day window
        return cycle_position < 86400 # True for first 24 hours of every 30-day cycle
    except Exception:
        return False

# --- [ TIME PARSING UTILITIES ] ---
def get_time_since_last_check(data):
    if not data or "last_check_ts" not in data:
        candidates = ["/var/cache/slacky-update/status.json", os.path.expanduser("~/.cache/slacky-update/status.json")]
        best_mtime = -1
        for p in candidates:
            if os.path.exists(p):
                try:
                    m = os.path.getmtime(p)
                    if m > best_mtime:
                        best_mtime = m
                except Exception:
                    pass
        if best_mtime > 0:
            diff = max(0, time.time() - best_mtime)
        else:
            return _("NEVER")
    else:
        try:
            diff = max(0, time.time() - float(data["last_check_ts"]))
        except Exception:
            return _("UNKNOWN")

    if diff < 60:
        return _("JUST_NOW")
    mins = int(diff // 60)
    hours = mins // 60
    days = hours // 24

    if days > 0:
        return _("AGO_DAYS_HOURS", days=days, hours=hours % 24)
    elif hours > 0:
        return _("AGO_HOURS_MINS", hours=hours, mins=mins % 60)
    else:
        return _("AGO_MINS", mins=mins)

def get_next_check_in(timer):
    if timer is None or not hasattr(timer, "remainingTime"):
        return _("UNKNOWN")
    try:
        rem_ms = timer.remainingTime()
        if rem_ms < 0:
            return _("UNKNOWN")
        rem_s = int(rem_ms // 1000)
        hours = rem_s // 3600
        mins = (rem_s % 3600) // 60
        if hours > 0:
            return f"{hours}h {mins}m"
        elif mins > 0:
            return f"{mins}m"
        else:
            return f"{rem_s}s"
    except Exception:
        return _("UNKNOWN")

# --- [ TRAY CONTROLLER CLASS ] ---
class SlackyUpdateTray(QSystemTrayIcon):
    def __init__(self, app):
        super().__init__()
        self.app = app
        self.last_notified_count = 0
        self.is_checking = False
        self.checker_proc = None

        self.icon_ok = QIcon(ICON_OK)
        self.icon_pending_full = QIcon(ICON_PENDING)
        self.icon_checking = QIcon(ICON_CHECKING)
        self.icon_pending_80 = self.create_scaled_icon(ICON_PENDING, 0.80)

        self.pulse_timer = QTimer()
        self.pulse_timer.timeout.connect(self.toggle_pulse_frame)
        self.pulse_state = False

        self.pulse_stop_timer = QTimer()
        self.pulse_stop_timer.setSingleShot(True)
        self.pulse_stop_timer.timeout.connect(self.stop_pulse)

        self.poll_timer = QTimer()
        self.poll_timer.timeout.connect(self.update_status)
        self.poll_timer.start(15000)

        self.check_timer = QTimer()
        self.check_timer.timeout.connect(self.trigger_check)
        self.check_timer.start(INTERVAL_1_HOUR_MS)

        # --- [ PERSISTENT ROOT MENU SETUP ] ---
        self.menu = QMenu()

        self.pending_menu = self.menu.addMenu("")

        self.last_action = QAction("", self.menu)
        self.last_action.setEnabled(False)
        self.menu.addAction(self.last_action)

        self.next_action = QAction("", self.menu)
        self.next_action.setEnabled(False)
        self.menu.addAction(self.next_action)

        self.menu.addSeparator()

        self.check_action = QAction("", self.menu)
        self.check_action.triggered.connect(self.trigger_check)
        self.menu.addAction(self.check_action)

        self.upgrade_action = QAction("", self.menu)
        self.upgrade_action.triggered.connect(self.launch_upgrade)
        self.menu.addAction(self.upgrade_action)

        self.gaming_action = QAction("", self.menu)
        self.gaming_action.triggered.connect(self.launch_gaming)
        self.menu.addAction(self.gaming_action)

        self.slackbuilds_action = QAction("", self.menu)
        self.slackbuilds_action.triggered.connect(self.launch_slackbuilds)
        self.menu.addAction(self.slackbuilds_action)

        self.menu.addSeparator()

        self.lang_menu = self.menu.addMenu("")
        self.rebuild_lang_menu()

        self.kofi_sep = self.menu.addSeparator()
        self.kofi_action = QAction("", self.menu)
        if os.path.exists(ICON_KOFI):
            self.kofi_action.setIcon(QIcon(ICON_KOFI))
        self.kofi_action.triggered.connect(lambda: QDesktopServices.openUrl(QUrl("https://ko-fi.com/tuxofvalhalla")))
        self.menu.addAction(self.kofi_action)

        self.menu.addSeparator()

        self.quit_action = QAction("", self.menu)
        self.quit_action.triggered.connect(self.app.quit)
        self.menu.addAction(self.quit_action)

        self.setContextMenu(self.menu)
        self.menu.aboutToShow.connect(self.update_menu_content)
        self.activated.connect(self.on_activated)

        cache_dirs = ["/var/cache/slacky-update", os.path.expanduser("~/.cache/slacky-update")]
        self.watcher = QFileSystemWatcher()
        for cd in cache_dirs:
            try:
                os.makedirs(cd, exist_ok=True)
            except Exception:
                pass
            if os.path.exists(cd):
                self.watcher.addPath(cd)
                status_p = os.path.join(cd, "status.json")
                if os.path.exists(status_p):
                    self.watcher.addPath(status_p)

        self.watcher.directoryChanged.connect(self.update_status)
        self.watcher.fileChanged.connect(self.update_status)

        QTimer.singleShot(15000, self.trigger_check)

        self.update_status()

    def create_scaled_icon(self, icon_path, scale_factor=0.80):
        if not os.path.exists(icon_path):
            return QIcon(icon_path)
        base_pix = QPixmap(icon_path)
        w, h = base_pix.width(), base_pix.height()
        if w <= 0 or h <= 0:
            return QIcon(icon_path)
        scaled_w, scaled_h = max(1, int(w * scale_factor)), max(1, int(h * scale_factor))
        offset_x, offset_y = (w - scaled_w) // 2, (h - scaled_h) // 2
        scaled_sub = base_pix.scaled(scaled_w, scaled_h, Qt.KeepAspectRatio, Qt.SmoothTransformation)
        canvas = QPixmap(w, h)
        canvas.fill(Qt.transparent)
        painter = QPainter(canvas)
        painter.drawPixmap(offset_x, offset_y, scaled_sub)
        painter.end()
        return QIcon(canvas)

    def start_pulse(self, duration_ms=6000):
        self.pulse_state = False
        self.pulse_timer.start(350)
        self.pulse_stop_timer.start(duration_ms)

    def toggle_pulse_frame(self):
        self.pulse_state = not self.pulse_state
        if self.pulse_state:
            self.setIcon(self.icon_pending_80)
        else:
            self.setIcon(self.icon_pending_full)

    def stop_pulse(self):
        if self.pulse_timer.isActive():
            self.pulse_timer.stop()
        if self.is_checking:
            return
        data = self.load_status()
        total_updates = 0
        if data:
            total_updates = len(data.get("slackware_updates", [])) + len(data.get("slackpkgplus_updates", [])) + len(data.get("flatpak_updates", [])) + len(data.get("sbo_updates", [])) + len(data.get("cachyos_kernel_updates", [])) + len(data.get("cachyos_gaming_updates", [])) + len(data.get("nvidia_driver_updates", []))
        if total_updates > 0 or (data and data.get("nvidia_gl_mismatch", False)):
            self.setIcon(self.icon_pending_full)
        else:
            self.setIcon(self.icon_ok)

    def on_activated(self, reason):
        if reason == QSystemTrayIcon.Trigger:
            self.launch_upgrade()
        elif reason in (QSystemTrayIcon.Context, QSystemTrayIcon.MiddleClick):
            self.update_menu_content()
            self.menu.popup(QCursor.pos())

    def set_language(self, lang_code):
        i18n.save_language_override(lang_code)
        self.rebuild_lang_menu()
        self.update_status()

    def rebuild_lang_menu(self):
        self.lang_menu.clear()
        self.lang_menu.setTitle(_("LANGUAGE_SELECTION"))
        group = QActionGroup(self.lang_menu)
        group.setExclusive(True)

        sys_action = QAction(_("SYSTEM_DEFAULT_LANG"), self.lang_menu)
        sys_action.setCheckable(True)
        if not i18n.manual_override:
            sys_action.setChecked(True)
        sys_action.triggered.connect(lambda: self.set_language("system"))
        group.addAction(sys_action)
        self.lang_menu.addAction(sys_action)
        self.lang_menu.addSeparator()

        avail_langs = i18n.get_available_languages()
        for code, name in avail_langs.items():
            l_action = QAction(name, self.lang_menu)
            l_action.setCheckable(True)
            if i18n.manual_override == code:
                l_action.setChecked(True)
            l_action.triggered.connect(lambda checked, c=code: self.set_language(c))
            group.addAction(l_action)
            self.lang_menu.addAction(l_action)

    def load_status(self):
        candidates = [
            STATUS_FILE,
            "/var/cache/slacky-update/status.json"
        ]
        best_data = None
        best_ts = -1
        for path in candidates:
            if not os.path.exists(path):
                continue
            try:
                with open(path, "r", encoding="utf-8") as f:
                    data = json.load(f)
                    ts = float(data.get("last_check_ts", os.path.getmtime(path)))
                    if ts > best_ts:
                        best_ts = ts
                        best_data = data
            except (json.JSONDecodeError, OSError):
                continue
        return best_data

    def update_status(self):
        data = self.load_status()

        slack_list = data.get("slackware_updates", []) if data else []
        slackpkgplus_list = data.get("slackpkgplus_updates", []) if data else []
        flatpak_list = data.get("flatpak_updates", []) if data else []
        sbo_list = data.get("sbo_updates", []) if data else []
        cachy_list = data.get("cachyos_kernel_updates", []) if data else []
        gaming_list = data.get("cachyos_gaming_updates", []) if data else []
        nvidia_list = data.get("nvidia_driver_updates", []) if data else []
        nvidia_mismatch = data.get("nvidia_gl_mismatch", False) if data else False

        total_updates = len(slack_list) + len(slackpkgplus_list) + len(flatpak_list) + len(sbo_list) + len(cachy_list) + len(gaming_list) + len(nvidia_list)

        if not self.is_checking and not self.pulse_timer.isActive():
            if nvidia_mismatch or total_updates > 0:
                self.setIcon(self.icon_pending_full)
            else:
                self.setIcon(self.icon_ok)

        if not self.is_checking:
            if nvidia_mismatch:
                self.setToolTip(_("NVIDIA_SYNC_FAIL"))
            elif total_updates > 0:
                tooltip = _("UPDATES_AVAILABLE", count=total_updates)
                details = []
                if slack_list:
                    details.append(f"{_('CAT_SLACKWARE')}: {len(slack_list)}")
                if slackpkgplus_list:
                    details.append(f"{_('CAT_SLACKPKGPLUS')}: {len(slackpkgplus_list)}")
                if flatpak_list:
                    details.append(f"{_('CAT_FLATPAK')}: {len(flatpak_list)}")
                if sbo_list:
                    details.append(f"{_('CAT_SBO')}: {len(sbo_list)}")
                if cachy_list:
                    details.append(f"{_('CAT_KERNEL')}: {len(cachy_list)}")
                if gaming_list:
                    details.append(f"{_('CAT_GAMING')}: {len(gaming_list)}")
                if nvidia_list:
                    details.append(f"{_('CAT_NVIDIA')}: {len(nvidia_list)}")
                if details:
                    tooltip += "\n• " + "\n• ".join(details)
                self.setToolTip(tooltip)
            else:
                self.setToolTip(_("SYSTEM_UP_TO_DATE"))

        if not self.isVisible() and QSystemTrayIcon.isSystemTrayAvailable():
            self.show()

        if total_updates > 0 and total_updates != self.last_notified_count:
            self.showMessage(_("SLACKY_UPDATE_TITLE"), _("UPDATES_AVAILABLE_COUNT", count=total_updates), self.icon_pending_full, 6000)
            self.last_notified_count = total_updates
            self.start_pulse(6000)
        elif total_updates == 0:
            self.last_notified_count = 0
            self.stop_pulse()

        self.update_menu_content()

    def update_menu_content(self):
        data = self.load_status()

        slack_list = data.get("slackware_updates", []) if data else []
        slackpkgplus_list = data.get("slackpkgplus_updates", []) if data else []
        flatpak_list = data.get("flatpak_updates", []) if data else []
        sbo_list = data.get("sbo_updates", []) if data else []
        cachy_list = data.get("cachyos_kernel_updates", []) if data else []
        gaming_list = data.get("cachyos_gaming_updates", []) if data else []
        nvidia_list = data.get("nvidia_driver_updates", []) if data else []
        total_updates = len(slack_list) + len(slackpkgplus_list) + len(flatpak_list) + len(sbo_list) + len(cachy_list) + len(gaming_list) + len(nvidia_list)

        self.pending_menu.setTitle(_("UPDATES_AVAILABLE", count=total_updates))
        self.pending_menu.clear()

        if total_updates > 0:
            pipeline = [
                (_("CAT_SLACKWARE"), slack_list),
                (_("CAT_SLACKPKGPLUS"), slackpkgplus_list),
                (_("CAT_FLATPAK"), flatpak_list),
                (_("CAT_SBO"), sbo_list),
                (_("CAT_KERNEL"), cachy_list),
                (_("CAT_GAMING"), gaming_list),
                (_("CAT_NVIDIA"), nvidia_list)
            ]
            for title, pkgs in pipeline:
                if pkgs:
                    self.pending_menu.addSection(f"{title} ({len(pkgs)})")
                    if len(pkgs) <= 25:
                        for pkg in pkgs:
                            action = QAction(f"  {pkg}", self.pending_menu)
                            action.setEnabled(False)
                            self.pending_menu.addAction(action)
                    else:
                        for pkg in pkgs[:20]:
                            action = QAction(f"  {pkg}", self.pending_menu)
                            action.setEnabled(False)
                            self.pending_menu.addAction(action)
                        rem_count = len(pkgs) - 20
                        more_act = QAction(f"  ... and {rem_count} more", self.pending_menu)
                        more_act.setEnabled(False)
                        self.pending_menu.addAction(more_act)
        else:
            no_up = QAction(_("ALL_PACKAGES_UP_TO_DATE"), self.pending_menu)
            no_up.setEnabled(False)
            self.pending_menu.addAction(no_up)

        time_since = get_time_since_last_check(data)
        next_in = get_next_check_in(self.check_timer)

        self.last_action.setText(_("TIME_SINCE_LAST_CHECK", time=time_since))
        self.next_action.setText(_("NEXT_CHECK_IN", time=next_in))

        self.check_action.setText(_("CHECK_FOR_UPDATES"))
        self.upgrade_action.setText(_("UPDATE_NOW"))
        self.gaming_action.setText(_("MENU_GAMING_TRAY"))
        self.slackbuilds_action.setText(_("MENU_SLACKBUILDS_TRAY"))
        self.lang_menu.setTitle(_("LANGUAGE_SELECTION"))

        show_kofi = should_display_kofi()
        self.kofi_sep.setVisible(show_kofi)
        self.kofi_action.setVisible(show_kofi)
        self.kofi_action.setText(_("SUPPORT_KOFI"))

        self.quit_action.setText(_("QUIT"))

    def trigger_check(self):
        if self.is_checking:
            return
        self.is_checking = True
        self.stop_pulse()
        self.setIcon(self.icon_checking)
        self.setToolTip(_("CHECKING_FOR_UPDATES"))
        self.app.processEvents()
        self.check_timer.start(INTERVAL_1_HOUR_MS)

        if hasattr(self, "checker_proc") and self.checker_proc is not None:
            if self.checker_proc.state() != QProcess.NotRunning:
                return

        if os.path.exists(CHECKER_BIN):
            self.checker_proc = QProcess(self)
            self.checker_proc.finished.connect(self.on_check_finished)
            self.checker_proc.start(CHECKER_BIN)
        else:
            self.is_checking = False
            self.update_status()

    def on_check_finished(self, exit_code=0, exit_status=0):
        self.is_checking = False
        self.update_status()

    def launch_upgrade(self):
        self.launch_in_terminal(["/usr/local/bin/slacky-update"], "slacky-update v0.10")

    def launch_gaming(self):
        self.launch_in_terminal(["/usr/local/bin/slacky-update", "--gaming"], "slacky-update v0.10")

    def launch_slackbuilds(self):
        self.launch_in_terminal(["/usr/local/bin/slacky-update", "--slackbuilds"], "slacky-update v0.10")

    def launch_in_terminal(self, cmd, title):
        term = os.environ.get("TERMINAL")
        if term and shutil.which(term):
            try:
                subprocess.Popen([term, "-e"] + cmd)
                return
            except Exception:
                pass

        if shutil.which("konsole"):
            try:
                subprocess.Popen(["konsole", "-p", f"tabtitle={title}", "-e"] + cmd)
                return
            except Exception:
                try:
                    subprocess.Popen(["konsole", "-e"] + cmd)
                    return
                except Exception:
                    pass

        if shutil.which("xfce4-terminal"):
            try:
                subprocess.Popen(["xfce4-terminal", f"--title={title}", "-e", " ".join(cmd)])
                return
            except Exception:
                pass

        for fallback in ["gnome-terminal", "xterm"]:
            if shutil.which(fallback):
                try:
                    subprocess.Popen([fallback, "-T", title, "-e"] + cmd)
                    return
                except Exception:
                    continue

# --- [ MAIN ENTRY POINT ] ---
if __name__ == "__main__":
    app = QApplication(sys.argv)
    app.setApplicationName("slacky-update")
    app.setDesktopFileName("slacky-update-tray")
    app.setQuitOnLastWindowClosed(False)

    tray = SlackyUpdateTray(app)
    tray.show()
    sys.exit(app.exec_())
